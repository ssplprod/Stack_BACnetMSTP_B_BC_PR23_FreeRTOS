/**
* DESCRIPTION
* Union includes all datatype structures required for various properties.
*
* NOTE: Add structures to union as required.
*
*/
typedef union 
{
    /* Priority Array */
	Pr_BACnetPriorityArray_t		stPriorityArray;
    /* Bit String type properties */
    Pr_BACnetBITStr_t				stBitString;
    /* Data and Time property */
	Pr_BACnetDateTime_t				stDateTime;
    /* Event Time stamp property */
	Pr_BACnetEventTimeStamp_t		stEventTimeStamps;  //KV
    /* Logging object property */
    BACnetObjId_t					stObjectId;
	/* Character string type properties */
	BACnetCharStr_t 				stCharString;

    #ifdef BACDEL_OBJ_DEV
    /* Local date */
    Pr_BACnetDate_t					stDate;
    /* Local time */
    Pr_BACnetTime_t					stTime;
    /* COV Subscribe property */
    ListOfBACnetCovSubs_t			stCOVSubscribe;
    /* Protocol Services Supported property */
    Pr_BACnetServicesSupported_t	stSerSupported;
    /* Protocol Object Type Supported property */
    Pr_BACnetObjectTypesSupported_t	stObjectSupported;
	#endif

    #ifdef BACDEL_OBJ_NC
    /* NC object priority property */
    Pr_BACnetNotifyPriority_t      stPriority;
    #endif

    #ifdef BACDEL_OBJ_SDL
    /* date range */
	Pr_BACnetDateRange_t			stEffectivePeriod;
    /* weekly schedule */
    Pr_ListOfBACnetDailySchedule_t  stWeeklySchedule;
    /* any data type for schedule default */
    AnyValue_t						stAnyValue;
    #endif
}AllDataType_u;


/***
*
*DESCRIPTION
*	Function to remap the object_id.
*
*@param eObjType [in] Type of object.
*@return - remapped object type.
*
**/
BACNET_REMAPPED_OBJECT_TYPE Remap_Objct_Id
                        (BACNET_OBJECT_TYPE eObjType)
{
    /* local variables */
    BACNET_REMAPPED_OBJECT_TYPE eRemapObjType = REMAPPED_MAX_BACNET_OBJECT_TYPE;

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Remap_Objct_Id : Entry \r\n"); 
	#endif

    /* switch as per object type */
    switch(eObjType)
    {
        case OBJECT_DEVICE:
        {
            eRemapObjType = REMAPPED_OBJECT_DEVICE;
        }
        break;

        case OBJECT_ANALOG_INPUT:
        {
            eRemapObjType = REMAPPED_OBJECT_ANALOG_INPUT;
        }
        break;

        case OBJECT_ANALOG_OUTPUT:
        {
            eRemapObjType = REMAPPED_OBJECT_ANALOG_OUTPUT;
        }
        break;

        case OBJECT_ANALOG_VALUE:
        {
            eRemapObjType = REMAPPED_OBJECT_ANALOG_VALUE;
        }
        break;

        case OBJECT_BINARY_INPUT:
        {
            eRemapObjType = REMAPPED_OBJECT_BINARY_INPUT;
        }
        break;

        case OBJECT_BINARY_OUTPUT:
        {
            eRemapObjType = REMAPPED_OBJECT_BINARY_OUTPUT;
        }
        break;

        case OBJECT_BINARY_VALUE:
        {
            eRemapObjType = REMAPPED_OBJECT_BINARY_VALUE;
        }
        break;

        case OBJECT_MULTI_STATE_INPUT:
        {
            eRemapObjType = REMAPPED_OBJECT_MULTI_STATE_INPUT;
        }
        break;

        case OBJECT_MULTI_STATE_OUTPUT:
        {
            eRemapObjType = REMAPPED_OBJECT_MULTI_STATE_OUTPUT;
        }
        break;

        case OBJECT_MULTI_STATE_VALUE:
        {
            eRemapObjType = REMAPPED_OBJECT_MULTI_STATE_VALUE;
        }
        break;

		case OBJECT_NOTIFICATION_CLASS:
        {
            eRemapObjType = REMAPPED_OBJECT_NOTIFICATION_CLASS;
        }
        break;

		case OBJECT_EVENT_ENROLLMENT:
        {
            eRemapObjType = REMAPPED_OBJECT_EVENT_ENROLLMENT;
        }
        break;

        case OBJECT_CALENDAR:
        {
            eRemapObjType = REMAPPED_OBJECT_CALENDAR;
        }
        break;

        case OBJECT_SCHEDULE:
        {
            eRemapObjType = REMAPPED_OBJECT_SCHEDULE;
        }
        break;

		case OBJECT_NETWORK_PORT:
		{
			eRemapObjType = REMAPPED_OBJECT_NETWORK_PORT;
		}
		break;
        #ifndef BACDEL_PR23
		case OBJECT_NETWORK_SECURITY:
		{
			eRemapObjType = REMAPPED_OBJECT_NETWORK_SECURITY;
		}
		break;
		#endif
        default:
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1, "BACnetStackAppLayer:Remap_Objct_Id"
                "Object Type Not Supported\r\n");
			#endif
        }
        break;
    }

    /* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: Remap_Objct_Id: exit \r\n"); 
	#endif
    /* return the value */
    return eRemapObjType;
}

/** function get get object type from its remapped type. */
BACNET_OBJECT_TYPE Map_Objct_Type
                        (BACNET_REMAPPED_OBJECT_TYPE eRemapObjType)
{
    /* local variables */
    BACNET_OBJECT_TYPE eObjType = MAX_BACNET_OBJECT_TYPE;

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Remap_Objct_Id : Entry \r\n"); 
	#endif

    /* switch as per remapped object type */
    switch(eRemapObjType)
    {
        case REMAPPED_OBJECT_DEVICE:
        {
            eObjType = OBJECT_DEVICE;
        }
        break;

        case REMAPPED_OBJECT_ANALOG_INPUT:
        {
            eObjType = OBJECT_ANALOG_INPUT;
        }
        break;

        case REMAPPED_OBJECT_ANALOG_OUTPUT:
        {
            eObjType = OBJECT_ANALOG_OUTPUT;
        }
        break;

        case REMAPPED_OBJECT_ANALOG_VALUE:
        {
            eObjType = OBJECT_ANALOG_VALUE;
        }
        break;

        case REMAPPED_OBJECT_BINARY_INPUT:
        {
            eObjType = OBJECT_BINARY_INPUT;
        }
        break;

        case REMAPPED_OBJECT_BINARY_OUTPUT:
        {
            eObjType = OBJECT_BINARY_OUTPUT;
        }
        break;

        case REMAPPED_OBJECT_BINARY_VALUE:
        {
            eObjType = OBJECT_BINARY_VALUE;
        }
        break;

        case REMAPPED_OBJECT_MULTI_STATE_INPUT:
        {
            eObjType = OBJECT_MULTI_STATE_INPUT;
        }
        break;

        case REMAPPED_OBJECT_MULTI_STATE_OUTPUT:
        {
            eObjType = OBJECT_MULTI_STATE_OUTPUT;
        }
        break;

        case REMAPPED_OBJECT_MULTI_STATE_VALUE:
        {
            eObjType = OBJECT_MULTI_STATE_VALUE;
        }
        break;

		case REMAPPED_OBJECT_NOTIFICATION_CLASS:
        {
            eObjType = OBJECT_NOTIFICATION_CLASS;
        }
        break;

		case REMAPPED_OBJECT_EVENT_ENROLLMENT:
        {
            eObjType = OBJECT_EVENT_ENROLLMENT;
        }
        break;

        case REMAPPED_OBJECT_CALENDAR:
        {
            eObjType = OBJECT_CALENDAR;
        }
        break;

        case REMAPPED_OBJECT_SCHEDULE:
        {
            eObjType = OBJECT_SCHEDULE;
        }
        break;

        #ifndef BACDEL_PR23
		case REMAPPED_OBJECT_NETWORK_SECURITY:
		{
			eObjType = OBJECT_NETWORK_SECURITY;
		}
		break;
		#endif
        default:
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1, "BACnetStackAppLayer:Map_Objct_Type"
                "Object Type Not Supported\r\n");
			#endif
        }
        break;
    }

    /* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Map_Objct_Type :"
        "Exit with MAX_BACNET_OBJECT_TYPE\r\n"); 
	#endif
    /* return the value */
    return eObjType;
}
/**
*
*DESCRIPTION
*   This API returns the property access Type Assigned by User while Adding Property.
*   - this function can also be used to change the access type.
*   - it also returns the offset address of 1st member (i.e m_eAccessType)
*       of property structure.
*
*@param eObjectType         [in]    Type of Object of which property needs to be Initialize.
*@param eDevProp            [in]    Property of object which is to be initialize.
*@param pvObjectPrt         [in]    Pointer to Object/device containing base address
*@param eAccessType         [in]    input access type to be written.
*@param bReadOrWrite        [in]    write if true else read.
*@param pul32PropOffstAddr  [out]   return offset
*
*@return NOT_SUPPORTED/READ_ONLY/READ_WRITE/BACNET_DEFAULT/COMMANDABLE_PROP
*/
PROP_ACCESS_TYPE GetAsignPropAccess(BACNET_OBJECT_TYPE eObjectType,
                                BACNET_PROPERTY_ID eDevProp,
                                void *pvObjectPrt, PROP_ACCESS_TYPE eAccessType,
                                bool bReadOrWrite,
                                ulong32_t *pul32PropOffstAddr)
{
    /* locals */
    ulong32_t ul32OffsetAddr = 0 ;  /* For Data offset Addr */
    /** Function Return value */
    PROP_ACCESS_TYPE ePropType = NOT_SUPPORTED;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetAsignPropAccess : Entry \r\n");
	#endif

    if(NULL == pvObjectPrt)
        return ePropType;
    if(eObjectType == OBJECT_DEVICE)
    {
        switch(eDevProp)
        {
            case PROP_OBJECT_IDENTIFIER:
            {
                 GET_DEVPROP_OFFSET(m_stObjectID, ul32OffsetAddr);
            }
            break;
            case PROP_OBJECT_NAME:
            {
                 GET_DEVPROP_OFFSET(m_stObjName, ul32OffsetAddr);
            }
            break;
            case PROP_OBJECT_TYPE:
            {
                 GET_DEVPROP_OFFSET(m_stObjectType, ul32OffsetAddr);
            }
            break;
            case PROP_SYSTEM_STATUS:
            {
                 GET_DEVPROP_OFFSET(m_stSystemStatus, ul32OffsetAddr);
            }
            break;
            case PROP_VENDOR_NAME:
            {
                 GET_DEVPROP_OFFSET(m_stVendorName, ul32OffsetAddr);
            }
            break;
            case PROP_VENDOR_IDENTIFIER:
            {
                 GET_DEVPROP_OFFSET(m_stVendorId, ul32OffsetAddr);
            }
            break;
            case PROP_MODEL_NAME:
            {
                 GET_DEVPROP_OFFSET(m_stModelName, ul32OffsetAddr);
            }
            break;
            case PROP_FIRMWARE_REVISION:
            {
                 GET_DEVPROP_OFFSET(m_stFirmwareRev, ul32OffsetAddr);
            }
            break;
            case PROP_APPLICATION_SOFTWARE_VERSION:
            {
                 GET_DEVPROP_OFFSET(m_stApplSoftwareVersion, ul32OffsetAddr);
            }
            break;
            case PROP_APDU_TIMEOUT:
            {
                 GET_DEVPROP_OFFSET(m_stAPDUTimeout, ul32OffsetAddr);
            }
            break;
            case PROP_NUMBER_OF_APDU_RETRIES:
            {
                 GET_DEVPROP_OFFSET(m_stNumOfAPDURetries, ul32OffsetAddr);
            }
            break;
            case PROP_DEVICE_ADDRESS_BINDING:
            {
                 GET_DEVPROP_OFFSET(m_stDevAddBinding, ul32OffsetAddr);
            }
            break;
            case PROP_DATABASE_REVISION:
            {
                 GET_DEVPROP_OFFSET(m_stDatabaseRev, ul32OffsetAddr);
            }
            break;
            case PROP_PROTOCOL_VERSION:
            {
                 GET_DEVPROP_OFFSET(m_stProtocolVersion, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_REVISION:
            {
                 GET_DEVPROP_OFFSET(m_stProtocolRevision, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_SERVICES_SUPPORTED:
            {
                 GET_DEVPROP_OFFSET(m_stServicesSupported, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_OBJECT_TYPES_SUPPORTED:
            {
                 GET_DEVPROP_OFFSET(m_stObjectTypeSupported, ul32OffsetAddr);    
            }
            break;
            case PROP_OBJECT_LIST:
            {
                GET_DEVPROP_OFFSET(m_stObjectIDList, ul32OffsetAddr);
            }
            break;
            case PROP_MAX_APDU_LENGTH_ACCEPTED:
            {
                 GET_DEVPROP_OFFSET(m_stMaxAPDULenAccepted, ul32OffsetAddr);    
            }
            break;
            case PROP_SEGMENTATION_SUPPORTED:
            {
                 GET_DEVPROP_OFFSET(m_stSegmentationSupport, ul32OffsetAddr);    
            }
            break;
            case PROP_MAX_MASTER:
            {
				GET_DEVPROP_OFFSET(m_stMAXMaster, ul32OffsetAddr);
				break;
            }
            break;
            case PROP_MAX_INFO_FRAMES:
            {
				 GET_DEVPROP_OFFSET(m_stMaxInfoFrames, ul32OffsetAddr);
				 break;
            }
            break;
#ifdef BACDEL_PR14
			case PROP_PROPERTY_LIST:
            {
                 GET_DEVPROP_OFFSET(m_stPropertyList, ul32OffsetAddr);    
            }
            break;
#endif

#ifdef SEGMENTATION_SUPPORTED
			case PROP_APDU_SEGMENT_TIMEOUT:
            {
                 GET_DEVPROP_OFFSET(m_stAPDUSegTimeout, ul32OffsetAddr);    
            }
            break;
            case PROP_MAX_SEGMENTS_ACCEPTED:
            {
                 GET_DEVPROP_OFFSET(m_stMaxSegAccepted, ul32OffsetAddr);    
            }
            break;
#endif

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B)
			case PROP_ACTIVE_COV_SUBSCRIPTIONS:
            {
                 GET_DEVPROP_OFFSET(m_stActiveCOVSubList, ul32OffsetAddr);  
            }
            break;
#endif

#if (defined BACDEL_SER_DM_TS_B || defined BACDEL_SER_DM_UTC_B || \
	     (defined BACDEL_SER_AE_AA_A && defined BACDEL_PR23))
            case PROP_LOCAL_TIME:
            {
                 GET_DEVPROP_OFFSET(m_stLocalTime, ul32OffsetAddr);    
            }
            break;
            case PROP_LOCAL_DATE:
            {
                 GET_DEVPROP_OFFSET(m_stLocalDate, ul32OffsetAddr);    
            }
            break;
#endif
#ifdef BACDEL_SER_DM_UTC_B
            case PROP_UTC_OFFSET:
            {
                 GET_DEVPROP_OFFSET(m_stUTCOffset, ul32OffsetAddr);    
            }
            break;
            case PROP_DAYLIGHT_SAVINGS_STATUS:
            {
                 GET_DEVPROP_OFFSET(m_stDaylightSavingStatus, ul32OffsetAddr);   
            }
            break;    
#endif

#ifdef OPTIONAL_PROPERTY
            case PROP_LOCATION:
            {
	            GET_DEVPROP_OFFSET(m_stLocation, ul32OffsetAddr);
            }
            break;
            case PROP_DESCRIPTION:
            {
	            GET_DEVPROP_OFFSET(m_stDescription, ul32OffsetAddr);
            }
            break;

#ifdef BACDEL_PR14
			case PROP_SERIAL_NUMBER:
			{
				GET_DEVPROP_OFFSET(m_stSerialNumber, ul32OffsetAddr);
			}
			break;
#endif
#endif /* OPTIONAL_PROPERTY */
            default:
            {
				#ifdef DEBUG_PRINTF
                Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetAsignPropAccess : \
                    Property Match Not Found\r\n");
				#endif
                return ePropType;
            }
            break;
        }
    }
#ifdef BACDEL_OBJ_NP
	else if(OBJECT_NETWORK_PORT == eObjectType)
	{
		switch(eDevProp)
		{
			case PROP_OBJECT_IDENTIFIER:
			{
				GET_NETWORK_PORT_OFFSET(m_stObjectID, ul32OffsetAddr);
			}
			break;

			case PROP_OBJECT_NAME:
			{
				GET_NETWORK_PORT_OFFSET(m_stObjName, ul32OffsetAddr);
			}
			break;
			case PROP_OBJECT_TYPE:
			{
				GET_NETWORK_PORT_OFFSET(m_stObjectType, ul32OffsetAddr);
			}
			break;

			case PROP_DESCRIPTION:
			{
				GET_NETWORK_PORT_OFFSET(m_stDescription, ul32OffsetAddr);
			}
			break;

			case PROP_PROPERTY_LIST:
			{
				GET_NETWORK_PORT_OFFSET(m_stPropertyList, ul32OffsetAddr);
			}
			break;

			case PROP_PROFILE_NAME:
			{
				GET_NETWORK_PORT_OFFSET(m_stProfileName, ul32OffsetAddr);
			}
			break;
			case PROP_STATUS_FLAGS:
			{
				GET_NETWORK_PORT_OFFSET(m_stStatusFlag, ul32OffsetAddr);
			}
			break;
			case PROP_RELIABILITY:
			{
				GET_NETWORK_PORT_OFFSET(m_stReliability, ul32OffsetAddr);
			}
			break;
			case PROP_OUT_OF_SERVICE:
			{
				GET_NETWORK_PORT_OFFSET(m_stOutOfService, ul32OffsetAddr);
			}
			break;

			case PROP_NETWORK_TYPE:
			{
				GET_NETWORK_PORT_OFFSET(m_stNetworkType, ul32OffsetAddr);
			}
			break;
			case PROP_PROTOCOL_LEVEL:
			{
				GET_NETWORK_PORT_OFFSET(m_stProtocolLevel, ul32OffsetAddr);
