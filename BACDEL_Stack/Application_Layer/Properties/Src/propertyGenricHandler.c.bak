#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B /*&& defined BACDEL_PR14*/)

		case PROP_EVENT_DETECTION_ENABLE:
		{
			/* get offset address */
			GET_INTRINSIC_OFFSET(eObjectType, m_stEventDetectionEnable.m_bVal, ul32OffsetAddr);
			/* Copy data into property offset address */
			memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (bool *)pvData,
				sizeof(bool));

			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

			/* update dependent property if event detection enable value is false */
            if(!bInitFunctionality && !bRemoteDevFlag)
			{
				if(false == *((bool *)pvData))
	            {
					/* set dependent properties to default values */
	                Update_EventEnableDetection_Dependent_Properties(
	                    eObjectType, pvObject, pVirtualDev);
	            }
				else if(true == *((bool *)pvData))
				{
					{
						/* update event state when PV property value of object is not in normal range */
						UpdateEventStateProperty(eObjectType, pvObject, pVirtualDev);
					}
				}
			}
		}
		break;

#ifdef OPTIONAL_PROPERTY
		case PROP_TIME_DELAY_NORMAL:
        {
            /* Update property offset */
            GET_TIME_DELAY_NORMAL_OFFSET(eObjectType, m_stTimeDelayNormal.m_u32Val, ul32OffsetAddr);
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (uint32_t *)pvData,
				sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
		break;
#endif /* optional property */

#endif /* INTRINSIC_REPORTING && EN_B && PR14 */
#if ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_GEI_B) || \
	(defined BACDEL_SER_AE_ESUM_A) || (defined BACDEL_SER_AE_ESUM_B))
        /* For Object Notification class */
        case PROP_NOTIFICATION_CLASS:
        {
             /* Update property offset */
            GET_NCPROP_OFFSET(eObjectType, m_stNotificationClass.m_u32Val, ul32OffsetAddr);
           
