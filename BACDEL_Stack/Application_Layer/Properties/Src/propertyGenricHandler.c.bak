					memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, sizeof(Float_t));
		
					/* Copy data into property offset address */
					memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
