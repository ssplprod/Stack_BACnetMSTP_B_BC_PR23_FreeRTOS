			}
        }
        break;
        
        /* Fault values */
        case PROP_FAULT_VALUES:
        {
            /* Update property offset */
            GET_FAULT_VALUES_OFFSET(eObjectType, m_stFaultValues, ul32OffsetAddr); 

            /* update the property value */
            UpdateFaultValues(eObjectType, pvObject, pvData, pvPropAdd, 
                i32ArrayIndex, ul32OffsetAddr, bInitFunctionality, bWriteNULL);

			/* Other than Add Property time, event state should update */
            if(!bInitFunctionality && !bRemoteDevFlag)
            {
				/* check if notification is to be generated */
