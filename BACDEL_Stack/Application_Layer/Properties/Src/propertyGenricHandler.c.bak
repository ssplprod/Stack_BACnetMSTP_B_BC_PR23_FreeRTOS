				sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;
              
#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO || defined BACDEL_OBJ_BV)
         /* For Object Inactive Text */
        case PROP_INACTIVE_TEXT:
        {
            /* Update String length value */
            GET_BINARYONLY_OFFSET(eObjectType , m_stInactive_Text.m_stCHARString, 
                                ul32OffsetAddr);
                                                            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr), 0x00, sizeof(BACnetCharStr_t));

             /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                            sizeof(BACnetCharStr_t));
         
            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;
       
        /* For Object Active Text */
        case PROP_ACTIVE_TEXT:
        {
            /* Update String length value */
            GET_BINARYONLY_OFFSET(eObjectType , m_stActive_Text.m_stCHARString, 
                                ul32OffsetAddr);
                                                            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr), 0x00, sizeof(BACnetCharStr_t));

             /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                            sizeof(BACnetCharStr_t));
          
            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;

        case PROP_ELAPSED_ACTIVE_TIME:
        {
            /* Get offset of property Access Type */
            GET_BINARYONLY_OFFSET(eObjectType,m_stElaspsedActiveTime.stActiveElapseTime,      //<@>
									ul32OffsetAddr);

            /* If present value is in INACTIVE then dnt log the time.
               The Next start ACTIVE state will be considered as base */
            u32Data = GetPolarity(ul32BaseAddr, eObjectType);      // <@>
            ul32OffsetAddr = GetPresentValOffset(eObjectType, u32Data);
            memcpy(&eBinaryPv, (int8_t *)(ul32BaseAddr+ul32OffsetAddr), 
                                        sizeof(BACNET_BINARY_PV));
			
            /* update PV in case of reverse polarity */
            if(POLARITY_REVERSE == u32Data && MIN_BINARY_PV == eBinaryPv)
            {
	            eBinaryPv = BINARY_ACTIVE;
            }
            else if(POLARITY_REVERSE == u32Data && MAX_BINARY_PV == eBinaryPv)
            {
	            eBinaryPv = BINARY_INACTIVE;
            }
			                            
            /* Get the current time and update relevant BACnet stack Datetime structure */
			GetDevice_DateTime(&stDateTime.m_stDateTime.m_stDate, 			  // <@>
                &stDateTime.m_stDateTime.m_stTime, 
                pVirtualDev);

            /* Other than Add Property time, 
                Change of state Count should update */
            if((bInitFunctionality)||(g_bWriteRequest))
            {
				/* set value */ 
				u32Data = 0;
				         
                /* Get offset of unsigned Elapsed Active Time property */
                GET_BINARYONLY_OFFSET(eObjectType, m_stElaspsedActiveTime.
					stActiveElapseTime.m_u32Val, ul32OffsetAddr);
               
                /* Copy data into property offset address */
                memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), &u32Data,
					sizeof(uint32_t ));
                
                ul32BaseAddrBackup = ul32OffsetAddr;

                *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
                
				/* Revert back the status */
				g_bWriteRequest = false;
				
                /* If current state is ACTIVE then only take backup */
                if(eBinaryPv == BINARY_ACTIVE)
                {
                    /* Get Active state elapse time property offset */
                    GET_BINARYONLY_OFFSET(eObjectType, m_stElaspsedActiveTime.
						stActiveStateTime, ul32OffsetAddr);
                   
                    /* Copy data into property offset address */
                    memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), &stDateTime,
						sizeof(Pr_BACnetDateTime_t));
                }
                bRecursiveCall = true;
                /* Make sure that PROP_TIME_OF_ACTIVE_TIME_RESET case doesn't 
                have recursive call */
                eDependentProp = PROP_TIME_OF_ACTIVE_TIME_RESET;
                pvData = &stDateTime.m_stDateTime;
				/* Update property Access Type offset */
				ePermission = GetDefndPropAccess(eObjectType, 
					PROP_TIME_OF_ACTIVE_TIME_RESET, NOT_SUPPORTED);
            }
            /* Call from internal logic i.e. present value change to active */
            else
            {
                if(eBinaryPv == BINARY_ACTIVE)
                {
                    /* Get base time from Change of state time Property */
                    GET_BINARYONLY_OFFSET(eObjectType,m_stElaspsedActiveTime.
						stActiveStateTime, ul32OffsetAddr);   
                                    
                    /* Copy data into property offset address */
                    memcpy(&stInDateTime, (void *)(ul32BaseAddr+ul32OffsetAddr),
						sizeof(Pr_BACnetDateTime_t));
					
					#ifdef __FREERTOS__
					/* convert date time value in to second */
					ulTotalInSec = Convert_DateTime_InToSecond(&stInDateTime);
					#endif
					
					/* check time values are changed or not */
					if(ulTotalInSec != ulTotalSec)
                    {
						/* Get base time from Change of state time Property */
						GET_BINARYONLY_OFFSET(eObjectType,m_stElaspsedActiveTime.
							stActiveElapseTime.m_u32Val, ul32OffsetAddr);
						/* Copy data into property offset address */
						memcpy(&u32Data, (void *)(ul32BaseAddr+ul32OffsetAddr),
							sizeof(uint32_t)); 	                                                        
						u32Data += (uint32_t)(ulTotalSec - ulTotalInSec);                          
	                    
						/* Copy data into property offset address */
						memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), &u32Data,
							sizeof(uint32_t));
						/* update current time */
						GET_BINARYONLY_OFFSET(eObjectType,m_stElaspsedActiveTime.
							stActiveStateTime, ul32OffsetAddr);

						/* Copy data into property offset address */
						memcpy((void *)(ul32BaseAddr+ul32OffsetAddr) ,&stDateTime,
							sizeof(Pr_BACnetDateTime_t));

						*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
                    }/* End of Time change if condition */
                }/* End of If Binary Pv is In Active */
            }/* End of else condition */
        }
        break;

        case PROP_CHANGE_OF_STATE_COUNT:
        {
			/* Update property offset */
            GET_BINARYONLY_OFFSET(eObjectType,
                                    m_stChangeOfStateCount.m_u16Val,
                                    ul32OffsetAddr);

            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                                                    sizeof(uint16_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            /* Update Change of State Time Property */
            if((!bInitFunctionality)&&(
                (eObjectType == OBJECT_BINARY_INPUT)||
                (eObjectType == OBJECT_BINARY_OUTPUT)||
                (eObjectType == OBJECT_BINARY_VALUE)))
            {
                /* Get the current time and update relevant structure */                
				GetDevice_DateTime(&stDateTime.m_stDateTime.m_stDate,           
                    &stDateTime.m_stDateTime.m_stTime, 
  			pVirtualDev);

                /* Enable Flag to Call Recursive call to update Status flag */
                bRecursiveCall = true;
                pvData = &stDateTime.m_stDateTime;
                
                /* NOTE : bWriteNULL == true indicates recursive call */ 
                if(bWriteNULL)
                {
                    /* Make sure that change of state time case doesn't have recursive call */
                    eDependentProp = PROP_CHANGE_OF_STATE_TIME;
                }
                /* Call Form actual write function */
                else
                {
                    /* Make sure that time of state count reset case doesn't have recursive call */
                    eDependentProp = PROP_TIME_OF_STATE_COUNT_RESET;
                }
            }
        }
        break;      
        
        /* For Change of state time . Expect pvdata as an pointer to 
        Pr_BACnetDateTime_t structure */
        case PROP_CHANGE_OF_STATE_TIME:
        {
#ifdef BACDEL_SER_DS_COV_B

#endif
            
            /* Update property offset */
            GET_BINARYONLY_OFFSET(eObjectType,m_stChangeOfStateTime.m_stDateTime ,ul32OffsetAddr);
            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, 
                                sizeof(BACnetDateTime_t));
                           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(BACnetDateTime_t *)pvData,
                                                    sizeof(BACnetDateTime_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B

#endif
        }
        break;
        
        /* For Time of state count reset . Expect pvdata as an pointer to 
        Pr_BACnetDateTime_t structure */
        case PROP_TIME_OF_STATE_COUNT_RESET:
        {
#ifdef BACDEL_SER_DS_COV_B

#endif

            /* Update property offset */
            GET_BINARYONLY_OFFSET(eObjectType,m_stCountResetTime.m_stDateTime ,ul32OffsetAddr);
            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, 
                                sizeof(BACnetDateTime_t));
                           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(BACnetDateTime_t *)pvData,
                                                    sizeof(BACnetDateTime_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B

#endif
        }
        break;
        
        /* For time of active time reset. Expect pvdata as an pointer to 
        Pr_BACnetDateTime_t structure */
        case PROP_TIME_OF_ACTIVE_TIME_RESET:
        {
#ifdef BACDEL_SER_DS_COV_B

#endif
            
            /* Update property offset */
            GET_BINARYONLY_OFFSET(eObjectType,m_stActiveTimeResetTime.m_stDateTime ,ul32OffsetAddr);
            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, 
                                sizeof(BACnetDateTime_t));
                           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(BACnetDateTime_t *)pvData,
                                                    sizeof(BACnetDateTime_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B

#endif
        }
        break;
#endif /* BI - BO - BV */

#if (defined BACDEL_OBJ_BO || defined BACDEL_OBJ_BV)
        /* For minimum time for the Object to be inactive state */
        case PROP_MINIMUM_OFF_TIME:
        {
            /* Get property offset */
            GET_MIN_ON_OFF_TIME_OFFSET(eObjectType,m_stMinimumOffTime.m_u32Val,
                                                         ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData, 
                    sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;
       
        /* For minimum time for the Object to be active state */
        case PROP_MINIMUM_ON_TIME:
        {
            /* Get property offset */
            GET_MIN_ON_OFF_TIME_OFFSET(eObjectType,m_stMinimumOnTime.m_u32Val,
                                                         ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData, 
                    sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;       
#endif /* BO - BV */
#endif /* OPTIONAL_PROPERTY */

#if (defined OPTIONAL_PROPERTY)
		case PROP_MAX_PRES_VALUE:
		{
			int8_t i8Len = 0;
		switch(eObjectType)
		{

			default:
			{
				 /* Update property offset */
				 GET_MAX_PV_VALUE_OFFSET(eObjectType, m_stMaxPresValue ,ul32OffsetAddr);

				 if(eObjectType == OBJECT_ACCUMULATOR)
				 i8Len = sizeof(uint32_t);
				 else
				 i8Len = sizeof(Float_t);

				 memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, i8Len);
				 /* Copy data into property offset address */
				 memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), pvData, i8Len);
		
			}
			break;
		}
		*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

			}
			
		break;
		
#endif /* (defined OPTIONAL_PROPERTY) */

#if (defined OPTIONAL_PROPERTY || defined BACDEL_SER_AE_EN_B || defined BACDEL_OBJ_SDL)
		
		/* For Object Reliability */
        case PROP_RELIABILITY:
        {
			void *pvLocalData = NULL;
			void *pvDummy = NULL;
			bool bDoubleNotification = FALSE;

            /* Update property offset */
			GET_RELIABILITY_OFFSET(eObjectType,m_stReliability.m_eReliabilty ,
                                                           ul32OffsetAddr);

#ifdef FAULT_ALGORITHM
			/*Get Reliability To  & From*/
			memcpy(&eReliabilityFrom, (void *)(ul32BaseAddr+ul32OffsetAddr),
				sizeof(BACNET_RELIABILITY));

			memcpy(&eReliabilityTo, (int8_t *)pvData,
				sizeof(BACNET_RELIABILITY));
#endif
			/* save previous reliability */
			if(!bInitFunctionality && !bRemoteDevFlag)
			{
				/* Copy data from property offset address */
				memcpy(&eReliability, (void *)(ul32BaseAddr+ul32OffsetAddr),
					sizeof(BACNET_RELIABILITY));
				/* save the address in pvPropAdd */
				pvDummy = *pvPropAdd;
			}

            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (int8_t *)pvData ,
                                               sizeof(BACNET_RELIABILITY));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

			/* Read the StatusFlag structure and update it by calling back */
			GET_STATUSFLAG_OFFSET(eObjectType, m_stStatusFlag, ul32OffsetAddr);
			memcpy(&stBitString , (Pr_BACnetBitStr_t *)(ul32BaseAddr+ul32OffsetAddr),
				sizeof(Pr_BACnetBitStr_t));
			u8Data = stBitString.m_stBitStr.m_u8TransBits[0];

			/* update status flag */
			if(*((bool *)pvData))
			   stBitString.m_stBitStr.m_u8TransBits[0] |= 0x02;//(0x01<<3); /* Set bit */
			else
			   stBitString.m_stBitStr.m_u8TransBits[0] &= 0xFD;//(0x01<<3); /* Reset bit */
			/* Make sure that PROP_STATUS_FLAGS case doesn't have recursive call */
			eDependentProp = PROP_STATUS_FLAGS;
			pvLocalData = &stBitString;
			/* do not change status flags if value is same */
			if(u8Data != stBitString.m_stBitStr.m_u8TransBits[0])
			{
				/* call update common property function to update status flag */
				UpdateCommonProperty(eObjectType, pvObject, PROP_STATUS_FLAGS, i32ArrayIndex,
										pvLocalData, ePermission, pvPropertyPtr, pvPropAdd, pvVirtualDev,
										bInitFunctionality, false, false);
			}
			pvLocalData = NULL;

#if 1
			/* Check if event_state needs to be changed */
			if(RELIABILITY_NO_FAULT_DETECTED != *((BACNET_RELIABILITY *)pvData) &&
                !bRemoteDevFlag &&
                OBJECT_SCHEDULE != eObjectType && OBJECT_PROGRAM != eObjectType
				)
			{
				/* check if previous reliability was no fault detected, if so then only
					go for below process */
				eEventStateTo = EVENT_STATE_FAULT;
				pvLocalData = &eEventStateTo;
				eAccessType = READ_ONLY;

	            /* Update property offset */
				GET_EVENTSTATE_OFFSET(eObjectType, m_stEventState.m_eEventState,
					ul32OffsetAddr);
#ifdef FAULT_ALGORITHM
				/* get the current event state */
				memcpy(&eEventStateFrom,(void *)(ul32BaseAddr+ul32OffsetAddr),
					sizeof(BACNET_EVENT_STATE));
#endif
#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B)
                /* get the present value */
				if(NULL == pvDummy)
				{
					Get_Reference_Prop_Value(eObjectType, &uPropertyValue, pvObject);
					/* assign prop value */
					pvDummy = &uPropertyValue;
				}
#endif

#ifdef FAULT_ALGORITHM
				if(eEventStateTo != eEventStateFrom)
#endif
				{
				/* update the event state */
				UpdateCommonProperty(eObjectType, pvObject, PROP_EVENT_STATE,
									i32ArrayIndex , pvLocalData, eAccessType, pvPropertyPtr, &pvDummy,
									pvVirtualDev, bInitFunctionality, false, false);
				}
#ifdef FAULT_ALGORITHM
				else if(eReliabilityTo != eReliabilityFrom)
				{
					bGenerateNotifcation = true;
					if(NULL != *pvPropAdd)
					{
						uint32_t i32Len;
						GET_PRESENTVAL_OFFSET(eObjectType,m_stPresentValue,ul32OffsetAddr,i32Len);

					    /* copy the present value */
					    memcpy(&uPropertyValue.fVal, (float*)(ul32BaseAddr + ul32OffsetAddr), i32Len);
					}
				}
#endif
			}

			else if(!bInitFunctionality && !bRemoteDevFlag &&
				OBJECT_SCHEDULE != eObjectType && OBJECT_PROGRAM != eObjectType)
			{
				/* reliablity is no fault detected */
				/* this code does not executes during property addition or object creation */
#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B)
				/* call function to check if event_state needs to be updated */
				eFuncRet = UpdateEventState_On_Reliablity(eObjectType, pvObject, pvInData,
											&bEventChange, &eEventStateTo, &eEventStateFrom,
											&uPropertyValue, pVirtualDev, &u16Data, &u32Data);
				if(TRUE == bEventChange && BACDEL_ERROR != eFuncRet)
				{
					/* NOTE - bWriteNull is sent true to indicate that this
							is call from timer */
					if((eEventStateTo == EVENT_STATE_LOW_LIMIT ||
						eEventStateTo == EVENT_STATE_HIGH_LIMIT ||
						eEventStateTo == EVENT_STATE_OFFNORMAL) && !bWriteNULL)
					{
						/* call is not from timer send two notifications */
						eEventStateTo = EVENT_STATE_NORMAL;
						bDoubleNotification = TRUE;
					}
					pvLocalData = &eEventStateTo;
					eAccessType = READ_ONLY;
					/* assign prop value */
					pvDummy = &uPropertyValue;
					/* update the event state */
					UpdateCommonProperty(eObjectType, pvObject, PROP_EVENT_STATE,
						i32ArrayIndex , pvLocalData, eAccessType, pvPropertyPtr, &pvDummy,
						pvVirtualDev, bInitFunctionality, false, false);
					if(bDoubleNotification)
					{
                        /* get time delay value base on event state */
				        Get_TimeDelay_value(eObjectType, pvObject, eEventStateTo, &u32TimeDelay);
					}
				}
#endif
			}
#endif
		}
        break;

#endif /* RELIABLITY */

#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B)

		/* For Object minimum time delay for present value to generate
         alarm/event */
        case PROP_TIME_DELAY:
        {
            /* Update property offset */
            GET_TIME_DELAY_OFFSET(eObjectType,m_stTimeDelay.m_u32Val ,
                                                    ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                    sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;

