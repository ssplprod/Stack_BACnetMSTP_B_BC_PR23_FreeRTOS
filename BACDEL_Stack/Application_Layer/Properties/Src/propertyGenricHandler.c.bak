#if ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_GEI_B))
        /* To read Object Event Enable */
        case PROP_EVENT_ENABLE:
        {
#ifdef BACDEL_SER_DS_COV_B

#endif

			GET_INTRINSIC_OFFSET(eObjectType,m_stEventEnable ,ul32OffsetAddr);
		       
			/* Copy data into property offset address */
			memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (Pr_BACnetBitStr_t *)pvData, 
				sizeof(Pr_BACnetBitStr_t));

			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B

#endif
		}
        break;
#endif /* ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_GEI_B)) */
            
#if ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_AA_B) || \
	(defined BACDEL_SER_AE_GEI_B) || (defined BACDEL_SER_AE_ASUM_B) || \
	(defined BACDEL_SER_AE_ESUM_A))
        /* To read Object Ackonowledge transactions */
        case PROP_ACKED_TRANSITIONS:
        {
            Pr_BACnetBitStr_t *pstAckedTransitions;

#ifdef BACDEL_SER_DS_COV_B

#endif

			/* Update property offset */
			GET_INTRINSIC_OFFSET(eObjectType, m_stAckedTransitions, ul32OffsetAddr);
           
			/* Copy data into property offset address */
			memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (Pr_BACnetBitStr_t *)pvData , 
				sizeof(Pr_BACnetBitStr_t));

            pstAckedTransitions = (Pr_BACnetBitStr_t *)pvData;

			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B

#endif
#ifdef BACDEL_SER_AE_GEI_B    
            GET_INTRINSIC_OFFSET(eObjectType,m_i32GetSummary, ul32OffsetAddr);
			if(BACNET_NEGATIVE_ONE == ((int32_t)ul32OffsetAddr))
				break;
            i32GetSummary = (uint32_t *)(ul32BaseAddr+ul32OffsetAddr);
            if(pstAckedTransitions->m_stBitStr.m_u8TransBits[0] == ACKTRANS_ALL_BIT_TRUE )
				/* clear bit 6 of m_i32GetSummary */
                BIT_CLEAR(*i32GetSummary,6);
            else
				/* set bit 6 of m_i32GetSummary */
                BIT_SET(*i32GetSummary,6);
#endif
        }
        break;
#endif 
		/* ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_AA_B) || 
	(defined BACDEL_SER_AE_GEI_B) || (defined BACDEL_SER_AE_ASUM_B) || 
	(defined BACDEL_SER_AE_ESUM_A)) */

#if ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_GEI_B) || \
	(defined BACDEL_SER_AE_ASUM_B))
        /* For Object Notification type */
        case PROP_NOTIFY_TYPE:
        {
            BACNET_NOTIFY_TYPE	eNotifyType;
			/* Update property offset */
			GET_INTRINSIC_OFFSET(eObjectType,m_stNotifyType.m_eNotifyType ,ul32OffsetAddr);

			/* Copy data into property offset address */
			memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (BACNET_NOTIFY_TYPE *)pvData , 
											   sizeof(BACNET_NOTIFY_TYPE));

			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            eNotifyType = *(BACNET_NOTIFY_TYPE*)pvData;
#ifdef BACDEL_SER_AE_GEI_B    
            GET_INTRINSIC_OFFSET(eObjectType,m_i32GetSummary,ul32OffsetAddr);
			if(-1 == (ilong32_t)ul32OffsetAddr)
			{
				break;
			}
            i32GetSummary = (uint32_t *)(ul32BaseAddr+ul32OffsetAddr);
            if(eNotifyType == NOTIFY_ALARM)
                /* set bit 5 of m_i32GetSummary */
                BIT_SET(*i32GetSummary,5);				
            else
                /* clear bit 5 of m_i32GetSummary */
                BIT_CLEAR(*i32GetSummary,5);
				
#endif
        }
        break;
#endif 
		/* ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_GEI_B) || 
	(defined BACDEL_SER_AE_ASUM_B)) */
        
#if ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_AA_B) || \
	(defined BACDEL_SER_AE_GEI_B))
        case PROP_EVENT_TIME_STAMPS:
        {
			void *pstBackupTimeStamp = NULL;

#ifdef BACDEL_SER_DS_COV_B

#endif
		            
			/* Update property offset */
			GET_INTRINSIC_OFFSET(eObjectType, m_stEventTimeStamps, ul32OffsetAddr);

			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

			if(bInitFunctionality)
			{
				/* Copy data into property offset address */
				memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(Pr_BACnetEventTimeStamp_t *)pvData,
														sizeof(Pr_BACnetEventTimeStamp_t));
			}
			else /* other than init_functionality */
			{
                /* NOTE : it is assumed that array index validation is done before */
                if(i32ArrayIndex >= 0)
                {
				    /* get the array index */
				    u32Index = i32ArrayIndex - 1;
				    /* Update property offset */
				    GET_INTRINSIC_OFFSET(eObjectType, 
                        m_stEventTimeStamps.m_uEvntStamp[u32Index], ul32OffsetAddr);
				    pstBackupTimeStamp = (timeStamp_u *)pvData;
				    /* Copy data into property offset address */
				    memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), pstBackupTimeStamp,
                        sizeof(timeStamp_u));
                }
				else if(i32ArrayIndex == 0)
				{
					; // this property is not resizable
				}
                else
                {
                   /* Copy data into property offset address */
					memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(Pr_BACnetEventTimeStamp_t *)pvData,
						sizeof(Pr_BACnetEventTimeStamp_t));
                }
			}

#ifdef BACDEL_SER_DS_COV_B

#endif
		}
        break;
#endif 
		/* ((defined BACDEL_SER_AE_EN_B) || (defined BACDEL_SER_AE_AA_B) || \
	(defined BACDEL_SER_AE_GEI_B)) */

#ifdef BACDEL_OBJ_NC
		/* Priority - unsigned array of 3 for NC object */
		case PROP_PRIORITY:
	    {
			/* local variable */
            Pr_BACnetNotifyPriority_t *pstPriority = NULL;
			Pr_BACnetNotifyPriority_t *pstPriorityWp = NULL;
			uint8_t u8Count = 0;

             /* Get property offset */
			GET_NC_OBJ_PROP_OFFSET(eObjectType, m_stPriority, ul32OffsetAddr);	

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

            if(bInitFunctionality)
            {			   	
			    /* copy the data to property offset address */
			    memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), pvData, 
                    (sizeof(Pr_BACnetNotifyPriority_t)));
            }
            else
            {
                /* copy data to given array index */
                pstPriority = (void *)(ul32BaseAddr+ul32OffsetAddr);
				if(NULL == pvData)
				{
					;// errorcase, do nothing
				}
				else
				{
					/* get data to be written */
					pstPriorityWp = (Pr_BACnetNotifyPriority_t *)pvData;
					if(i32ArrayIndex > 0 && i32ArrayIndex < BACNET_ARRAY_OF_THREE)
					{
						/* copy at specific index */
						pstPriority->m_u32Value[i32ArrayIndex - 1] = pstPriorityWp->m_u32Value[0];
					}
					else if(i32ArrayIndex < 0)
					{
						/* copy complete array */
						for(u8Count = 0; u8Count < BACNET_ARRAY_OF_THREE; u8Count++)
						{
							pstPriority->m_u32Value[u8Count] = pstPriorityWp->m_u32Value[u8Count];
						}
					}
					else
					{
						; /* This property is not resizable so array index cannot be 0 */
					}
				}
            }
		}
        break;

		/* Recipient List */
		case PROP_RECIPIENT_LIST:
		{
			ListOfBACnetDestination_t *pstBacnetDestinations = NULL;
            Pr_ListOfBACnetDestination_t	*ptRecipientList = NULL;
            GET_NC_OBJ_PROP_OFFSET(eObjectType, m_stRecipientList, ul32OffsetAddr);		
			/* copy the data to property offset address */
			ptRecipientList = (Pr_ListOfBACnetDestination_t *)(ul32BaseAddr+ul32OffsetAddr);
            pstBacnetDestinations = ptRecipientList->m_pstNCRecepient;
                            
			/*pstBacnetDestinations = gstHostDevice.m_pstDeviceStruct->m_stSupportedObjects.
				m_pstNotificationClass->m_stRecipientList.m_pstNCRecepient;*/

			*pvPropAdd = (void *)pstBacnetDestinations;

			if(NULL == pstBacnetDestinations)
			{
				pstBacnetDestinations = (ListOfBACnetDestination_t *)pvData;
				/* update pointer in global structure as this is the 1st recipient */
				ptRecipientList->m_pstNCRecepient = pstBacnetDestinations;
			}
            else if(*pvPropAdd == pvData)
            {
                /* remove List, just visit update common Prop, so bypass all other functionality */
            }
			else
			{
				/* scan till the last member in recipient list */
				while(pstBacnetDestinations->m_pstNext!=NULL)
				{
					pstBacnetDestinations = pstBacnetDestinations->m_pstNext;
				}
                /* add the new recipient list */
				pstBacnetDestinations->m_pstNext = (ListOfBACnetDestination_t *)pvData;
			}

		}
        break;

		case PROP_ACK_REQUIRED:
		{
#ifdef BACDEL_SER_DS_COV_B 

#endif           
			/* Update property offset */
			GET_NC_OBJ_PROP_OFFSET(eObjectType,m_stAckRequired ,ul32OffsetAddr);
			/* Copy data into property offset address */
			memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (int8_t *)pvData, sizeof(Pr_BACnetBitStr_t));

			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
#ifdef BACDEL_SER_DS_COV_B  

#endif
		}
        break;
#endif /* BACDEL_OBJ_NC */

#ifdef BACDEL_OBJ_CAL
        case PROP_DATE_LIST:
        {
            Pr_ListOfBACnetCalendarEntry_t   *pstDateList = NULL;
            ListOfBACnetCalendarEntry_t        *pstListOfCalendar = NULL;
            bool                    bDefaultPresVal = 0;
            /* Update property offset */
            GET_OBJCALPROP_OFFSET(eObjectType,m_stDateList,ul32OffsetAddr);          
            /* Copy data into local variable */
            pstDateList = (void *)(ul32BaseAddr+ul32OffsetAddr);
            *pvPropAdd = (void *)pstDateList;
            pstListOfCalendar = pstDateList->m_pstListOfCalendar; 
			if(NULL == pstListOfCalendar || pvData == pstListOfCalendar)
			{
				/* update pointer in property struct */
				pstListOfCalendar = (ListOfBACnetCalendarEntry_t *)pvData;
				pstDateList->m_pstListOfCalendar = pstListOfCalendar;
			}
			else
			{
				/* attach new node @ end of list */
				while(pstListOfCalendar->m_pstNext != NULL)
					pstListOfCalendar = pstListOfCalendar->m_pstNext;
                /* add the new recipient list */
				pstListOfCalendar->m_pstNext = (ListOfBACnetCalendarEntry_t *)pvData;
			}
            if(!bInitFunctionality)
            {               			 
                bRecursiveCall = true;
                eDependentProp = PROP_PRESENT_VALUE;
			    pvData = &bDefaultPresVal;
            }
        }
        break;
#endif /* BACDEL_OBJ_CAL */

#ifdef BACDEL_OBJ_SDL
        case PROP_EFFECTIVE_PERIOD:
        {
            BACNET_PROPERTY_VALUE  *pstValue = NULL;
			Pr_BACnetDateRange_t *pstEffPeriod = NULL;
            /* Update property offset */
            GET_SHDL_OFFSET(eObjectType,m_stEffectivePeriod,ul32OffsetAddr);

			pstEffPeriod = (Pr_BACnetDateRange_t *)(ul32BaseAddr+ul32OffsetAddr);
           
            /* Copy data into property offset address */
			memcpy(&pstEffPeriod->m_stDateRange, (BACnetDateRange_t *)pvData, 
				sizeof(BACnetDateRange_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            BACnetConfigData.m_stDateRange=pstEffPeriod->m_stDateRange;
            SaveBACnetDatatoNV();

            if(!bInitFunctionality)
            {
                GET_SHDL_OFFSET(eObjectType,m_stPresentValue.m_stValue,ul32OffsetAddr);
                pstValue = (void *)(ul32BaseAddr+ul32OffsetAddr);				 
                bRecursiveCall = true;
                eDependentProp = PROP_PRESENT_VALUE;
			    pvData = pstValue;
			    /* overwrite flag to evaluate reliability property */
			    bChangeReliability = bWriteNULL;
            }
        }
        break;

        case PROP_LIST_OF_OBJECT_PROPERTY_REFERENCES:
        {
            ListOfBACnetDevObjPropRef_t    *pstListOfBACnetDevObjPropReff = NULL;
            Pr_ListOfBACnetDevObjPropRef_t 	*pstListOfObjectPropertyReference = NULL;
            BACNET_PROPERTY_VALUE  *pstValue = NULL;
            
            /* Update property offset */
            GET_SHDL_OFFSET(eObjectType,m_stListOfObjectPropertyReference,ul32OffsetAddr);		
			/* copy the data to property offset address */
			pstListOfObjectPropertyReference = (Pr_ListOfBACnetDevObjPropRef_t *)(ul32BaseAddr+ul32OffsetAddr);
            pstListOfBACnetDevObjPropReff = pstListOfObjectPropertyReference->m_pstListOfBACnetDevObjPropReff;

			*pvPropAdd = (void *)pstListOfBACnetDevObjPropReff;

			if(NULL == pstListOfBACnetDevObjPropReff || pstListOfBACnetDevObjPropReff == pvData || 
                pvData == NULL)
			{
                /* Clear Object Property list if Input Data is NULL */
                if(pvData == NULL)
                {
                    /* */
                    Clear_DevObjPropReff_List(&pstListOfBACnetDevObjPropReff);
                }

				pstListOfBACnetDevObjPropReff = (ListOfBACnetDevObjPropRef_t *)pvData;
				/* update pointer in global structure as this is the 1st recipient */
				pstListOfObjectPropertyReference->m_pstListOfBACnetDevObjPropReff = pstListOfBACnetDevObjPropReff;
			}
			else
			{
				/* scan till the last member in recipient list */
				while(pstListOfBACnetDevObjPropReff->m_pstNext!=NULL)
				{
					pstListOfBACnetDevObjPropReff = pstListOfBACnetDevObjPropReff->m_pstNext;
				}
                /* add the new recipient list */
				pstListOfBACnetDevObjPropReff->m_pstNext = (ListOfBACnetDevObjPropRef_t *)pvData;
			}
            if(!bInitFunctionality)
            {
                GET_SHDL_OFFSET(eObjectType,m_stPresentValue.m_stValue,ul32OffsetAddr);
                pstValue = (void *)(ul32BaseAddr+ul32OffsetAddr);				 
                bRecursiveCall = true;
                eDependentProp = PROP_PRESENT_VALUE;
			    pvData = pstValue;
            }
            pstListOfBACnetDevObjPropReff = *pvPropAdd;
        }
        break;

        case PROP_WEEKLY_SCHEDULE:
        {
            Pr_ListOfBACnetDailySchedule_t   *pstDailySchedule = NULL;
            Pr_ListOfBACnetDailySchedule_t   *pstDailyScheduleWP = NULL;
            BACNET_PROPERTY_VALUE   *pstValue = NULL;
            int8_t                  i8Daycnt = 0;

            /* Update property offset */
            GET_SHDL_OFFSET(eObjectType,m_stWeeklySchedule,ul32OffsetAddr);
            if(bInitFunctionality)
            {   /* Copy data into property offset address */
                memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(Pr_ListOfBACnetDailySchedule_t *)pvData, 
				    sizeof(Pr_ListOfBACnetDailySchedule_t));
                *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

            }
            else
            {   
                pstDailySchedule = (Pr_ListOfBACnetDailySchedule_t *)(ul32BaseAddr+ul32OffsetAddr);
#ifdef BACDEL_SER_DS_COV_B

#endif
                /* free previous pointer*/
                if(i32ArrayIndex > 0)
                {
					pstDailyScheduleWP = pvData;
                    Clear_TimeValues_List(&(pstDailySchedule->m_stTimeValue[i32ArrayIndex-1]).m_pstNext);

                    /* If Not NULL Copy All Receveived Time Values, else clear 1st Element */
                    if(NULL != pvData)
                    {
                        /* FIXME: Clear MAlloc Memmory while decoding */
						memcpy(&pstDailySchedule->m_stTimeValue[i32ArrayIndex -1], &pstDailyScheduleWP->m_stTimeValue[0], 
							sizeof(BACnetTimeValue_t));
                        pstDailySchedule->m_stTimeValue[i32ArrayIndex -1].bIsUsed = 1;
						pstDailyScheduleWP->m_stTimeValue[0].m_pstNext = NULL;
                    }
                    else
                        memset(&pstDailySchedule->m_stTimeValue[i32ArrayIndex -1], 0, sizeof(BACnetTimeValue_t));
                }
                else if(i32ArrayIndex < 0)
                {
                    /* If Input is NULL then clear all Time Values for 7 Days */
                    Clear_WeeklyShdl_List(pstDailySchedule);

                    /* If received TimeValues for Days, Update all Weekly Schedule */
                    /* Expecting Values for 7 Days are Received here */
                    if(pvData != NULL)
                    {
                        pstDailyScheduleWP = pvData;
                        memcpy(pstDailySchedule, pstDailyScheduleWP, sizeof(Pr_ListOfBACnetDailySchedule_t));

                        i8Daycnt = 0;
						/* New values should not be freed, hence make it NULL */
						while(i8Daycnt < BACNET_ARRAY_OF_SEVEN)
                        {
                            pstDailyScheduleWP->m_stTimeValue[i8Daycnt].m_pstNext = NULL;
                            i8Daycnt++;
                        }
                    }
                }
				else
				{
					; /* This property is not resizable so array index cannot be 0 */
				}
#ifdef BACDEL_SER_DS_COV_B
               // pstDailySchedule->m_i32ActiveCOV = i32ActiveCOV;
#endif
             }

                if(!bInitFunctionality)
                {
                    GET_SHDL_OFFSET(eObjectType,m_stPresentValue.m_stValue,ul32OffsetAddr);
                    pstValue = (void *)(ul32BaseAddr+ul32OffsetAddr);				 
                    bRecursiveCall = true;
                    eDependentProp = PROP_PRESENT_VALUE;
			        pvData = pstValue;
                }
        }
        break;

        case PROP_EXCEPTION_SCHEDULE:
        { 
            Pr_ListOfBACnetSpecialEvent_t      *pstExceptionSchedule = NULL;
            ListOfSpecialEvent_t          *pstSplEvent = NULL;
            ListOfSpecialEvent_t          *pstTempSplEvent = NULL;
            BACNET_PROPERTY_VALUE   *pstValue = NULL;
            int32_t                 i32count = 2;
            uint32_t                u32NwSize = 0;

            /* Get Pointer of Exception schedule List */
            GET_SHDL_OFFSET(eObjectType,m_stExceptionSchedule,ul32OffsetAddr);
            pstExceptionSchedule = (void *)(ul32BaseAddr+ul32OffsetAddr);
            
            pstSplEvent = pstExceptionSchedule->m_pstSplEvent;

            if(bInitFunctionality)
            {
                /* if 1st element is null then get 1st element*/
                if(NULL == pstSplEvent)
                {
                    pstExceptionSchedule->m_pstSplEvent =   (ListOfSpecialEvent_t *)pvData;
                }
                else
                {
                    while(pstSplEvent->m_pstNext != NULL)
                    {
                        pstSplEvent = pstSplEvent->m_pstNext;
                    }
                    pstSplEvent->m_pstNext = (ListOfSpecialEvent_t *)pvData;
                }

                /* Check Count and store */
                pstSplEvent = pstExceptionSchedule->m_pstSplEvent;
                i32count = 0;
                while(pstSplEvent != NULL)
                {
                    pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.bIsUsed = 1;
                    pstSplEvent = pstSplEvent->m_pstNext;
                    i32count++;
                }

                pstExceptionSchedule->m_u32Count = i32count;
            }
            else
            {
                pstSplEvent = pstExceptionSchedule->m_pstSplEvent;

                if(i32ArrayIndex == 0)
                {
                    /* resize Exception Schedule List to Given Value */
                  	//u32NwSize =((BACNET_PROPERTY_VALUE*)pvData)->uValue.m_Unsigned_Int ;
					u32NwSize = *((uint32_t*)pvData);
                    i32count = 0;
                    pstTempSplEvent = pstSplEvent;

                    while(i32count < (int32_t)u32NwSize  && NULL != pstSplEvent)
                    {
                        pstTempSplEvent = pstSplEvent;
                        pstSplEvent = pstSplEvent->m_pstNext;
                        i32count++;
                    }

                    if(i32count == (int32_t)u32NwSize)
                    {
                        /* Clear Extra Nodes handle 1st Node */
                        if(u32NwSize != 0)
                            pstTempSplEvent->m_pstNext = NULL;
                        else
                            pstExceptionSchedule->m_pstSplEvent = NULL;

                        Clear_ExceptionShdl_List(&pstSplEvent);
                    }
                    else
                    {
                        /* Add More Node */
                        while(i32count < (int32_t)u32NwSize)
                        {
                            pstSplEvent = 
                                    OSAL_Malloc( sizeof(ListOfSpecialEvent_t),  __FILE__, __FUNCTION__, __LINE__); 

                             /* Fill Dummy Values */
                            pstSplEvent->m_stListSpecialEvent.m_eStatusCalendar = STATUS_DATE;
                            pstSplEvent->m_stListSpecialEvent.m_u32EventPriority = 16;
                            pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.bIsUsed = 0;

                            GetDevice_DateTime( &pstSplEvent->m_stListSpecialEvent.m_stPeriod.m_stDate,      
                                &pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.m_stTime,
                                pvVirtualDev);

                            if(i32count == 0)
                            {
                                /* Add 1st Node */
                                pstExceptionSchedule->m_pstSplEvent = pstSplEvent;
                                pstTempSplEvent = pstSplEvent;
                            }
                            else
                            {
                                /* Add to Last Node */
                                pstTempSplEvent->m_pstNext = pstSplEvent;
                                pstTempSplEvent = pstTempSplEvent->m_pstNext;
                            }
                            i32count++;
                        }
                    }

                    pstExceptionSchedule->m_u32Count = u32NwSize;
                }
                else if(i32ArrayIndex < 0)
                {
                    /* Clear Complete List -- List of Special event and List of Time Values */
                    pstExceptionSchedule->m_pstSplEvent = NULL;

                    Clear_ExceptionShdl_List(&pstSplEvent);

                    if(NULL != pvData)
                    {
                        /* Assigned NEW Received List of Special Events */
                        pstExceptionSchedule->m_pstSplEvent = (ListOfSpecialEvent_t*)pvData ;

                    }
                }
                else if(i32ArrayIndex > 0 )
                {
                    /* Find node and Clear TimeValues for specified Index */
                    i32count = 0;
                    while(i32count < i32ArrayIndex-1 && NULL != pstSplEvent)
                    {
                        pstSplEvent = pstSplEvent->m_pstNext;
                        i32count++;
                    }

                    /* free Time Values */
                    Clear_TimeValues_List(&pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.m_pstNext);

                    pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.m_pstNext = NULL;
                   
                    if(NULL != pvData && NULL != pstSplEvent)
                    {
                        /* Assign new Special Event to The Given Index */
                        memcpy( &pstSplEvent->m_stListSpecialEvent,
                                &((ListOfSpecialEvent_t*)pvData)->m_stListSpecialEvent, 
                                sizeof(BACnetSpecialEvent_t));
                        
                        /* Clear Malloced data while decoding Data */
                        OSAL_Free(pvData,  __FILE__, __FUNCTION__, __LINE__);
                    }
					else if(NULL != pstSplEvent)
					{
						/* clear nested list at specified index */
						Clear_TimeValues_List(&pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.m_pstNext);
						
						/* make entry used false */
						pstSplEvent->m_stListSpecialEvent.m_stListOfTimeValues.bIsUsed = false;
					}
                }

                /* Check Count and store */
                i32count = 0;
                pstSplEvent = pstExceptionSchedule->m_pstSplEvent;
                while(pstSplEvent != NULL)
                {
                    pstSplEvent = pstSplEvent->m_pstNext;
                    i32count++;
                }
                pstExceptionSchedule->m_u32Count = i32count;

            } // End of All Cases

            if(!bInitFunctionality)
            {
                GET_SHDL_OFFSET(eObjectType,m_stPresentValue.m_stValue,ul32OffsetAddr);
                pstValue = (void *)(ul32BaseAddr+ul32OffsetAddr);				 
                bRecursiveCall = true;
                eDependentProp = PROP_PRESENT_VALUE;
		        pvData = pstValue;
            }
        }
        break;
#endif /* BACDEL_OBJ_SDL */

#if (defined BACDEL_OBJ_SDL )
        case PROP_PRIORITY_FOR_WRITING:
        {
            BACNET_PROPERTY_VALUE  *pstValue = NULL;
            /* Update property offset */
            GET_PRIORITYFORWRT_OFFSET(eObjectType,m_stPriorityForWriting.m_u32Val,ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(uint32_t *)pvData, 
				sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            if(!bInitFunctionality && eObjectType == OBJECT_SCHEDULE)
            {
                GET_SHDL_OFFSET(eObjectType,m_stPresentValue.m_stValue,ul32OffsetAddr);
                pstValue = (void *)(ul32BaseAddr+ul32OffsetAddr);				 
                bRecursiveCall = true;
                eDependentProp = PROP_PRESENT_VALUE;
		        pvData = pstValue;
            }
        }
        break;
#endif /* SDL - LOOP */

#ifdef BACDEL_OBJ_SDL
        case PROP_SCHEDULE_DEFAULT:
        {
            BACNET_PROPERTY_VALUE  *pstValue = NULL;
            /* Update property offset */
            GET_SHDL_OFFSET(eObjectType,m_stScheduleDefault.m_stValue,ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(BACNET_PROPERTY_VALUE *)pvData, 
				sizeof(BACNET_PROPERTY_VALUE));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

            if(!bInitFunctionality)
            {
                GET_SHDL_OFFSET(eObjectType,m_stPresentValue.m_stValue,ul32OffsetAddr);
                pstValue = (void *)(ul32BaseAddr+ul32OffsetAddr);				 
                bRecursiveCall = true;
                eDependentProp = PROP_PRESENT_VALUE;
		        pvData = pstValue;
            }
        }
        break;
#endif /* BACDEL_OBJ_SDL */


		/* default case */
        default:
        {   
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:UpdateCommonProperty :"
                "BACDEL_PROPERTY_NOT_PRESENT\r\n"); 
			#endif
            /* No property found */
            eFuncRet = BACDEL_PROPERTY_NOT_PRESENT;
        }
        break;
    }/* End of Switch Case */

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B)
    /* Retrive the COVIndex from the property */
    pvPropCovValue = Get_ActiveCOV_Value_Pointer(pvObject, eObjectType, eDevProp);
    if(pvPropCovValue != NULL)
    {
        i32ActiveCOVValue = *pvPropCovValue;    //Get value of COV variable in Property
        if(i32ActiveCOVValue && !bRecursiveCall)
        {
            BACnetAddress_t stAddress = {0};
			pvMsgQdata = Create_Message_Queue_Struct(pVirtualDev,
							(void *)(ul32BaseAddr+ul32OffsetAddr), FALSE, eDevProp,
							stAddress, DATA_NOT_AVALIABLE);
            if(NULL != pvMsgQdata)
            {
                postThreadMsg.idThread = pVirtualDev->m_dwNotificationThreadID;
				postThreadMsg.MsgType = MSGQ_TYPE;
				postThreadMsg.wParam = (unsigned int)i32ActiveCOVValue;
				postThreadMsg.lParam = (void*)pvMsgQdata;
				xQueueSend(Cov_EventQueue, &postThreadMsg, (TickType_t)100);
            }
        }
    }
#endif /* BACDEL_SER_DS_COV_B || BACDEL_SER_DS_COVP_B */

#if ((defined INTRINSIC_REPORTING || defined ALGORITHMIC_REPORTING) && defined BACDEL_SER_AE_EN_B && defined BACDEL_OBJ_NC)
	if(bGenerateNotifcation)
	{
#ifdef FAULT_ALGORITHM
		GET_RELIABILITY_OFFSET(eObjectType,m_stReliability.m_eReliabilty ,
													   ul32OffsetAddr);
		memcpy(&eReliability, (void *)(ul32BaseAddr+ul32OffsetAddr),
				sizeof(BACNET_RELIABILITY));
#endif /*FAULT_ALGORITHM*/

		/* post the event notification to the notification thread */
		Post_Event_Notification(eObjectType, pvObject, 
				eEventStateTo, eEventStateFrom, eReliability, &uPropertyValue, pVirtualDev);
	}	
#endif /* BACDEL_SER_AE_EN_B */
    /* If true , call back itself */
    if(true == bRecursiveCall && false == bRemoteDevFlag)
    {
    	UpdateCommonProperty(eObjectType, pvObject,eDependentProp, i32ArrayIndex, pvData,
    	                            ePermission,pvPropertyPtr, pvPropAdd, pvVirtualDev,
    	                            bInitFunctionality, false, bChangeReliability);
    }
    

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdateCommonProperty : Exit \r\n"); 
	#endif

    return eFuncRet;
}

/**
*
*DESCRIPTION
*   Get Present value /Dummmy present value offset based on outofservice
*
*@param eObjectType - Object Type 
*@param u8OutofService - Outofservice value
*@param ul32OffsetAddr - Offset address of the property
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/

ulong32_t GetPresentValOffset(BACNET_OBJECT_TYPE eObjectType, uint8_t u8OutofService)
{
    ulong32_t ul32OffsetAddr = 0;
    /* hold Sizeof */
    int32_t i32Len = 0;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetPresentValOffset : Entry \r\n"); 
	#endif
    if(u8OutofService == BACNET_ONE)
    {
        /* Get Dummy Present variable offset */
        //GET_PRESENTVAL_OFFSET(eObjectType,m_stBackupPresentValue,
        //                                    ul32OffsetAddr, i8Len); 
        /* Get Present value property offset */
        GET_PRESENTVAL_OFFSET(eObjectType,m_stPresentValue,ul32OffsetAddr, i32Len);
    }
    else 
    {
        /* Get Present value property offset */
      GET_PRESENTVAL_OFFSET(eObjectType,m_stPresentValue,ul32OffsetAddr, i32Len);

    }
	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetPresentValOffset : Exit \r\n"); 
	#endif

    return ul32OffsetAddr;
}


/**
*                                                                    
*DESCRIPTION                                                                          
*   It assigns heap memory to void pointer wrt data type & copies data to
*   that memory space.
*    
*@param eData_Type [in] Data type of the value to be copied. 
*@param pvSrcAdd [in] Pointer to the location where the data is to be copied.
*@param pvDstAdd [out] Double pointer to the memory location from where the 
*                      the value is to be copied.
*
*@return BACDEL_MALLOC_ERROR/BACDEL_SUCCESS/BACDEL_ERROR 
*                                                                      
*/
BACNET_RETURN_TYPE Store_Value_On_DataType (BACNET_DATA_TYPE eData_Type,
                                         void *pvSrcAdd, void **pvDstAdd)
{
	/* function entry */
	#ifdef DEBUG_PRINTF
	Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: Store_Value_On_DataType: entry \r\n");
	#endif

    switch(eData_Type)
    {
    case BACNET_DT_REAL:
        {
            Pr_BACnetReal_t *pRealValue;

            pRealValue = OSAL_Malloc(sizeof(Pr_BACnetReal_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pRealValue == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pRealValue, pvSrcAdd, sizeof(Pr_BACnetReal_t));
            *pvDstAdd = pRealValue;
        }
        break;
	case BACNET_DT_DOUBLE:
		{
			Pr_BACnetDouble_t *pDoubleValue;

			pDoubleValue = OSAL_Malloc(sizeof(Pr_BACnetDouble_t),  __FILE__, __FUNCTION__, __LINE__);
			if(pDoubleValue == NULL)
			{
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
				return BACDEL_MALLOC_ERROR;
			}
			memcpy(pDoubleValue, pvSrcAdd, sizeof(Pr_BACnetDouble_t));
			*pvDstAdd = pDoubleValue;
		}
	break;
    case BACNET_DT_BITSTRING:
        {
            Pr_BACnetBitStr_t *pstBitString;

            pstBitString = OSAL_Malloc(sizeof(Pr_BACnetBitStr_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstBitString == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstBitString, pvSrcAdd, sizeof(Pr_BACnetBitStr_t));
            *pvDstAdd = pstBitString;            
        }
        break;
    case BACNET_DT_ENUM:
    case BACNET_DT_ENUM_NEW:
    case BACNET_DT_BACKUPSTATE:
    case BACNET_DT_BACNETSEG:
        {
            Pr_BinaryEnumPV_t *pstEnumValue;
            
            pstEnumValue = OSAL_Malloc(sizeof(Pr_BinaryEnumPV_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstEnumValue == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstEnumValue, pvSrcAdd, sizeof(Pr_BinaryEnumPV_t));
            *pvDstAdd = pstEnumValue;
        }
        break;
    case BACNET_DT_UNSIGNED:
    case BACNET_DT_UNSIGNED32:
        {
            Pr_BACnetUnsigned32_t *pstUnsignedValue;

            pstUnsignedValue = OSAL_Malloc(sizeof(Pr_BACnetUnsigned32_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstUnsignedValue == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstUnsignedValue, pvSrcAdd, sizeof(Pr_BACnetUnsigned32_t));
            *pvDstAdd = pstUnsignedValue;
        }
        break;
    case BACNET_DT_UNSIGNED16:
        {
            Pr_BACnetUnsigned16_t *pstSigned16Value;

            pstSigned16Value = OSAL_Malloc(sizeof(Pr_BACnetUnsigned16_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstSigned16Value == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstSigned16Value, pvSrcAdd, sizeof(Pr_BACnetUnsigned32_t));
            *pvDstAdd = pstSigned16Value;
        }
        break;
	case BACNET_DT_BOOLEAN:
        {
            Pr_BACnetBool_t *boolValue;

            boolValue = OSAL_Malloc(sizeof(Pr_BACnetBool_t),  __FILE__, __FUNCTION__, __LINE__);
            if(boolValue == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(boolValue, pvSrcAdd, sizeof(Pr_BACnetBool_t));
            *pvDstAdd = boolValue;
        }
        break;

    case BACNET_DT_CHARSTRING:
        {
            Pr_BACnetCharStr_t    *pstcharstring = NULL;
            pstcharstring = OSAL_Malloc(sizeof(Pr_BACnetCharStr_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstcharstring == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstcharstring, pvSrcAdd, sizeof(Pr_BACnetCharStr_t));
            *pvDstAdd = pstcharstring;
        }
        break;
    case BACNET_DT_DATETIME:
        {
            Pr_BACnetDateTime_t    *pstDateTime = NULL;
            pstDateTime = OSAL_Malloc(sizeof(Pr_BACnetDateTime_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstDateTime == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstDateTime, pvSrcAdd, sizeof(Pr_BACnetDateTime_t));
            *pvDstAdd = pstDateTime;
        }
        break;
    case BACNET_DT_OBJECTID:
        {
            Pr_BACnetObjId_t    *pstObjectID = NULL;
            pstObjectID = OSAL_Malloc(sizeof(Pr_BACnetObjId_t),  __FILE__, __FUNCTION__, __LINE__);
            if(pstObjectID == NULL)
            {
				#ifdef DEBUG_PRINTF
				Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: Store_Value_On_DataType: malloc error \r\n");
				#endif
                return BACDEL_MALLOC_ERROR;
            }
            memcpy(pstObjectID, pvSrcAdd, sizeof(Pr_BACnetObjId_t));
            *pvDstAdd = pstObjectID;
        }
        break;
    case BACNET_DT_BACNETDEVSTAT:
        {
