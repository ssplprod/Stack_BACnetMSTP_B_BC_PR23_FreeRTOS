        }
        break;

        /* For Object Alarm value property */
        case PROP_ALARM_VALUE:
        {
            /* Update property offset */
            GET_ALARMVALUE_OFFSET(eObjectType,m_stAlarmValue.m_eVal, ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                    sizeof(BACNET_BINARY_PV));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
			/* Other than Add Property time, event state should update */
