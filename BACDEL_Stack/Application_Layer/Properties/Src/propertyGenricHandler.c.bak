/** check if this is proprietary property */
bool IsProprietaryProp(BACNET_OBJECT_TYPE eObjType, BACNET_PROPERTY_ID eDevProp,
        PROP_ACCESS_TYPE *pePropType)
{
    /* local variable */
    bool bRetVal = false;

    /* switch to object type */
    switch(eObjType)
    {

        default:
            break;
    }
    /* return the value */
    return bRetVal;
}

/**
*                                                                         
*DESCRIPTION                                                              
*   This API will return Default Access type of Property given in Stack .
*    
*@param eObjType - Type of Object of which property needs to be Initialize.
*@param eDevProp - Property of object which is to be initialize.
*@param ePermission - Access permission for property.
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/
PROP_ACCESS_TYPE GetDefndPropAccess(BACNET_OBJECT_TYPE eObjType,
                                BACNET_PROPERTY_ID eDevProp,
                                PROP_ACCESS_TYPE ePermission)
{
    /** Function Return value */
    PROP_ACCESS_TYPE ePropType = NOT_SUPPORTED; 
    /** Remap Function returned object id */
    BACNET_REMAPPED_OBJECT_TYPE  eRemapObjType
        = REMAPPED_MAX_BACNET_OBJECT_TYPE;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetDefndPropAccess : Entry \r\n"); 
	#endif

    /** Remap object id as per Default Access type table */
    eRemapObjType = Remap_Objct_Id(eObjType);

    /* Validate Object and Property are in Range */
    if(REMAPPED_MAX_BACNET_OBJECT_TYPE == eRemapObjType || eDevProp > MAX_PROP_SUPPORTED)
    {
        /* check if this is proprietary property */
        if(!IsProprietaryProp(eObjType, eDevProp, &ePropType))
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetDefndPropAccess :"
                "Object Type Not Found\r\n"); 
			#endif
            return NOT_SUPPORTED;
        }
    }
	#ifdef BACDEL_PR14
	else if(PROP_PROPERTY_LIST == eDevProp)
	{
		ePropType = READ_ONLY;
	}
	#endif
    else
    {
        /* Get Defined Access Type for Property */
        ePropType = au8DeviceObject[eDevProp][eRemapObjType];
    }

    /* Property Support is not given in Stack */
    if(ePropType == NOT_SUPPORTED)
    {
		#ifdef DEBUG_PRINTF
        Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetDefndPropAccess :"
            "Property Not Supported\r\n"); 
		#endif
        return NOT_SUPPORTED;
    }

    /* Check permission type for the property */
    switch(ePermission)
    {
        /* If it is read only return value as read only */
        case READ_ONLY:
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL2,"BACnetStackAppLayer:GetDefndPropAccess :"
                "Property is  READ_ONLY\r\n"); 
			#endif
            return READ_ONLY;
        }
        break;

        /* If it is read write return value as read write */
        case READ_WRITE:
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL2,"BACnetStackAppLayer:GetDefndPropAccess :"
                "Property is  READ_WRITE\r\n"); 
			#endif
            return READ_WRITE;
        }
        break;

        /* If Access type is commandable then verify it & return appropraite type */
        case COMMANDABLE_PROP:
        {
			/* switch to type of object */
            switch(eObjType)
            {
                case OBJECT_ANALOG_OUTPUT:
                case OBJECT_ANALOG_VALUE:
                case OBJECT_BINARY_OUTPUT:
                case OBJECT_BINARY_VALUE:
                case OBJECT_MULTI_STATE_OUTPUT:
                case OBJECT_MULTI_STATE_VALUE:
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL2,"BACnetStackAppLayer:GetDefndPropAccess :"
                    "Property is  COMMANDABLE_PROP\r\n"); 
					#endif
                    return COMMANDABLE_PROP;
                }
                break;
                default:
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetDefndPropAccess :"
                        "Property Not Supported\r\n"); 
					#endif
                    return NOT_SUPPORTED;
                }
            }
        }    
        break;
        
        /* return the value obtained from the global access type array */
        case BACNET_DEFAULT:
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL2,"BACnetStackAppLayer:GetDefndPropAccess :"
                "Property %d \r\n", ePropType); 
			#endif
            return ePropType;
        }        
        break;

        default :
        {
			#ifdef DEBUG_PRINTF
        	Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetDefndPropAccess :"
        	            "Property Not Supported\r\n");
			#endif

        	/* Property is not supported by device */
        	//return ePropType;
        }
    }//end of switch

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetDefndPropAccess : Exit \r\n"); 
	#endif

    return ePropType;
}

#ifdef OPTIONAL_PROPERTY
/**
*                                                                         
*DESCRIPTION                                                              
*   This API will Update state text property with multiple strings
*   And also it updates the number of states of an object .
*    
*@param eObjectType         [in] type of Object.
*@param ePropId             [in] property id.
*@param pvObject            [in] object base address.
*@param pvData              [in] data to be written to property value.
*@param bInitFunctionality  [in] indicates : call for init property or call from WP/WPM.
*@param i32ArrayIndex       [in] array index of property.
*@param bRecurssive         [out] if returned true update dependent property
*
*@return void [out] no return value.
*
*/
static void UpdateCharStringArrayProperty(
            BACNET_OBJECT_TYPE eObjectType, BACNET_PROPERTY_ID ePropId, 
            void *pvObject, void *pvData, 
            bool bInitFunctionality, int32_t i32ArrayIndex,
            bool *bRecurssive)
{
    /* local variables */
    ulong32_t ul32BaseAddr = 0;     /* holds object base address */
    ulong32_t ul32StrgOfstAdr = 0;   /* property offset address */
    ulong32_t ul32NoStateOfstAdr = 0;    /* count offset address */
    ListOfCharStr_t *pstStringVal = NULL ;  /* list of char string values */
    Pr_ListOfCharStr_t  *pstCharStrArr = NULL;    /* property struct */
    BACNET_PROPERTY_VALUE *pstAppDataValue = NULL;  /* input value */
    void *pvTemp = NULL;    /* input value to write */
    int32_t i32Count = 0;   /* temp count */
    int32_t i32TextCount = 0; /* final text count after WP/WPM. */
    int32_t i32NoOfTexts = 0; /* to save count for no of array members in property */

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: \
    UpdateCharStringArrayProperty : entry \r\n"); 
	#endif

    /* null check input pointers */
    if(NULL == pvObject /*|| NULL == pvData*/)
        return;

    /* reset recurssion flag */
    *bRecurssive = FALSE;

    /* get object base address */
    ul32BaseAddr = (ulong32_t)pvObject;

    /* get the property base address */
    switch(ePropId)
    {
#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSO || defined BACDEL_OBJ_MSV)
    case PROP_STATE_TEXT:
        /* get offset address for property */
        GET_MULTISTATE_PROP_OFFSET(eObjectType, m_stStateText, ul32StrgOfstAdr);
        /* get number of states property value */
        GET_MULTISTATE_PROP_OFFSET(eObjectType, m_stNumberOfStates.m_u32Val, ul32NoStateOfstAdr);
        break;
#endif
    default:
        /* unsupported property id */
		#ifdef DEBUG_PRINTF
        Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer: \
        UpdateCharStringArrayProperty : propetry not supported. \r\n"); 
		#endif
        return;
    }//switch ends

    /* convert to property val struct */
    pstCharStrArr = (Pr_ListOfCharStr_t *)(ul32BaseAddr + ul32StrgOfstAdr);
    pstStringVal = &pstCharStrArr->m_stStringVal;
    /* get count value i.e. no of current state value */
	/* get count value i.e. no of nodes */
    if(!bInitFunctionality || PROP_STATE_TEXT == ePropId)
        i32NoOfTexts = *((uint32_t *)(ul32BaseAddr + ul32NoStateOfstAdr));

    /* call from init functionality */
    if(bInitFunctionality)
    {
        /* locals */
        char *pi8CharPtr = NULL;
        char *pi8InStr = NULL;
        uint32_t u32Len = 0;
        ListOfCharStr_t *pstTemp = NULL;

        /* get pointer of input string */
        pi8InStr = (char *)pvData;

        /* clear all previous values */
        Clear_CharString_List(&pstStringVal->m_pstNext);
        
        /* loop till the end of number of states */   
        for(i32Count = 0; i32Count < i32NoOfTexts; i32Count++)
        {
            /* check if 1 string to get */
            if(0 == i32Count)
                /* get 1st string with the pointer */
                pi8CharPtr = strtok(pi8InStr, ",");
            else
                /* successive strings get using NULL */
                pi8CharPtr = strtok(NULL,",");
                
            /* if number of strings less then number of states or any other error,
               break the loop to avoid crash */
            if(pi8CharPtr == NULL)
                break;

            /* get the string length */
            u32Len = Strnlen(pi8CharPtr, MAX_CHARACTER_STRING_BYTES);

            if(0 == i32Count)
			{
                /* copy string */
				memcpy(pstStringVal->m_stCharStr.m_pu8CharStr, pi8CharPtr, u32Len);
				/* copy string length */
				pstStringVal->m_stCharStr.m_u32StrLen = u32Len;
			}
            else
            {
                /* allocate space */
                pstTemp = OSAL_Malloc(sizeof(ListOfCharStr_t),__FILE__,__FUNCTION__, __LINE__);
                if(NULL == pstTemp)
                    break;
			    pstTemp->m_pstNext = NULL;

                /* copy Data */
				memcpy(pstTemp->m_stCharStr.m_pu8CharStr, pi8CharPtr, u32Len);
				/* copy string length */
				pstTemp->m_stCharStr.m_u32StrLen = u32Len;
               
                /* add at the end of list */ 
                while(pstStringVal->m_pstNext != NULL)
                    pstStringVal = pstStringVal->m_pstNext;
                pstStringVal->m_pstNext = pstTemp;
            }
            /* increment text count */
            i32TextCount++;
        }// for loop ends.
    }//if(bInitFunctionality) ends.

    /* call from WP/WPM to resize array */
    else if(0 == i32ArrayIndex)
    {
        /* locals */
        int32_t i32NewNoOfTexts = 0;
        /* get new array size */
        i32NewNoOfTexts = *((uint32_t *)pvData);
        /* set recurssion flag */
        *bRecurssive = TRUE;

        /* free extra nodes */
        if(i32NoOfTexts > i32NewNoOfTexts)
        {
            /* save as previous node */
            pvTemp = pstStringVal;
            /* traverse till u32NewNoOfTexts is zero */
            while(0 != i32NewNoOfTexts && NULL != pstStringVal)
            {
                /* save as previous node */
                pvTemp = pstStringVal;
                /* move to next */
                pstStringVal = pstStringVal->m_pstNext;
                /* decrement count */
                i32NewNoOfTexts--;
                /* increment text count */
                i32TextCount++;
            }
            /* get previous node */
            pstStringVal = pvTemp;

            /* send remaining list for clearing */
            Clear_CharString_List(&pstStringVal->m_pstNext);
        }
        /* add more nodes */
        else if(i32NoOfTexts < i32NewNoOfTexts)
        {
            /* traverse till end */
            while(NULL != pstStringVal)
            {
                /* save as previous node */
                pvTemp = pstStringVal;
                /* move to next */
                pstStringVal = pstStringVal->m_pstNext;
                /* decrement count */
                i32NewNoOfTexts--;
                /* increment text count */
                i32TextCount++;
            }
            /* get the previous node */
            pstStringVal = pvTemp;
            /* add new nodes */
            for(; i32NewNoOfTexts > 0; i32NewNoOfTexts--)
            {
                /* allocate memory */
                pstStringVal->m_pstNext =  OSAL_Malloc(sizeof(ListOfCharStr_t),
                    __FILE__, __FUNCTION__, __LINE__);
                if(NULL == pstStringVal->m_pstNext)
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: \
                    UpdateCharStringArrayProperty: malloc failed. \r\n");
					#endif
                    break;
                }
                /* move to new node */
                pstStringVal = pstStringVal->m_pstNext;
                pstStringVal->m_pstNext = NULL;
                /* increment text count */
                i32TextCount++;
            }
        }
        else
        {
            /* reset recurssion flag */
            *bRecurssive = FALSE;
            /* maintain count */
            i32TextCount = i32NoOfTexts;
        }
    }//(0 == i32ArrayIndex) ends.

    /* call from WP/WPM to re-write total array */
    else if( (int32_t)BACNET_ARRAY_ALL == i32ArrayIndex)
    {
        /* get the pointer of received values */
        pstAppDataValue = pvData;
		/* save as previous */
		pvTemp = pstStringVal;

        /* traverse list & update values */
        while(NULL != pstStringVal && NULL != pstAppDataValue)
        {
            /* clear previous data */
			memset(pstStringVal->m_stCharStr.m_pu8CharStr, 0x00, sizeof(pstStringVal->m_stCharStr.m_pu8CharStr));
            /* copy new string value */
			memcpy(pstStringVal->m_stCharStr.m_pu8CharStr,
                pstAppDataValue->uValue.m_stCharacter_String.m_pu8CharStr,
                pstAppDataValue->uValue.m_stCharacter_String.m_u32StrLen);
			/* save string length */
			pstStringVal->m_stCharStr.m_u32StrLen = pstAppDataValue->uValue.m_stCharacter_String.m_u32StrLen;

            /* save as previous */
            pvTemp = pstStringVal;
            /* move to next node */
            pstStringVal = pstStringVal->m_pstNext;
            /* move to next input value */
            pstAppDataValue = pstAppDataValue->pstNextPropVal;
            /* increment no of texts count */
            i32TextCount++;
        }

        /* if reached end of input values list, remove remaining nodes in property list */
        if(NULL == pstAppDataValue)
        {
            /* get previous node */
            pstStringVal = pvTemp;

            /* send remaining list for clearing */
            Clear_CharString_List(&pstStringVal->m_pstNext);
        }
        /* if received data is not ended, add more nodes to property list */
        else if(NULL == pstStringVal)
        {
            /* get previous node */
            pstStringVal = pvTemp;
            /* add new nodes */
            while(NULL != pstAppDataValue)
            {
                /* allocate memory */
                pstStringVal->m_pstNext = OSAL_Malloc(sizeof(ListOfCharStr_t),
                    __FILE__, __FUNCTION__, __LINE__);
                if(NULL == pstStringVal->m_pstNext)
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: \
                    UpdateCharStringArrayProperty: malloc failed. \r\n");
					#endif
                    break;
                }
                /* move to new node */
                pstStringVal = pstStringVal->m_pstNext;
                /* copy string value */
				memcpy(pstStringVal->m_stCharStr.m_pu8CharStr,
                    pstAppDataValue->uValue.m_stCharacter_String.m_pu8CharStr,
                    pstAppDataValue->uValue.m_stCharacter_String.m_u32StrLen);
				/* save string length */
				pstStringVal->m_stCharStr.m_u32StrLen = pstAppDataValue->uValue.m_stCharacter_String.m_u32StrLen;
                /* move to next input value */
                pstAppDataValue = pstAppDataValue->pstNextPropVal;
                /* increment no of texts count */
                i32TextCount++;
            }
        }
        /* set recirssion flag */
        *bRecurssive = TRUE;
    }//(BACNET_ARRAY_ALL == i32ArrayIndex) ends.

    /* call from WP/WPM to write @ given array index */
    else
    {
        uint32_t u32Index = 0;
        /* get the data */
        pstAppDataValue = pvData;
        u32Index = i32ArrayIndex - 1;
		if(NULL != pstStringVal)
        {
			/* add at end of the list */
			while(NULL != pstStringVal->m_pstNext && u32Index--)
				/* move t next */
				pstStringVal = pstStringVal->m_pstNext;
		}
        if(NULL != pstStringVal)
        {
            /* clear previous data */
			memset(pstStringVal->m_stCharStr.m_pu8CharStr, 0, sizeof(pstStringVal->m_stCharStr.m_pu8CharStr));
            /* copy new string value */
			memcpy(pstStringVal->m_stCharStr.m_pu8CharStr,
                pstAppDataValue->uValue.m_stCharacter_String.m_pu8CharStr,
                pstAppDataValue->uValue.m_stCharacter_String.m_u32StrLen);
			/* save string length */
			pstStringVal->m_stCharStr.m_u32StrLen = pstAppDataValue->uValue.m_stCharacter_String.m_u32StrLen;
        }
        /* maintain the count value */
        i32TextCount = pstCharStrArr->m_u32Count;
    }

    /* update no of texts count added to array / list */
    pstCharStrArr->m_u32Count = i32TextCount;

    /* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: \
    UpdateCharStringArrayProperty : exit \r\n");
	#endif
    return;
}
#endif /* OPTIONAL_PROPERTY */

/***
*
* DESCRIPTION
*   This API will Update Alarm Values property with depending on object type
*   & nature of function call.
*
* @param eObjectType [in] Type of Object of which property needs to be Initialize.
* @param pvObject [in] Object base address.
* @param pvData [in] Input data to be updated.
* @param i32ArrayIndex [in] Array index to write value.
* @param ul32OffsetAddr [in] offset address of m_stAlarmValues.
* @param pvPropAdd [in/out] Double pointer.
*
* @return void [out] no return value.
*
*/
static void UpdateAlarmValues(BACNET_OBJECT_TYPE eObjectType,
                    void *pvObject, void *pvData, void **pvPropAdd,
                        int32_t i32ArrayIndex, ulong32_t ul32OffsetAddr,
                            bool bInitFunctionality,
							bool bWriteNULL)
{
    /* local varaibles */
    ulong32_t ul32BaseAddr = 0;

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: "
    "UpdateAlarmValues : Entry \r\n");
	#endif

    /* validate input pointers */
    if(NULL == pvObject || NULL == pvPropAdd)
        return;

    /* get object base address */
    ul32BaseAddr = (ulong32_t)pvObject;

    switch(eObjectType)
    {
        case OBJECT_MULTI_STATE_INPUT:
        case OBJECT_MULTI_STATE_VALUE:
        {
            /* local varaibles */
            Pr_ListOfUnsigned_t *pstAlarmValues = NULL;
            ListOfUnsigned_t *pstIntList = NULL;

            /* get the pointers for list */
            pstAlarmValues = (void *)(ul32BaseAddr + ul32OffsetAddr);
            *pvPropAdd = pstAlarmValues->m_pstUnsignVal;

            /* add list call, this is new list of values */
            if(NULL == pstAlarmValues->m_pstUnsignVal)
                pstAlarmValues->m_pstUnsignVal = pvData;
            /* remove list call, just visit update common Prop, to bypass all other functionality */
            else if (*pvPropAdd == pvData)
            {
            	;/* do nothing */
            }
            else
            {
                /* loop till end of the link list & attach */
                /* Note: Assuming that index validation is done properly */
                pstIntList = pstAlarmValues->m_pstUnsignVal;
                /* Add at End of the list */
                while(NULL != pstIntList->m_pstNext)
                    pstIntList = pstIntList->m_pstNext;
                /* attach here */
                pstIntList->m_pstNext = pvData;
            }
        }break;

        /* default case - do nothing */
        default:
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer: "
            "UpdateAlarmValues : Unsupported object type for Alarm Values. \r\n");
			#endif
            break;
    }

    /* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: "
    "UpdateAlarmValues : Exit \r\n");
	#endif
    return;
}

