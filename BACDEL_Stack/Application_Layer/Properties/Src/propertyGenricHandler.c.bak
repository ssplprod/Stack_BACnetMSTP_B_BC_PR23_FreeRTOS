        }
        break;

        /* Alarm values */
        case PROP_ALARM_VALUES:
        {
            /* Update property offset */
            GET_ALARM_VALUES_OFFSET(eObjectType, m_stAlarmValues, ul32OffsetAddr);

            /* update the property value */
            UpdateAlarmValues(eObjectType, pvObject, pvData, pvPropAdd, 
                i32ArrayIndex, ul32OffsetAddr, bInitFunctionality, bWriteNULL);

			/* Other than Add Property time, event state should update */
