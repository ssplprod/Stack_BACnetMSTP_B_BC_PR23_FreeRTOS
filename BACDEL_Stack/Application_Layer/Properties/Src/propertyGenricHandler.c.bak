        case PROP_FEEDBACK_VALUE:
        {
            /* Update property offset */
            GET_FEEDBACKVAL_OFFSET(eObjectType,m_stFeedbackValue , ul32OffsetAddr);
            
            /* Fill Offset with the input data */ 
            UpdateObjectValue(eObjectType, (ul32OffsetAddr+ul32BaseAddr), pvData);

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
			/* Other than Add Property time, event state should update */
