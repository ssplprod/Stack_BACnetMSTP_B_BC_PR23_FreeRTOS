/**
*
*DESCRIPTION
*   Api allows write access to log interval property of 
*	TL/TLM object depending upon value of logging type 
*	property.
*
*@param pvObjBaseAddr [in] Base address of the object.
*@param eObjectType [in] Object Type
*@param pvVirtualDev [in] virtual device instance.
*
*@returns - true if logging type is triggered.
*
*/
bool IsLoggingTriggered(void *pvObjBaseAddr, BACNET_OBJECT_TYPE eObjectType,
				void *pvVirtualDev)
{
    /* local variables */
    bool bReturnVal = false;

    /* function entry */
	#ifdef DEBUG_PRINTF
	Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: IsLoggingTriggered: Entry \r\n");
	#endif

    /* check input pointers */
	if(NULL == pvObjBaseAddr || NULL == pvVirtualDev)
		return bReturnVal;

    /* check as per object type */
    switch(eObjectType)
    {
    /* default case - do nothing */
    default:
        break;
    }

    /* function exit */
	#ifdef DEBUG_PRINTF
	Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: IsLoggingTriggered: Exit \r\n");
	#endif
	return bReturnVal;
}

/**
*
*DESCRIPTION
*   Api returns true if object is TL/TLM/EL
*
*@param eObjectType [in] Object Type
*@returns - true if yes else false.
*
*/
bool IsLoggingObject(BACNET_OBJECT_TYPE eObjType)
{
    /* local variables */
    bool bReturnVal = false;

    /* function entry */
	#ifdef DEBUG_PRINTF
	Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: IsLoggingObject: Entry \r\n");
    #endif

    /* check object type */
    if(OBJECT_TRENDLOG == eObjType || OBJECT_TREND_LOG_MULTIPLE == eObjType ||
        OBJECT_EVENT_LOG == eObjType)
    {
        /* return true */
        bReturnVal = true;
    }

    /* function exit */
	#ifdef DEBUG_PRINTF
	Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: IsLoggingObject: Exit \r\n");
    #endif
	return bReturnVal; 
} 
//#endif /* BACDEL_OBJ_TL */

/**
*
* DESCRIPTION
* Function to revers bitstring value as per data type.
*
* @param pvPropVal	[in] pointer to property value to be copied.
* @param eDataType	[in] data type of property.
*
* @return void		[out] no return value.
*
*/
void Reverse_BitString_DataType_Value(BACNET_DATA_TYPE eDataType, void *pvPropVal)
{
	/* local variable */
	uint8_t u8Count = 0;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: \
    Reverse_BitString_DataType_Value : Entry \r\n");
	#endif

	/* null check for input parameters */
	if(NULL == pvPropVal)
	{
		#ifdef DEBUG_PRINTF
	    Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: \
        Reverse_BitString_DataType_Value: NUll input pointers \r\n");
		#endif
	    return;
	}

	/* switch as per data type */
	switch(eDataType)
	{
	case BACNET_DT_BITSTRING:
	{
		/* local variables */
		Pr_BACnetBitStr_t *pstBitstr = NULL;

		/* typecast the pointer */
		pstBitstr = (Pr_BACnetBitStr_t *)pvPropVal;
		for(u8Count = 0; u8Count < MIN_BITSTRING_BYTES; u8Count++)
		{
			/* reverse bits in byte */
			pstBitstr->m_stBitStr.m_u8TransBits[u8Count] =
				Byte_Reverse_Bits(pstBitstr->m_stBitStr.m_u8TransBits[u8Count]);
		}
	}
	break;

	case BACNET_DT_BITSTRING_NEW:
	{
		/* local variables */
		Pr_BACnetBITStr_t *pstNewBitStr = NULL;

		/* typecast the pointer */
		pstNewBitStr = (Pr_BACnetBITStr_t *)pvPropVal;
		for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
		{
			/* reverse bits in byte */
			pstNewBitStr->m_stBitString.m_u8TransBits[u8Count] =
				Byte_Reverse_Bits(pstNewBitStr->m_stBitString.m_u8TransBits[u8Count]);
		}
	}
	break;

	case BACNET_DT_BITSTRING_ARRAY:
	{
		/* local variables */
		Pr_ListOfBitStr_t *pstStrList = NULL;
		ListOfBitStr_t * pstBitStrList = NULL;

		/* typecast the pointer */
		pstStrList = (Pr_ListOfBitStr_t *)pvPropVal;
		pstBitStrList = pstStrList->m_pstBitString;

		while(NULL != pstBitStrList)
		{
			for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
			{
				/* reverse bits in byte */
				pstBitStrList->m_stBitString.m_u8TransBits[u8Count] =
					Byte_Reverse_Bits(pstBitStrList->m_stBitString.m_u8TransBits[u8Count]);
			}

			/* move to next node */
			pstBitStrList = pstBitStrList->m_pstNext;
		}
	}
	break;

	case BACNET_DT_DESTINATION_LIST:
	{
		/* local variables */
		Pr_ListOfBACnetDestination_t *pstRecipList = NULL;
		ListOfBACnetDestination_t *pstRecipient = NULL;

		/* typecast the pointer */
		pstRecipList = (Pr_ListOfBACnetDestination_t *)pvPropVal;
		pstRecipient = pstRecipList->m_pstNCRecepient;

		while(NULL != pstRecipient)
		{
			/* reverse valid day of week bits */
			pstRecipient->m_stDaysOfWeek.m_u8TransBits[u8Count] =
				Byte_Reverse_Bits(pstRecipient->m_stDaysOfWeek.m_u8TransBits[u8Count]);

			/* reverse event transitions bits */
			pstRecipient->m_stTransitions.m_u8TransBits[u8Count] =
				Byte_Reverse_Bits(pstRecipient->m_stTransitions.m_u8TransBits[u8Count]);

			/* move to next node */
			pstRecipient = pstRecipient->m_pstNext;
		}
	}
	break;

	case BACNET_DT_EVENTPARAMETERS:
	{
		/* local variables */
		Pr_BACnetEventParameter_t *pstEveParam = NULL;

		/* typecast the pointer */
		pstEveParam = (Pr_BACnetEventParameter_t *)pvPropVal;

		switch(pstEveParam->m_stEventParam.m_eEventType)
		{
		case EVENT_CHANGE_OF_BITSTRING:
		{
			/* local variables */
			ListOfBitStr_t  *pstBitStrList = NULL;

			for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
			{
				/* reverse bit mask value */
				pstEveParam->m_stEventParam.BACnetEventParameter_u.m_stCngBitstring.
					m_stBitmask.m_stBitString.m_u8TransBits[u8Count] = 
					Byte_Reverse_Bits(pstEveParam->m_stEventParam.BACnetEventParameter_u.
					m_stCngBitstring.m_stBitmask.m_stBitString.m_u8TransBits[u8Count]);
			}

			/* reverse list-of-bitstring-values */
			pstBitStrList = pstEveParam->m_stEventParam.BACnetEventParameter_u.
				m_stCngBitstring.m_pstBitStrList;
			while(NULL != pstBitStrList)
			{
				for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
				{
					/* reverse bits in byte */
					pstBitStrList->m_stBitString.m_u8TransBits[u8Count] = 
						Byte_Reverse_Bits(pstBitStrList->m_stBitString.m_u8TransBits[u8Count]);
				}

				/* move to next node */
				pstBitStrList = pstBitStrList->m_pstNext;
			}
		}
		break;

		case EVENT_CHANGE_OF_VALUE:
		{
			/* reverse  bit mask value */
			if(!pstEveParam->m_stEventParam.BACnetEventParameter_u.m_stCngValue.
				m_i8CriteriaType)
			{
				for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
				{
					/* reverse bits in byte */
					pstEveParam->m_stEventParam.BACnetEventParameter_u.m_stCngValue.
						m_stCovCriteria.m_stBitmask.m_stBitString.m_u8TransBits[u8Count] = 
						Byte_Reverse_Bits(pstEveParam->m_stEventParam.BACnetEventParameter_u.
						m_stCngValue.m_stCovCriteria.m_stBitmask.m_stBitString.m_u8TransBits[u8Count]);
				}
			}
		}
		break;

		case EVENT_COMMAND_FAILURE:
		{
			/* check tag */
			if(BACNET_APPLICATION_TAG_BIT_STRING == pstEveParam->m_stEventParam.
				BACnetEventParameter_u.m_stCmdFail.m_u8Apptag)
			{
				/* reverse property bit string value */
				for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
				{
					/* reverse bits in byte */
					pstEveParam->m_stEventParam.BACnetEventParameter_u.m_stCmdFail.
						m_uFeedbackPropValue.stBitStringVal.m_u8TransBits[u8Count] = 
						Byte_Reverse_Bits(pstEveParam->m_stEventParam.BACnetEventParameter_u.
						m_stCmdFail.m_uFeedbackPropValue.stBitStringVal.m_u8TransBits[u8Count]);
				}
			}
		}
		break;

		case EVENT_EXTENDED:
		{
			/* local variable */
			Parameters_t *pstExtendedparam = NULL;

			/* Get pointer value */
			pstExtendedparam = pstEveParam->m_stEventParam.BACnetEventParameter_u.
				m_stExtended.m_pstParameters;

			while(NULL != pstExtendedparam)
			{
				/* check tag */
				if(BACNET_APPLICATION_TAG_BIT_STRING == pstExtendedparam->m_u8ParameterType)
				{
					/* reverse parameter bitstring value */
					for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
					{
						/* reverse bits in byte */
						pstExtendedparam->m_stParameters.stBitStringVal.m_u8TransBits[u8Count] = 
							Byte_Reverse_Bits(pstExtendedparam->m_stParameters.stBitStringVal.
							m_u8TransBits[u8Count]);
					}
				}

				/* move to next node */
				pstExtendedparam = pstExtendedparam->m_pstNext;
			}
		}
		break;

		case EVENT_CHANGE_OF_STATUS_FLAGS:
		{
			/* reverse selected-flags bit value */
			for(u8Count = 0; u8Count < MIN_BITSTRING_BYTES; u8Count++)
			{
				/* reverse bits in byte */
				pstEveParam->m_stEventParam.BACnetEventParameter_u.m_stCngStatusFlag.
					m_stStatusFlag.m_u8TransBits[u8Count] = 
					Byte_Reverse_Bits(pstEveParam->m_stEventParam.BACnetEventParameter_u.
					m_stCngStatusFlag.m_stStatusFlag.m_u8TransBits[u8Count]);
			}
		}
		break;

		default:
		{
			; //do nathing
		}
		break;
		}// Event Parameter switch End	
	}
	break;

	case BACNET_DT_LOGBUFFER_TRENDLOG:
	{
		/* local variable */
		Pr_ListOfBACnetLogRecord_t *pstBACnetLogRecord = NULL;
		ListOfBACnetLogRecord_t *pstLogRecordList = NULL;

		/* get pointer value */
		pstBACnetLogRecord = (Pr_ListOfBACnetLogRecord_t *)pvPropVal;
		pstLogRecordList = pstBACnetLogRecord->m_pstLogRecord;

		while(NULL != pstLogRecordList)
		{
			/* reverse bits in byte */
			pstLogRecordList->m_stListofLogRecord.m_stStatusFlag.m_u8TransBits[u8Count] = 
				Byte_Reverse_Bits(pstLogRecordList->m_stListofLogRecord.m_stStatusFlag.
				m_u8TransBits[u8Count]);

			// TODO - handle log status value
			/* move to next node */
			pstLogRecordList = pstLogRecordList->m_pstNext;
		}
	}
	break;

	case BACNET_DT_DAILYSCHEDULE_ARRAY:
	{
		/* local variable */
		uint8_t u8CountVal = 0;
		Pr_ListOfBACnetDailySchedule_t *pstWeeklySchedule = NULL;
		BACnetTimeValue_t *pstListOfTimeValues = NULL;

		/* get pointer value */
		pstWeeklySchedule = (Pr_ListOfBACnetDailySchedule_t *)pvPropVal;

		for(u8CountVal = 0; u8CountVal < BACNET_ARRAY_OF_SEVEN; u8CountVal++)
		{
			/* get the pointer */
			pstListOfTimeValues = &pstWeeklySchedule->m_stTimeValue[u8CountVal];

			while(NULL != pstListOfTimeValues)
			{
				if(BACNET_APPLICATION_TAG_BIT_STRING == 
					pstListOfTimeValues->m_stPropValue.m_TagType)
				{
					/* reverse status flag value */
					for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
					{
						/* reverse bits in byte */
						pstListOfTimeValues->m_stPropValue.uValue.m_stBit_String.
							m_u8TransBits[u8Count] = Byte_Reverse_Bits(
							pstListOfTimeValues->m_stPropValue.uValue.m_stBit_String.
							m_u8TransBits[u8Count]);
					}
				}

				/* move to next time value */
				pstListOfTimeValues = pstListOfTimeValues->m_pstNext;
			}
		}
	}
	break;

	case BACNET_DT_SPECIALEVENT_ARRAY:
	{
		/* local variable */
		Pr_ListOfBACnetSpecialEvent_t *pstBACnetListOfSpecialEvent = NULL;
		ListOfSpecialEvent_t *pstListOfSpecialEvent = NULL;
		BACnetTimeValue_t *pstListOfTimeValues = NULL;

		/* get pointer value */
		pstBACnetListOfSpecialEvent = (Pr_ListOfBACnetSpecialEvent_t *)pvPropVal;
		pstListOfSpecialEvent = pstBACnetListOfSpecialEvent->m_pstSplEvent;

		while(NULL != pstListOfSpecialEvent)
		{
			/* get the pointer */
			pstListOfTimeValues = &pstListOfSpecialEvent->m_stListSpecialEvent.
				m_stListOfTimeValues;

			while(NULL != pstListOfTimeValues)
			{
				if(BACNET_APPLICATION_TAG_BIT_STRING == 
					pstListOfTimeValues->m_stPropValue.m_TagType)
				{
					/* reverse status flag value */
					for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
					{
						/* reverse bits in byte */
						pstListOfTimeValues->m_stPropValue.uValue.m_stBit_String.
							m_u8TransBits[u8Count] = Byte_Reverse_Bits(
							pstListOfTimeValues->m_stPropValue.uValue.m_stBit_String.
							m_u8TransBits[u8Count]);
					}
				}

				/* move to next node */
				pstListOfTimeValues = pstListOfTimeValues->m_pstNext;
			}
			/* move to next node */
			pstListOfSpecialEvent = pstListOfSpecialEvent->m_pstNext;
		}
	}
	break;

	case BACNET_DT_SCHEDULE_PRESENT_DEFAULT:
	{
		/* local variables */
		AnyValue_t *pstAny = NULL;

		/* typecast the pointer */
		pstAny = (AnyValue_t *)pvPropVal;

		if(BACNET_APPLICATION_TAG_BIT_STRING == pstAny->m_stValue.m_TagType)
		{
			/* reverse property value bit string value */
			for(u8Count = 0; u8Count < MAX_BITSTRING_BYTES; u8Count++)
			{
				/* reverse bits in byte */
				pstAny->m_stValue.uValue.m_stBit_String.m_u8TransBits[u8Count] =
					Byte_Reverse_Bits(pstAny->m_stValue.uValue.m_stBit_String.
					m_u8TransBits[u8Count]);
			}
		}
	}
	break;

	// TODO - handle other datatypes if required 
	default:
	{
		; //do nathing
	}
	break;
	} //switch End

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: \
    Reverse_BitString_DataType_Value : Exit \r\n");
	#endif
	return;
}

 
#ifdef BACDEL_PR14

/**
*
* DESCRIPTION
* Function to get skip property count of property List property.
*   
* @param pstPropertyList  [in] property list property pointer 
* @return [out] count of skip properties.
*
*/
uint8_t Get_PropertyList_SkipCount(special_property_list_t *pstPropertyList)
{
	/* local variable */
	uint8_t u8SkipPropCnt = 0;
	int32_t *psti32PropPtr = 0;

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: \
	Get_PropertyList_SkipCount: Entry \r\n");
	#endif

	/* check null pointer */
	if(NULL == pstPropertyList)
	{
		/* invalid inputs pointer */
		#ifdef DEBUG_PRINTF
        Print_DebugMsg(DEBUG_LEVEL1, "BACnetStackAppLayer: \
        Get_PropertyList_SkipCount: Null input pointers. \r\n");
		#endif
		return 0;
	}

	/* get required property pointer */
	psti32PropPtr = pstPropertyList->Required.pList;
	/* check properties */
	while(ENDOFPROPLIST != *psti32PropPtr)
	{
		/* skip encoding below 4 properties */
		if(PROP_OBJECT_NAME == *psti32PropPtr || 
			PROP_OBJECT_TYPE == *psti32PropPtr ||
			PROP_OBJECT_IDENTIFIER == *psti32PropPtr ||
			PROP_PROPERTY_LIST == *psti32PropPtr)
		{
			/* increment skip property count value */
			u8SkipPropCnt++;
		}

		/* move to next pointer value */
		psti32PropPtr++;
	}

	/* get required property pointer */
	psti32PropPtr = pstPropertyList->Optional.pList;
	/* check properties */
	while(ENDOFPROPLIST != *psti32PropPtr)
	{
		/* skip below properties */
		if(PROP_PROPERTY_LIST == *psti32PropPtr)
		{
			/* increment skip property count value */
			u8SkipPropCnt++;
		}

		/* move to next pointer value */
		psti32PropPtr++;
	}

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: \
	Get_PropertyList_SkipCount: Exit \r\n");
	#endif
	/* return skip property count value */
	return u8SkipPropCnt;
}
#endif /* PR14 */


#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B)

/**
*
* DESCRIPTION
* Function get time delay value based on event state.
*
* @param eObjectType	[in] Object Type
* @param pvObject		[in] Object base address
* @param eEventStateTo	[in] event state.
* @param u32TimeDelay	[in] Time delay value pointer.
*
* @return [out] nothing.
*
*/
void Get_TimeDelay_value(
	BACNET_OBJECT_TYPE eObjectType,
	void *pvObject,
	BACNET_EVENT_STATE eEventStateTo,
	uint32_t *pu32TimeDelay)
{
	/* local variable */
	ulong32_t ul32BaseAddr = 0;
    ulong32_t ul32OffsetAddr = 0;
	uint32_t u32TimeDelay = 0;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: "
    "Get_TimeDelay_value : Entry \r\n");
	#endif

	/* check input pointer */
	if(NULL == pvObject || NULL == pu32TimeDelay)
	{
		/* invalid inputs pointer */
		#ifdef DEBUG_PRINTF
		Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: "
		"Get_TimeDelay_value: Null input pointers \r\n");
		#endif
		return;
	}

	/* get the object base address */
    ul32BaseAddr = (ulong32_t )pvObject;
	/* set default value */
	*pu32TimeDelay = 0;

	{
		/* get offset of time delay property */
	    GET_TIME_DELAY_OFFSET(eObjectType, m_stTimeDelay.m_u32Val, ul32OffsetAddr);
	}

	/* copy value from offset address */
	if(BACNET_NEGATIVE_ONE != ((int32_t)ul32OffsetAddr))
	{
		/* copy value */
		memcpy((uint32_t *)&u32TimeDelay, (uint32_t *)(ul32BaseAddr+ul32OffsetAddr), sizeof(uint32_t));
	}
	/* save time delay value */
	*pu32TimeDelay = u32TimeDelay;

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer: "
    "Get_TimeDelay_value : Exit \r\n");
	#endif
}
#endif /* INTRINSIC_REPORTING &&  BACDEL_SER_AE_EN_B */



/**
*                                                                         
*DESCRIPTION                                                              
*   This API returns the property access Type Assigned by User while Adding Property.
*   - this function can also be used to change the access type.
*   - it also returns the offset address of 1st member (i.e m_eAccessType) 
*       of property structure.
*    
*@param eObjectType         [in]    Type of Object of which property needs to be Initialize.
*@param eDevProp            [in]    Property of object which is to be initialize.
*@param pvObjectPrt         [in]    Pointer to Object/device containing base address
*@param eAccessType         [in]    input access type to be written.
*@param bReadOrWrite        [in]    write if true else read.
*@param pul32PropOffstAddr  [out]   return offset 
*
*@return NOT_SUPPORTED/READ_ONLY/READ_WRITE/BACNET_DEFAULT/COMMANDABLE_PROP    
*/  

PROP_ACCESS_TYPE GetAsignPropAccess_offset(BACNET_OBJECT_TYPE eObjectType,
                                BACNET_PROPERTY_ID eDevProp,
                                void *pvObjectPrt, PROP_ACCESS_TYPE eAccessType,
                                bool bReadOrWrite,
                                ulong32_t *pul32PropOffstAddr)
{
    /* locals */
    ulong32_t ul32BaseAddr = 0; /* For Object base address */
    ulong32_t ul32OffsetAddr = 0 ;  /* For Data offset Addr */
    /** Function Return value */
    PROP_ACCESS_TYPE ePropType = NOT_SUPPORTED; 

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetAsignPropAccess : Entry \r\n"); 
	#endif

    if(NULL == pvObjectPrt)
        return ePropType;

    /* Get object base address */
    ul32BaseAddr = (ulong32_t)pvObjectPrt;
     
    if(eObjectType == OBJECT_DEVICE)
    {
        switch(eDevProp)
        {
            case PROP_OBJECT_IDENTIFIER:
            {
                 GET_DEVPROP_OFFSET(m_stObjectID, ul32OffsetAddr);
            }
            break;
            case PROP_OBJECT_NAME:
            {
                 GET_DEVPROP_OFFSET(m_stObjName, ul32OffsetAddr);    
            }
            break;
            case PROP_OBJECT_TYPE:
            {
                 GET_DEVPROP_OFFSET(m_stObjectType, ul32OffsetAddr);    
            }
            break;
            case PROP_SYSTEM_STATUS:
            {
                 GET_DEVPROP_OFFSET(m_stSystemStatus, ul32OffsetAddr);    
            }
            break;
            case PROP_VENDOR_NAME:
            {
                 GET_DEVPROP_OFFSET(m_stVendorName, ul32OffsetAddr);    
            }
            break;
            case PROP_VENDOR_IDENTIFIER:
            {
                 GET_DEVPROP_OFFSET(m_stVendorId, ul32OffsetAddr);    
            }
            break;
            case PROP_MODEL_NAME:
            {
                 GET_DEVPROP_OFFSET(m_stModelName, ul32OffsetAddr);    
            }
            break;
            case PROP_FIRMWARE_REVISION:
            {
                 GET_DEVPROP_OFFSET(m_stFirmwareRev, ul32OffsetAddr);    
            }
            break;
            case PROP_APPLICATION_SOFTWARE_VERSION:
            {
                 GET_DEVPROP_OFFSET(m_stApplSoftwareVersion, ul32OffsetAddr);    
            }
            break;
            case PROP_APDU_TIMEOUT:
            {
                 GET_DEVPROP_OFFSET(m_stAPDUTimeout, ul32OffsetAddr);    
            }
            break;
            case PROP_NUMBER_OF_APDU_RETRIES:
            {
                 GET_DEVPROP_OFFSET(m_stNumOfAPDURetries, ul32OffsetAddr);    
            }
            break;
            case PROP_DEVICE_ADDRESS_BINDING:
            {
                 GET_DEVPROP_OFFSET(m_stDevAddBinding, ul32OffsetAddr);    
            }
            break;
            case PROP_DATABASE_REVISION:
            {
                 GET_DEVPROP_OFFSET(m_stDatabaseRev, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_VERSION:
            {
                 GET_DEVPROP_OFFSET(m_stProtocolVersion, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_REVISION:
            {
                 GET_DEVPROP_OFFSET(m_stProtocolRevision, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_SERVICES_SUPPORTED:
            {
                 GET_DEVPROP_OFFSET(m_stServicesSupported, ul32OffsetAddr);    
            }
            break;
            case PROP_PROTOCOL_OBJECT_TYPES_SUPPORTED:
            {
                 GET_DEVPROP_OFFSET(m_stObjectTypeSupported, ul32OffsetAddr);    
            }
            break;
            case PROP_OBJECT_LIST:
            {
                GET_DEVPROP_OFFSET(m_stObjectIDList, ul32OffsetAddr);
            }
            break;
            case PROP_MAX_APDU_LENGTH_ACCEPTED:
            {
                 GET_DEVPROP_OFFSET(m_stMaxAPDULenAccepted, ul32OffsetAddr);    
            }
            break;
            case PROP_SEGMENTATION_SUPPORTED:
            {
                 GET_DEVPROP_OFFSET(m_stSegmentationSupport, ul32OffsetAddr);    
            }
            break;
#ifdef BACDEL_PR14
			case PROP_PROPERTY_LIST:
            {
                 GET_DEVPROP_OFFSET(m_stPropertyList, ul32OffsetAddr);    
            }
            break;
#endif

#ifdef SEGMENTATION_SUPPORTED
			case PROP_APDU_SEGMENT_TIMEOUT:
            {
                 GET_DEVPROP_OFFSET(m_stAPDUSegTimeout, ul32OffsetAddr);    
            }
            break;
            case PROP_MAX_SEGMENTS_ACCEPTED:
            {
                 GET_DEVPROP_OFFSET(m_stMaxSegAccepted, ul32OffsetAddr);    
            }
            break;
#endif

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B)
			case PROP_ACTIVE_COV_SUBSCRIPTIONS:
            {
                 GET_DEVPROP_OFFSET(m_stActiveCOVSubList, ul32OffsetAddr);  
            }
            break;
#endif

#if (defined BACDEL_SER_DM_TS_B || defined BACDEL_SER_DM_UTC_B)
            case PROP_LOCAL_TIME:
            {
                 GET_DEVPROP_OFFSET(m_stLocalTime, ul32OffsetAddr);    
            }
            break;
            case PROP_LOCAL_DATE:
            {
                 GET_DEVPROP_OFFSET(m_stLocalDate, ul32OffsetAddr);    
            }
            break;
#endif
#ifdef BACDEL_SER_DM_UTC_B
            case PROP_UTC_OFFSET:
            {
                 GET_DEVPROP_OFFSET(m_stUTCOffset, ul32OffsetAddr);    
            }
            break;
            case PROP_DAYLIGHT_SAVINGS_STATUS:
            {
                 GET_DEVPROP_OFFSET(m_stDaylightSavingStatus, ul32OffsetAddr);   
            }
            break;    
#endif

#ifdef OPTIONAL_PROPERTY
            case PROP_LOCATION:
            {
                 GET_DEVPROP_OFFSET(m_stLocation, ul32OffsetAddr);    
            }
            break;
            case PROP_DESCRIPTION:
            {
                 GET_DEVPROP_OFFSET(m_stDescription, ul32OffsetAddr);    
            }
            break;


#ifdef BACDEL_PR14

#endif
#endif /* OPTIONAL_PROPERTY */
            default:
            {
				#ifdef DEBUG_PRINTF
                Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetAsignPropAccess : \
                    Property Match Not Found\r\n");
				#endif
                return ePropType;
            }
            break;
        }
    }
    else
    {
        switch(eDevProp)
        {
            case PROP_OBJECT_IDENTIFIER:
            {
                GET_OBJCOMMON_OFFSET(eObjectType, m_stObjectID, ul32OffsetAddr);
            }
            break;
            case PROP_OBJECT_NAME:
            {
                GET_OBJCOMMON_OFFSET(eObjectType, m_stObjName ,ul32OffsetAddr);
            }
            break;
            case PROP_OBJECT_TYPE:
            {
				/* NOTE: use this when ObjType property is separate */
                GET_OBJCOMMON_OFFSET(eObjectType, m_stObjectType, ul32OffsetAddr); //<@> .m_eAccessType is removed
            }
            break;  
#ifdef BACDEL_PR14
			      case PROP_PROPERTY_LIST:
            {
                 GET_OBJCOMMON_OFFSET(eObjectType, m_stPropertyList, ul32OffsetAddr);    
            }
            break;
#endif						
            case PROP_PRESENT_VALUE:          
            {
                GET_PV_ELEMENT_OFFSET(eObjectType, m_stPresentValue, 
                    ul32OffsetAddr);
            }
            break;
            case PROP_STATUS_FLAGS:
            {
                GET_STATUSFLAG_OFFSET(eObjectType, m_stStatusFlag, ul32OffsetAddr);
            }
            break;
            case PROP_EVENT_STATE:
            {
                GET_EVENTSTATE_OFFSET(eObjectType, m_stEventState, ul32OffsetAddr);
            }
            break;
            case PROP_OUT_OF_SERVICE:
            {
                GET_OOS_OFFSET(eObjectType, m_stOutOfService,ul32OffsetAddr);
            }
            break;          
#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSO || defined BACDEL_OBJ_MSV)
            case PROP_NUMBER_OF_STATES:
            {
                GET_MULTISTATE_PROP_OFFSET(eObjectType, m_stNumberOfStates ,
                                                                ul32OffsetAddr);
            }
            break;                       
#endif
            case PROP_PRIORITY_ARRAY:
            {
                GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray ,ul32OffsetAddr);
            }
            break;
            case PROP_RELINQUISH_DEFAULT:
            {
                GET_RELINQUISH_OFFSET(eObjectType, m_stRelinquishDefault , ul32OffsetAddr);
            }
            break;           
            case PROP_UNITS:
            {
                GET_UNITS_OFFSET(eObjectType, m_stUnit ,ul32OffsetAddr);
            }
            break;        

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B)
            case PROP_COV_INCREMENT:
            {
                ///* Update property offset */
            	switch (eObjectType)
				{
					default:
						/* Update property offset */
						GET_DEADBAND_COV_INCR_OFFSET(eObjectType, m_stCOVIncrement , ul32OffsetAddr);
					break;
				}		
            }
            break;
#endif

#ifdef OPTIONAL_PROPERTY
            case PROP_DESCRIPTION:
            {
                GET_OBJCOMMON_OFFSET(eObjectType, m_stDescription, ul32OffsetAddr);
            }
            break;
            case PROP_DEVICE_TYPE:
            {
                GET_DEVICETYPE_OFFSET(eObjectType, m_stDeviceType ,
                    ul32OffsetAddr);
            }
            break;
#if (defined BACDEL_OBJ_AI || defined BACDEL_OBJ_AO || defined BACDEL_OBJ_AV)
            case PROP_MIN_PRES_VALUE:
            {
                ///* Update property offset */
             	switch (eObjectType)
				{

					default:
					/* Update property offset */
						GET_MIN_PV_RESOLUTION_OFFSET(eObjectType, m_stMinPresValue ,
						ul32OffsetAddr);
					break;
				}		
					
            }
            break;
#endif
            case PROP_RESOLUTION:														
            {
                ///* Update property offset */
				switch (eObjectType)
				{

					default:
						/* Update property offset */
						GET_MIN_PV_RESOLUTION_OFFSET(eObjectType, m_stResolution ,
						 ul32OffsetAddr);
					break;
				}		
            }
            break;
#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO)
            case PROP_POLARITY:
            {
                GET_POLARITY_OFFSET(eObjectType, m_stPolarity, ul32OffsetAddr);
            }
            break;
#endif /* BI- BO */
#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO || defined BACDEL_OBJ_BV)
            case PROP_INACTIVE_TEXT:
            {
                GET_BINARYONLY_OFFSET(eObjectType, m_stInactive_Text ,
                                                                ul32OffsetAddr);
            }
            break;
            case PROP_ACTIVE_TEXT:
            {
                GET_BINARYONLY_OFFSET(eObjectType, m_stActive_Text ,
                                                                ul32OffsetAddr);
            }
            break;
            case PROP_CHANGE_OF_STATE_TIME:
            {
                GET_BINARYONLY_OFFSET(eObjectType, m_stChangeOfStateTime , 
                    ul32OffsetAddr);
            }
            break;
            case PROP_CHANGE_OF_STATE_COUNT:
            {
                GET_BINARYONLY_OFFSET(eObjectType, m_stChangeOfStateCount , 
                    ul32OffsetAddr);
            }
            break;
            case PROP_TIME_OF_STATE_COUNT_RESET:
            {
                GET_BINARYONLY_OFFSET(eObjectType, m_stCountResetTime , 
                    ul32OffsetAddr);
            }
            break;
            case PROP_ELAPSED_ACTIVE_TIME:
            {
                /* TODO - check if proper offset is returned */
                GET_BINARYONLY_OFFSET(eObjectType, m_stElaspsedActiveTime.stActiveElapseTime , 
                    ul32OffsetAddr);
            }
            break;
            case PROP_TIME_OF_ACTIVE_TIME_RESET:
            {
                GET_BINARYONLY_OFFSET(eObjectType, m_stActiveTimeResetTime , 
                    ul32OffsetAddr);
            }
            break;
#endif /* BI - BO - BV  */
#if (defined BACDEL_OBJ_BO || defined BACDEL_OBJ_BV)
            case PROP_MINIMUM_OFF_TIME:
            {
	            GET_MIN_ON_OFF_TIME_OFFSET(eObjectType, m_stMinimumOffTime,
	            ul32OffsetAddr);
            }
            break;
            case PROP_MINIMUM_ON_TIME:
            {
	            GET_MIN_ON_OFF_TIME_OFFSET(eObjectType, m_stMinimumOnTime ,
	            ul32OffsetAddr);
            }
            break;
#endif /* BO - BV */
#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSO || defined BACDEL_OBJ_MSV)
            case PROP_STATE_TEXT:
            {
                GET_MULTISTATE_PROP_OFFSET(eObjectType, m_stStateText, ul32OffsetAddr);
            }
            break;
#endif
#endif /* OPTIONAL_PROPERTY */

#if (defined OPTIONAL_PROPERTY )
            case PROP_MAX_PRES_VALUE:							
            {
                ///* Update property offset */
				switch (eObjectType)
				{

					default:
					/* Update property offset */
					GET_MAX_PV_OFFSET(eObjectType, m_stMaxPresValue ,
									ul32OffsetAddr);
					break;
				}	
            }
            break;
#endif
           
#if (defined OPTIONAL_PROPERTY || defined BACDEL_SER_AE_EN_B || defined BACDEL_OBJ_SDL || defined BACDEL_OBJ_EE)
            case PROP_RELIABILITY:															
            {
                GET_RELIABILITY_OFFSET(eObjectType, m_stReliability, ul32OffsetAddr);
            }
            break;
#endif

#ifdef BACDEL_SER_AE_EN_B
#endif
            
#ifdef BACDEL_OBJ_NC

#endif /* BACDEL_OBJ_NC */

#ifdef BACDEL_OBJ_CAL
            case PROP_DATE_LIST:
			{
			}
			break;
#endif /* BACDEL_OBJ_CAL */

#ifdef BACDEL_OBJ_SDL
#endif /* BACDEL_OBJ_SDL */

#if (defined BACDEL_OBJ_SDL )
            case PROP_PRIORITY_FOR_WRITING:
			{
				/* Update property offset */
				GET_PRIORITYFORWRT_OFFSET(eObjectType, m_stPriorityForWriting,
					ul32OffsetAddr);
			}
			break;
#endif

#if (defined OPTIONAL_PROPERTY && (defined BACDEL_OBJ_AI))
            case PROP_UPDATE_INTERVAL:
            {
	            GET_UPDATEINTERVAL_OFFSET(eObjectType,m_stUpdateInterval,ul32OffsetAddr);
            }
            break;
#endif

            default:
            {
				#ifdef DEBUG_PRINTF
                Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:GetAsignPropAccess : \
                    Property Match Not Found\r\n");
				#endif
                return ePropType;
            }
        }
    }   

    /* Check if access type value is to be written */
    if(bReadOrWrite)
    {
        memcpy(((void *)(ul32BaseAddr+ul32OffsetAddr)), &eAccessType, 
            sizeof(PROP_ACCESS_TYPE));
    }

    /* check if offset address is to be returned */
    if(NULL != pul32PropOffstAddr)
        *pul32PropOffstAddr = ul32OffsetAddr;

    /* Read the access type and return */
	ePropType =	eAccessType;

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetAsignPropAccess : Exit \r\n"); 
	#endif
    return ePropType;
}



/********** end of propertyGenricHandler.c file. ***********/
