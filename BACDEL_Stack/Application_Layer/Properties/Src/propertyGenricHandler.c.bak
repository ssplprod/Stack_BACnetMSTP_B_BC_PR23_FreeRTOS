/**
*
*DESCRIPTION
*   This API initializes object with passed value & permissions.
*
*@param ucDevId - Object Id of which property needs to be Initialize.
*@param eDevProp - Property of object which is to be initialize.
*@param ePermission - Access permission for property.
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/
static BACNET_RETURN_TYPE Init_Device_Prop
                    (void *pvVirtualDev,
                    BACNET_OBJECT_TYPE eObjType,
                    BACNET_PROPERTY_ID eDevProp,
                    int32_t i32ArrayIndex,
                    void *p_value,
                    PROP_ACCESS_TYPE ePermission,
                    void **pvPropAdd)
{
    /* local variables */
    BACNET_RETURN_TYPE  eFuncRet = BACDEL_SUCCESS;   /** API return value */
    virtualDevData_t* pstVirtualDev = NULL;
    devObject_t * pstDevObject = NULL;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Init_Device_Prop : Entry \r\n");
	#endif

    /* get virtual device pointer */
    pstVirtualDev = pvVirtualDev;

    /* check input pointer */
    if(NULL == pvVirtualDev || NULL == p_value)
    {
		#ifdef DEBUG_PRINTF
        Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: \
        Init_Device_Prop : null input pointer \r\n");
		#endif
        return BACDEL_ERROR;
    }

    pstDevObject = &pstVirtualDev->m_stDevObject;

    /* Now add property for corresponding device */
    switch(eDevProp)
    {
        /* For Object Identifier */
        case PROP_OBJECT_IDENTIFIER:
        {
            memcpy(&(pstDevObject->m_stObjectID.m_u32ObjId), p_value,
                sizeof(uint32_t));
            /* Update the pointer & data type for application */
            *pvPropAdd = &(pstDevObject->m_stObjectID.m_u32ObjId);
        }
        break;

        /* Object Name */
        case PROP_OBJECT_NAME:
        {
            /* Copy data into property offset address */
            memcpy(&(pstDevObject->m_stObjName.m_stCHARString),(BACnetCharStr_t *)p_value,
                    sizeof(BACnetCharStr_t));

            *pvPropAdd = &(pstDevObject->m_stObjName.m_stCHARString.m_pu8CharStr[0]);
        }
        break;

        case PROP_OBJECT_TYPE:
        {
            memcpy(&(pstDevObject->m_stObjectType.m_eObjectType),
                p_value, sizeof(BACNET_OBJECT_TYPE));
            *pvPropAdd = &(pstDevObject->m_stObjectType.m_eObjectType);
        }
        break;

        case PROP_SYSTEM_STATUS:
        {
            memcpy(&(pstDevObject->m_stSystemStatus.m_eDeviceStatus),
                p_value, sizeof(BACNET_DEVICE_STATUS));
            *pvPropAdd = &(pstDevObject->m_stSystemStatus.m_eDeviceStatus);
        }
        break;
        case PROP_VENDOR_NAME:
        {
            /* Copy data into property offset address */
            memcpy(&(pstDevObject->m_stVendorName.m_stCHARString),(BACnetCharStr_t *)p_value,
                    sizeof(BACnetCharStr_t));

            *pvPropAdd = &(pstDevObject->m_stVendorName.m_stCHARString.m_pu8CharStr[0]);
        }
        break;
        case PROP_VENDOR_IDENTIFIER:
        {
            memcpy(&(pstDevObject->m_stVendorId.m_u16Val),p_value,
                sizeof(uint16_t));
            *pvPropAdd = &(pstDevObject->m_stVendorId.m_u16Val);
        }
        break;
        case PROP_MODEL_NAME:
        {
            /* Copy data into property offset address */
            memcpy(&(pstDevObject->m_stModelName.m_stCHARString),(BACnetCharStr_t *)p_value,
                    sizeof(BACnetCharStr_t));

            *pvPropAdd = &(pstDevObject->m_stModelName.m_stCHARString.m_pu8CharStr[0]);
        }
        break;
        case PROP_FIRMWARE_REVISION:
        {
            /* Copy data into property address */
            memcpy(&(pstDevObject->m_stFirmwareRev.m_stCHARString),(BACnetCharStr_t *)p_value,
                    sizeof(BACnetCharStr_t));

            *pvPropAdd = &(pstDevObject->m_stFirmwareRev.m_stCHARString.m_pu8CharStr[0]);
        }
        break;
        case PROP_APPLICATION_SOFTWARE_VERSION:
        {
            /* Copy data into property address */
            memcpy(&(pstDevObject->m_stApplSoftwareVersion.m_stCHARString),(BACnetCharStr_t *)p_value,
                sizeof(BACnetCharStr_t));
            *pvPropAdd = &(pstDevObject->m_stApplSoftwareVersion.m_stCHARString.m_pu8CharStr[0]);
        }
        break;

        case PROP_APDU_TIMEOUT:
        {
            memcpy(&(pstDevObject->m_stAPDUTimeout.m_u32Val),p_value,
                sizeof(uint32_t));
            *pvPropAdd = &(pstDevObject->m_stAPDUTimeout.m_u32Val);
        }
        break;

        case PROP_NUMBER_OF_APDU_RETRIES:
        {
            memcpy(&(pstDevObject->m_stNumOfAPDURetries.m_u32Val),p_value,
                sizeof(uint32_t));
            *pvPropAdd = &(pstDevObject->m_stNumOfAPDURetries.m_u32Val);
        }
        break;

        case PROP_DEVICE_ADDRESS_BINDING:
        {
            memcpy(&(pstDevObject->m_stDevAddBinding),(Pr_ListOfBACnetAddrBinding_t *)p_value,
                 sizeof((uint8_t *)p_value));
            *pvPropAdd = &(pstDevObject->m_stDevAddBinding);
        }
        break;

        case PROP_DATABASE_REVISION:
        {
            memcpy(&(pstDevObject->m_stDatabaseRev.m_u32Val),p_value,
                sizeof(uint32_t));
            *pvPropAdd = &(pstDevObject->m_stDatabaseRev);
        }
        break;

        case PROP_PROTOCOL_SERVICES_SUPPORTED:
        {
            memcpy(&(pstDevObject->m_stServicesSupported),
                (int8_t *)p_value, sizeof(pstDevObject->m_stServicesSupported));
            *pvPropAdd = &(pstDevObject->m_stServicesSupported.m_stServiceSupport.Bit);
        }
        break;

        case PROP_PROTOCOL_OBJECT_TYPES_SUPPORTED:
        {
            memcpy(&(pstDevObject->m_stObjectTypeSupported),
                (int8_t *)p_value, sizeof(pstDevObject->m_stObjectTypeSupported));
            *pvPropAdd = &(pstDevObject->m_stObjectTypeSupported.m_stObjectSupport.Bit);
        }
        break;

        case PROP_PROTOCOL_VERSION:
        {
            memcpy(&(pstDevObject->m_stProtocolVersion.m_u32Val),
                 p_value, sizeof(uint32_t));
            *pvPropAdd = &(pstDevObject->m_stProtocolVersion.m_u32Val);
        }
        break;

        case PROP_PROTOCOL_REVISION:
        {
            memcpy(&(pstDevObject->m_stProtocolRevision.m_u32Val), p_value, sizeof(uint32_t));
            *pvPropAdd = &(pstDevObject->m_stProtocolRevision.m_u32Val);
        }
        break;

        case PROP_MAX_APDU_LENGTH_ACCEPTED:
        {
            memcpy(&(pstDevObject->m_stMaxAPDULenAccepted.m_u16Val),
                 p_value, sizeof(uint16_t));
            *pvPropAdd = &(pstDevObject->m_stMaxAPDULenAccepted.m_u16Val);
        }
        break;

        case PROP_SEGMENTATION_SUPPORTED:
        {
            memcpy(&(pstDevObject->m_stSegmentationSupport.m_eSegmentationSupport),
                 p_value, sizeof(BACNET_SEGMENTATION));
            *pvPropAdd = &(pstDevObject->m_stSegmentationSupport.m_eSegmentationSupport);
        }
        break;

#ifdef SEGMENTATION_SUPPORTED
        case PROP_MAX_SEGMENTS_ACCEPTED:
        {
            memcpy(&(pstDevObject->m_stMaxSegAccepted.m_u16Val),
                p_value, sizeof(uint16_t));
            *pvPropAdd = &(pstDevObject->m_stMaxSegAccepted.m_u16Val);
        }
        break;

        case PROP_APDU_SEGMENT_TIMEOUT:
        {
            memcpy(&(pstDevObject->m_stAPDUSegTimeout.m_u32Val),
				p_value, sizeof(uint32_t));
            *pvPropAdd = &(pstDevObject->m_stAPDUSegTimeout.m_u32Val);
        }
        break;
#endif /* SEGMENTATION_SUPPORTED */

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B)
        case PROP_ACTIVE_COV_SUBSCRIPTIONS:
        {
            memcpy(&(pstDevObject->m_stActiveCOVSubList.
              m_pstCOVSubscribe), (ListOfBACnetCovSubs_t *)p_value,
              sizeof(ListOfBACnetCovSubs_t));
            *pvPropAdd = pstDevObject->m_stActiveCOVSubList.m_pstCOVSubscribe;
        }
        break;
#endif /* (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B) */

#if (defined BACDEL_SER_DM_TS_B || defined BACDEL_SER_DM_UTC_B || \
	     (defined BACDEL_SER_AE_AA_A && defined BACDEL_PR23))
        case PROP_LOCAL_DATE:
        {
            memcpy(&(pstDevObject->m_stLocalDate),(Pr_BACnetDate_t *)p_value,
                 sizeof(Pr_BACnetDate_t));
            *pvPropAdd = &(pstDevObject->m_stLocalDate);
        }
        break;
        case PROP_LOCAL_TIME:
        {
            memcpy(&(pstDevObject->m_stLocalTime),(Pr_BACnetTime_t *)p_value,
                 sizeof(Pr_BACnetTime_t));
            *pvPropAdd = &(pstDevObject->m_stLocalTime);
        }
        break;
#endif /* (defined BACDEL_SER_DM_TS_B || defined BACDEL_SER_DM_UTC_B) */

#ifdef BACDEL_SER_DM_UTC_B
		case PROP_UTC_OFFSET:
        {
            memcpy(&(pstDevObject->m_stUTCOffset.m_i32Val), p_value,
                sizeof(int32_t));
            *pvPropAdd = &(pstDevObject->m_stUTCOffset.m_i32Val);
            //BACnetConfigData.m_u32UTCOffset=pstDevObject->m_stUTCOffset.m_i32Val;
        }
        break;
        case PROP_DAYLIGHT_SAVINGS_STATUS:
        {
            memcpy(&(pstDevObject->m_stDaylightSavingStatus.m_bVal),
                p_value, sizeof(bool));
            *pvPropAdd = &(pstDevObject->m_stDaylightSavingStatus.m_bVal);
        }
        break;
#endif /* BACDEL_SER_DM_UTC_B */

        case PROP_MAX_MASTER:
        {
				memcpy(&(pstDevObject->m_stMAXMaster.m_u32Val),p_value,
					sizeof(uint32_t));
				*pvPropAdd = &(pstDevObject->m_stMAXMaster.m_u32Val);
        }
        break;
        case PROP_MAX_INFO_FRAMES:
        {
				memcpy(&(pstDevObject->m_stMaxInfoFrames.m_u32Val),p_value,
					sizeof(uint32_t));
				*pvPropAdd = &(pstDevObject->m_stMaxInfoFrames);
        }
        break;

#ifdef OPTIONAL_PROPERTY

#endif /* OPTIONAL_PROPERTY */

        default:
        {
           eFuncRet = BACDEL_PROPERTY_NOT_PRESENT;
		   #ifdef DEBUG_PRINTF
           Print_DebugMsg(DEBUG_LEVEL1, "BACnetStackAppLayer:Init_Device_Prop:"
               "Property not supported by device\r\n");
		   #endif
        }
        break;
        
    }    

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Init_Device_Prop : Exit \r\n"); 
	#endif

    return eFuncRet;
}

/**
*
*DESCRIPTION
*   This API Get given object pointer witht the instance number from
*   the look up table and call AddCommonProperties function
*    
*@param ucDevId - Device Id of which Object needs to be Initialize.
*@param u32ObjectID - Object Id
*@param eDevProp - Property of object which is to be initialize.
*@param eObjectType - Object Type 
*@param pvData - Initialization value.
*@param ePermission - Access permission for property.
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*
*/
static BACNET_RETURN_TYPE InitCommonProperty(void *pvVirtualDev,
                                        void *pvObjectPrt,
                                        uint32_t u32ObjectID,
                                        uint32_t eDevProp,
                                        int32_t i32ArrayIndex,
                                        BACNET_OBJECT_TYPE eObjectType,
                                        void *pvData, 
                                        PROP_ACCESS_TYPE ePermission,
                                        void **pvPropAdd,
                                        bool bRemDev)                             
{
    /* Virtual Data pointer */
    virtualDevData_t *pVirtualDev = NULL;
    uint32_t u32PropertyAdd = 0;       
    /** Function return value */
    BACNET_RETURN_TYPE  eFuncRet = BACDEL_SUCCESS; 

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:InitCommonProperty : Entry \r\n"); 
	#endif
        
    /* get the virtual device pointer */
    pVirtualDev = pvVirtualDev;

    /* Now add common properties for corresponding Object 
            BACDEL_ERROR - No common property found */
        eFuncRet = UpdateCommonProperty(eObjectType, pvObjectPrt,
                            eDevProp ,i32ArrayIndex, pvData, ePermission, &u32PropertyAdd,
                            pvPropAdd, pVirtualDev,true,bRemDev,false);
	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:InitCommonProperty :"
        "Exit\r\n"); 
	#endif
    return eFuncRet;
}

/**
*
*DESCRIPTION
*   This API fill local structures, on which UpdateCommonProperty
*   function depends. For independend properties send input void
*   pointer as it is for follwoing functions .
*     
*@param ucDevId - Device Id of which Object needs to be Initialize.
*@param u32ObjectID - Object Id
*@param eDevProp - Property of object which is to be initialize.
*@param eObjectType - Object Type 
*@param pvInData - Initialization value.
*@param ePermission - Access permission for property.
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*
*/
BACNET_RETURN_TYPE Convert_InStr_AddProperty(void *pvVirtualDev,
                                void *pvObject,
                                uint32_t u32ObjectID,
                                BACNET_OBJECT_TYPE eObjType,
                                BACNET_PROPERTY_ID eDevProp,
                                int32_t i32ArrayIndex,
                                void *pvInData,
                                PROP_ACCESS_TYPE ePermission,
                                void **pvPropAdd,
                                bool bRemoteDev)
{
    bool bInitFlag = FALSE;
	/* For parsing input raw string (from pvInData ) */
    char     *pTokens = NULL;
	int8_t      ai8CharString[1000] = {0x00};  	
    uint8_t     u8byteCount = 0;
    uint8_t     i8TokenCount = 0;
    /* Void pointer to be sent to UpdateCommonProperty function */
    void *pvData = NULL;  
    /* Function return type */  
    BACNET_RETURN_TYPE eFunRet = BACDEL_SUCCESS;

    /* Local loop counter and values */
    int8_t i8Count = 0;
    uint8_t u8DataByte = 0;
    uint8_t *pInData = NULL;
	uint32_t	u32Len = 0;

	/* virtual device instance */
	virtualDevData_t *pVirtualDev = NULL;

    /* all data type */
    AllDataType_u usAllDataType = {0};
    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Convert_InStr_AddProperty: Entry \r\n"); 
	#endif

    /* get virtual device pointer */
    pVirtualDev = pvVirtualDev;

    /* check input pointers */
    if(NULL == pVirtualDev || NULL == pvObject)
    {   
	    /* Reached End of Remote Device Link List */
		#ifdef DEBUG_PRINTF
	    Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: \
        Convert_InStr_AddProperty: NUll input pointers \r\n");
		#endif
	    return BACDEL_ERROR;     
    }

    /* get the property data */
    if(NULL != pvInData)
        pInData = (uint8_t *)pvInData;

    /* Specific properties are depended on structure format input 
    for following Add property functions. So case is based on property
    type */
    switch(eDevProp)
    {
        /* For List type properties */
        case PROP_ALARM_VALUES:
        case PROP_FAULT_VALUES:
		{
            /* Tags need to be updated based on the obejct data type.So switch
            case is based on Object type */
            switch(eObjType)
            {
#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSV)
                case OBJECT_MULTI_STATE_INPUT:
                case OBJECT_MULTI_STATE_VALUE:
                    pvData = Parse_AF_Values(pInData);
                    break;
#endif
                /* default case */
                default:
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:Convert_InStr_AddProperty :"
                        "BACDEL_OBJECT_TYPE_ERROR\r\n"); 
					#endif
                    /* Unknown object found for these properties */
                    return BACDEL_OBJECT_TYPE_ERROR;
            }//switch ends.
		}
		break;

#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSO || defined BACDEL_OBJ_MSV)
		/* State Text property */
		case PROP_STATE_TEXT:
        {
            if(NULL == pvInData)
                return BACDEL_ERROR;
            /* Copy raw string into structure and pass its pointer */
			u32Len = Strnlen(pvInData, sizeof(ai8CharString));
            Strcopy(ai8CharString,(int8_t *)pvInData, u32Len);
            pvData = &ai8CharString[0];
        }
        break;
#endif /* MSI - MSO - MSV */

        /* For Bit string type properties Status flag */
        case PROP_STATUS_FLAGS:
        {
            /* Get pointer to Property value string */
            pTokens = pvInData;

			/* As Status Flag is not writable, 
            keep all bits zero independend of input string */

            usAllDataType.stBitString.m_stBitString.m_u8ByteCnt = 1;
            usAllDataType.stBitString.m_stBitString.m_u8UnusedBits = 4;
            pvData = &usAllDataType.stBitString;
        }
        break;

		/* For Bit string type properties - below prop - uses 3bits */
		case PROP_EVENT_ENABLE:
        case PROP_ACKED_TRANSITIONS:
		case PROP_ACK_REQUIRED:
		{
            /* Get pointer to Property value string */
            pTokens = pvInData;

            if(NULL == pvInData)
                return BACDEL_ERROR;

			pTokens = strtok(pTokens," (,");
			if(!strcmp( pTokens, "1"))
				usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] = 
                usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] | 0x01;
			pTokens = strtok(NULL," ,");
			if(!strcmp( pTokens, "1"))
				usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] = 
                usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] | 0x02;
			pTokens = strtok(NULL," ,)");
			if(!strcmp( pTokens, "1"))
				usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] = 
                usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] | 0x04;

            usAllDataType.stBitString.m_stBitString.m_u8ByteCnt = 1;
            usAllDataType.stBitString.m_stBitString.m_u8UnusedBits = 5;
			pvData = &usAllDataType.stBitString;
        }
		break;

		/* For Bit string type properties - limit enable - uses 2bits */
		case PROP_LIMIT_ENABLE:
		{
			/* Get pointer to Property value string */
            pTokens = pvInData;

            if(NULL == pvInData)
                return BACDEL_ERROR;

			pTokens = strtok(pTokens," (,");
			if(!strcmp( pTokens, "1"))
				usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] = 
                usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] | 0x01;
			pTokens = strtok(NULL," ,)");
			if(!strcmp( pTokens, "1"))
				usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] = 
                usAllDataType.stBitString.m_stBitString.m_u8TransBits[0] | 0x02;

            usAllDataType.stBitString.m_stBitString.m_u8ByteCnt = 1;
            usAllDataType.stBitString.m_stBitString.m_u8UnusedBits = 6;
            pvData = &usAllDataType.stBitString;
        }
		break;

#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO || defined BACDEL_OBJ_BV)
        /* For Date and time type properties */
        case PROP_CHANGE_OF_STATE_TIME:
        case PROP_TIME_OF_STATE_COUNT_RESET:
        case PROP_TIME_OF_ACTIVE_TIME_RESET:
        {
            /* Making all date and time independed of input data.
            Because this property read only and updates at run time */
            /* get device date time */
            GetDevice_DateTime(&(usAllDataType.stDateTime.m_stDateTime.m_stDate), 
                &(usAllDataType.stDateTime.m_stDateTime.m_stTime), 
                pVirtualDev);
            pvData = &usAllDataType.stDateTime.m_stDateTime;
        }
        break;
#endif /* BI - BO - BV */
        /* For priority array type properties */
        case PROP_PRIORITY_ARRAY:
        {
            /* Clear local array and fill it with input raw string for 
            parsing and validating */
            if(NULL == pvInData)
                return BACDEL_ERROR;

            i8Count = (int8_t)(Strnlen(pvInData, sizeof(ai8CharString)));
            Copy_String((uint8_t *)ai8CharString,(uint8_t *)pvInData,i8Count);
            
            /* Tags need to be updated based on the obejct data type.So switch
            case is based on Object type */
            switch(eObjType)
            {
                case OBJECT_ANALOG_VALUE:
                case OBJECT_ANALOG_OUTPUT:
               /* Fill all priority elements with input data.If any
                element found with space character or not filled at all,
                treat them as null */
                for(i8Count = 0 ; i8Count<MAX_PRIORITY_ARRAY_COUNT; i8Count++)
                {
                    /* For handling first unused elements, Once string
                       initialization done, then further this block no
                       more in  use  */
                    if((ai8CharString[i8Count] != ',')&&(bInitFlag == FALSE))
                    {
                       pTokens = strtok((char *)ai8CharString,",");
                       bInitFlag = TRUE;
                    }
                    if((pTokens != NULL) &&(!(Strncmp(pTokens, "NULL",sizeof("NULL")))))
                    {
                        pTokens = (char*)"0x00";
                        usAllDataType.stPriorityArray.m_bTagType[i8Count] =
                            BACNET_APPLICATION_TAG_NULL;
                        usAllDataType.stPriorityArray.m_uValue.m_fVal[i8Count] = 
							(Float_t)atof((const char*)pTokens);
                    }
                    else if(pTokens != NULL)
                    {
                        usAllDataType.stPriorityArray.m_bTagType[i8Count] =
                            BACNET_APPLICATION_TAG_REAL;
                        usAllDataType.stPriorityArray.m_uValue.m_fVal[i8Count] = 
							(Float_t)atof((const char*)pTokens);
                    }

                    pTokens = NULL;
                    
                    /* For handling middle empty element */
                    if(bInitFlag == TRUE)
                    {
                        if(ai8CharString[i8Count+2] != ',')
                            /* Check for next consecutive elements.strtok function
                            expect NULL as its first argument for further trace */
                            pTokens = strtok(NULL,",");
                        else
                            pTokens = NULL;
                    }
                }
                break;
                case OBJECT_MULTI_STATE_OUTPUT:
                case OBJECT_MULTI_STATE_VALUE:

                /* Fill all priority elements with input data.If any
                element found with space character or not filled at all,
                treat them as null */
                for(i8Count = 0 ; i8Count<MAX_PRIORITY_ARRAY_COUNT; i8Count++)
                {
                    /* For handling first unused elements, Once string
                       initialization done, then further this block no
                       more in  use  */
                    if((ai8CharString[i8Count] != ',')&&(bInitFlag == FALSE))
                    {
                       pTokens = strtok((char *)ai8CharString,",");
                       bInitFlag = TRUE;
                    }
                    if((pTokens != NULL) &&(!(Strncmp(pTokens, "NULL",sizeof("NULL")))))
                    {
                        pTokens = (char*)"0x00";
                        usAllDataType.stPriorityArray.m_bTagType[i8Count] =
                            BACNET_APPLICATION_TAG_NULL;
                        usAllDataType.stPriorityArray.m_uValue.m_u32Val[i8Count] = 
							(int32_t)atoi((const char*)pTokens);

                    }
                    else if(pTokens != NULL)
                    {
                        usAllDataType.stPriorityArray.m_bTagType[i8Count] =
                            BACNET_APPLICATION_TAG_UNSIGNED_INT;
                        usAllDataType.stPriorityArray.m_uValue.m_u32Val[i8Count] = 
							(int32_t)atoi((const char*)pTokens);
                    }
                    pTokens = NULL;
                    
                    /* For handling middle empty element */
                    if(bInitFlag == TRUE)
                    {
                        if(ai8CharString[i8Count+2] != ',')
                            /* Check for next consecutive elements.strtok function
                            expect NULL as its first argument for further trace */
                            pTokens = strtok(NULL,",");
                        else
                            pTokens = NULL;
                    }
                }
                break;
                case OBJECT_BINARY_OUTPUT:
                case OBJECT_BINARY_VALUE:
                
                /* Fill all priority elements with input data.If any
                   Note: Unused elements considered as ''(empty field)
                */
                for(i8Count = 0 ; i8Count<MAX_PRIORITY_ARRAY_COUNT; i8Count++)
                {
                    /* For handling first unused elements, Once string
                       initialization done, then further this block no
                       more in  use  */
                    if((ai8CharString[i8Count] != ',')&&(bInitFlag == FALSE))
                    {
                       pTokens = strtok((char *)ai8CharString,",");
                       bInitFlag = TRUE;
                    }
                    
                    if((pTokens != NULL) &&(!(Strncmp(pTokens, "NULL",sizeof("NULL")))))
                    {
                        pTokens = (char*)"255";
                        usAllDataType.stPriorityArray.m_bTagType[i8Count] =
                            BACNET_APPLICATION_TAG_NULL;
                        /* Assumed that space used for uninitialized element */ 
                        usAllDataType.stPriorityArray.m_uValue.m_eVal[i8Count] = 
                            (BACNET_BINARY_PV)atoi((const char*)pTokens);
                    }
                    else if(pTokens != NULL)  
                    {
                        usAllDataType.stPriorityArray.m_bTagType[i8Count] =
                            BACNET_APPLICATION_TAG_ENUMERATED;
                        /* Assumed that space used for uninitialized element */ 
                        usAllDataType.stPriorityArray.m_uValue.m_eVal[i8Count] = 
						   (BACNET_BINARY_PV)atoi((const char*)pTokens);
                    }
       
                    pTokens = NULL;
                    
                    /* For handling middle empty element */
                    if(bInitFlag == TRUE)
                    {
                        if(ai8CharString[i8Count+2] != ',')
                            /* Check for next consecutive elements.strtok function
                            expect NULL as its first argument for further trace */
                            pTokens = strtok(NULL,",");
                        else
                            pTokens = NULL;
                    }
                }
                break;
                default:
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:Convert_InStr_AddProperty :"
                        "BACDEL_OBJECT_TYPE_ERROR\r\n"); 
					#endif
                    /* Unknown object found for priority array property */
                    return BACDEL_OBJECT_TYPE_ERROR;
                }
            }/* End of Switch case */
			/* Assign priority structure address */
            pvData = &usAllDataType.stPriorityArray;
        }
        break;

        case PROP_PROTOCOL_SERVICES_SUPPORTED:
        {       
            i8TokenCount = 0;
            Copy_String((uint8_t *)ai8CharString,(uint8_t *)pvInData,
                        (Strnlen(pvInData, sizeof(ai8CharString))));
            pTokens = strtok((char *)ai8CharString, ",");       
            do
            {
                if((NULL != pTokens) && (strcmp(pTokens, ",") != 0))
                {
                    u8DataByte = (uint8_t)(atoi((const char*)pTokens));
                    if(u8DataByte)
                    {
                        usAllDataType.stSerSupported.m_stServiceSupport.Byte[i8TokenCount]
                        = ((usAllDataType.stSerSupported.m_stServiceSupport.Byte[i8TokenCount])  
                            | (u8DataByte << u8byteCount));
                    }
                    u8byteCount++;
                }
				else
				{
					break;
				}
                pTokens = strtok(NULL, ","); 
                if(u8byteCount == 8)
                {
                    u8byteCount = 0;
                    i8TokenCount++;
                }
            }while(NULL != pTokens);
            pvData = &usAllDataType.stSerSupported;
        }
        break;

        case PROP_PROTOCOL_OBJECT_TYPES_SUPPORTED:
        {
            i8TokenCount = 0;
            Copy_String((uint8_t *)ai8CharString,(uint8_t *)pvInData,
                        (Strnlen(pvInData,sizeof(ai8CharString))));
            pTokens = strtok((char *)ai8CharString, ",");       
            do
            {
                if((NULL != pTokens) && (strcmp(pTokens, ",") != 0))
                {
                    u8DataByte = (uint8_t)(atoi((const char*)pTokens));
                    if(u8DataByte)
                    {
                       usAllDataType.stObjectSupported.m_stObjectSupport.Byte[i8TokenCount]
                        = ((usAllDataType.stObjectSupported.m_stObjectSupport.Byte[i8TokenCount]) 
                            | (u8DataByte << u8byteCount));
                     }
                    u8byteCount++;
                }
				else
				{
					break;
				}
                pTokens = strtok(NULL, ","); 
                if(u8byteCount == 8)
                {
                    u8byteCount = 0;
                    i8TokenCount++;
                }
            }while(NULL != pTokens);
            pvData = &usAllDataType.stObjectSupported;
        }
        break;

        case PROP_LOCAL_DATE:
        {
            Copy_String((uint8_t *)ai8CharString,(uint8_t *)pvInData,
                        (Strnlen(pvInData, sizeof(ai8CharString))));
            pTokens = strtok((char *)ai8CharString, "/");       
            do
            {
                if((NULL != pTokens) && (strcmp(pTokens, "/") != 0))
                {
                    switch(i8TokenCount)
                    {
                    case 0:
                        usAllDataType.stDate.m_Date_val.m_u16Year = (uint16_t)(atoi((const char*)pTokens));
                        break;
                    case 1:
                        usAllDataType.stDate.m_Date_val.m_u8Month = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    case 2:
                        usAllDataType.stDate.m_Date_val.m_u8Day = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    case 3:
                        usAllDataType.stDate.m_Date_val.m_u8Wday = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    default:
                        break;
                    }
                }
				else
				{
					break;
				}
                pTokens = strtok(NULL, "/ :");   
                i8TokenCount++;
            }while(NULL != pTokens);
            pvData = &usAllDataType.stDate;
        }
        break;

        case PROP_LOCAL_TIME:
        {
            Copy_String((uint8_t *)ai8CharString,(uint8_t *)pvInData,
                        (Strnlen(pvInData, sizeof(ai8CharString))));
            pTokens = strtok((char *)ai8CharString, ":");       
            do
            {
                if((NULL != pTokens) && (strcmp(pTokens, ":") != 0))
                {
                    switch(i8TokenCount)
                    {
                    case 0:
                        usAllDataType.stTime.m_Time_val.m_u8Hour = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    case 1:
                        usAllDataType.stTime.m_Time_val.m_u8Min = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    case 2:
                        usAllDataType.stTime.m_Time_val.m_u8Sec = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    case 3:
                        usAllDataType.stTime.m_Time_val.m_u8Hundredths = (uint8_t)(atoi((const char*)pTokens));
                        break;
                    default:
                        break;
                    }
                }
				else
				{
					break;
				}
                pTokens = strtok(NULL, ":");   
                i8TokenCount++;
            }while(NULL != pTokens);
            pvData = &usAllDataType.stTime;
        }
        break;

/* currently these properties are not suppoerted in stack,
so the inline code is commented */

        case PROP_ACTIVE_COV_SUBSCRIPTIONS:
            /* Making all date and time independed of input data.
            Because this property read only and updates at run time */
            memset((void *)&usAllDataType.stCOVSubscribe,0x00,sizeof(ListOfBACnetCovSubs_t));
            pvData = &usAllDataType.stCOVSubscribe;    
        break;

#ifdef BACDEL_OBJ_NC
		/* priority - unsigned array of 3 - read only access */
		case PROP_PRIORITY:
		{	
			uint8_t *pu8CharString = NULL;
			int8_t i8Count = 0;

            if(NULL == pvInData)
                return BACDEL_ERROR;

			pu8CharString = (uint8_t *)(strtok ((char *)pvInData,", "));
			while (pu8CharString != NULL && i8Count < BACNET_ARRAY_OF_THREE)
			{	
				usAllDataType.stPriority.m_u32Value[i8Count] = atoi((const char *)pu8CharString);
				i8Count++;
				pu8CharString = (uint8_t *)(strtok (NULL, ", "));
			}
			pvData = &usAllDataType.stPriority;
		}
		break;
       
		case PROP_RECIPIENT_LIST:
		{
			ListOfBACnetDestination_t *pstBacnetDestiHead = NULL;
			ListOfBACnetDestination_t *pstBacnetDestinations = NULL;
		
			int8_t *Notifi = NULL;
			uint8_t *pInData1 = NULL;
			int32_t i32countpro = 0;
		
			pInData1 = (uint8_t *)pvInData;
            if(NULL == pvInData)
                return BACDEL_ERROR;
			
			while(1)
			{
				/* first element in List*/
				if(pstBacnetDestiHead == NULL)
				{
					pstBacnetDestinations = (ListOfBACnetDestination_t *)OSAL_Malloc(sizeof(ListOfBACnetDestination_t),__FILE__,__FUNCTION__, __LINE__);
					if(pstBacnetDestinations == NULL)
					{
						#ifdef DEBUG_PRINTF
						Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer:Convert_InStr_AddProperty : Malloc Failed\r\n");
						#endif
						return BACDEL_MALLOC_ERROR;
					}
					pstBacnetDestiHead = pstBacnetDestinations;
				}
				/* elements are alreday in List*/
				else
				{
					while(pstBacnetDestinations->m_pstNext != NULL)
					{
						pstBacnetDestinations = pstBacnetDestinations->m_pstNext;
					}

					pstBacnetDestinations->m_pstNext = (ListOfBACnetDestination_t *)OSAL_Malloc(sizeof(ListOfBACnetDestination_t),__FILE__,__FUNCTION__, __LINE__);
					if(pstBacnetDestinations->m_pstNext == NULL)
				     {
						#ifdef DEBUG_PRINTF
						Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer:Convert_InStr_AddProperty : Malloc Failed\r\n");
						#endif
						/* clear allocated memories */
						Clear_Destination_List(&pstBacnetDestiHead);
						return BACDEL_MALLOC_ERROR;
					 }
					pstBacnetDestinations = pstBacnetDestinations->m_pstNext;
				}

				i32countpro = 0;
				/*Read string*/
				while(((*pInData1) == '(') && (i32countpro <10))
				{
					pInData1++;
					i32countpro++;
				}
				/* as while() is in continuous loop, protection provided for any extreme condition, program will not remain in loop*/
				if(i32countpro == 10 || i32countpro == 0)
					break;
				/*Read Days from String*/
				pInData1 = (uint8_t *)(getDays(pInData1, pstBacnetDestinations));
				/*this is done to get proper value on VTS*/
				pstBacnetDestinations->m_stDaysOfWeek.m_u8TransBits[0] =(pstBacnetDestinations->m_stDaysOfWeek.m_u8TransBits[0] >> 1);
				pInData1 = ((pInData1+strlen((const char *)pInData1))+2);
				/*Read Time from String*/
				pInData1=getTime(pInData1,pstBacnetDestinations);
                while(*(pInData1)!='(')
                    {
						pInData1++;
					}
                pInData1 = GetObjectid(pInData1,pstBacnetDestinations);

				/** load  The process Id of device to which notification is to be send */
				pstBacnetDestinations->m_stProcessId = atoi((const char *)strtok (NULL, ", "));

				/** load  Notification to be send will be of type confirmed or unconfirmed */
				Notifi = (int8_t *)strtok (NULL, ", ");
				if(!strcmp( (const char *)Notifi, "TRUE"))
				pstBacnetDestinations->m_bIssueConfirmedNotification =1;
				else
				pstBacnetDestinations->m_bIssueConfirmedNotification =0;


				pInData1 = (uint8_t *)(event_transition(pInData1, pstBacnetDestinations));

				while(*(pInData1-3)!= ')')
				{
					pInData1++;
				}
				pstBacnetDestinations->m_pstNext = NULL;
				if(*(pInData1-1)!=',')
					break;
			}

			pvData = pstBacnetDestiHead;
		}
        break;
#endif /* BACDEL_OBJ_NC */

#ifdef BACDEL_OBJ_CAL
        case PROP_DATE_LIST:
		{
			/* no need to add any value to date list when object is created */
            pvData = NULL;
        }
        break;
#endif /* BACDEL_OBJ_CAL */

#ifdef BACDEL_OBJ_SDL
        case PROP_EFFECTIVE_PERIOD:
		{
            if(NULL != pvInData)
                getEffectivePeriod(&(usAllDataType.stEffectivePeriod), pInData);
            else
            {
            	memcpy(&usAllDataType.stEffectivePeriod.m_stDateRange,&BACnetConfigData.m_stDateRange, sizeof(BACnetDateRange_t));//PR-19
            }
            pvData = &usAllDataType.stEffectivePeriod.m_stDateRange;
        }
        break;

        case PROP_LIST_OF_OBJECT_PROPERTY_REFERENCES:
		{
			/* Get pointer to Property value string */
            ListOfBACnetDevObjPropRef_t *pstListOfBACnetDevObjPropReff = NULL;

            if(NULL != pInData)
            {            
                pstListOfBACnetDevObjPropReff = OSAL_Malloc(sizeof(ListOfBACnetDevObjPropRef_t),
                    __FILE__,__FUNCTION__, __LINE__);
                if(NULL == pstListOfBACnetDevObjPropReff)
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer:Convert_InStr_AddProperty : \
                        pstListOfBACnetDevObjPropReff pointer Malloc Failed\r\n");
					#endif
                    return BACDEL_MALLOC_ERROR;
                }
                GetLISTObjPropReff(pstListOfBACnetDevObjPropReff, pInData);
            }
            pvData = pstListOfBACnetDevObjPropReff;
        }
        break;

        case PROP_EXCEPTION_SCHEDULE:
        {          
            ListOfSpecialEvent_t *pstExceptionSchedule = NULL;
            if(NULL != pInData)
            {
                pstExceptionSchedule = OSAL_Malloc(sizeof(ListOfSpecialEvent_t),__FILE__,__FUNCTION__, __LINE__);
                if(NULL == pstExceptionSchedule)
                {
					#ifdef DEBUG_PRINTF
                    Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer:Convert_InStr_AddProperty : \
                        pstExceptionSchedule pointer Malloc Failed\r\n");
					#endif
                    return BACDEL_MALLOC_ERROR;
                }
                GetExcepSchedParsing(pstExceptionSchedule, pInData);
                pvData = pstExceptionSchedule;
            }
            else
                pvData = NULL;
        }
        break;

        case PROP_WEEKLY_SCHEDULE:
		{
            if(NULL != pInData)
                GetWeeklySchedParsing(&(usAllDataType.stWeeklySchedule), pInData);            
            pvData = &usAllDataType.stWeeklySchedule;
        }
        break;

        case PROP_SCHEDULE_DEFAULT:
		{
            if(NULL != pInData)
                GetDefaultValuePars(&usAllDataType.stAnyValue,pInData);
            pvData = &usAllDataType.stAnyValue.m_stValue;
        }
        break;
#endif /* BACDEL_OBJ_SDL */

        case PROP_PRESENT_VALUE:
        case PROP_RELINQUISH_DEFAULT:
        {
            /* switch as per object type */
            switch(eObjType)
            {
                default:
                    pvData = pvInData;
                    break;
            }
        }
        break; 

        case PROP_DESCRIPTION :
        case PROP_OBJECT_NAME:
        case PROP_PROFILE_NAME:
        case PROP_DEVICE_TYPE:
        case PROP_INACTIVE_TEXT:
        case PROP_ACTIVE_TEXT:
        case PROP_FILE_TYPE:
        case PROP_VENDOR_NAME:
        case PROP_MODEL_NAME:
        case PROP_FIRMWARE_REVISION:
        case PROP_APPLICATION_SOFTWARE_VERSION:
        case PROP_LOCATION:
        {
            uint32_t u32StrLen = 0;
            /* Get Length of string */
            u32StrLen = Strnlen(pvInData, MAX_CHARACTER_STRING_BYTES);
            /* Copy string into the structure */
            memcpy(&usAllDataType.stCharString.m_pu8CharStr[0], pvInData, u32StrLen);
            /* Copy string into structure */
            usAllDataType.stCharString.m_u32StrLen = u32StrLen;
            /* get Pointer */
            pvData = &usAllDataType.stCharString;
        } 
        break; 
        /* For array of 3 event time stamps - read only access */
        case PROP_EVENT_TIME_STAMPS:
        {
            /* Making all date and time independed of input data.
            Because this property read only and updates at run time */
#if defined STAMP_AS_DATETIME
			/* if stamp is datetime or time then the default value as per std. is X'FF */
            memset((void *)&usAllDataType.stEventTimeStamps,0xFF,sizeof(Pr_BACnetEventTimeStamp_t));
            usAllDataType.stEventTimeStamps.m_eTimeStampType[0] = TIMESTAMP_TYPE_DATETIME;
            usAllDataType.stEventTimeStamps.m_eTimeStampType[1] = TIMESTAMP_TYPE_DATETIME;
            usAllDataType.stEventTimeStamps.m_eTimeStampType[2] = TIMESTAMP_TYPE_DATETIME;
#endif
			pvData = &usAllDataType.stEventTimeStamps;
        }
        break;
		/* default case */
        default:
        {
            /* For remain properties send void pointer as it is */
            pvData = pvInData;
        }
        break;       
    }/* End of Switch Case */

    /* Device object having its own specific properties */
    if(eObjType == OBJECT_DEVICE)
    {
        eFunRet = Init_Device_Prop(pVirtualDev, eObjType,
                    eDevProp, i32ArrayIndex, pvData, ePermission, pvPropAdd);
    }
    else
    {
        eFunRet = InitCommonProperty(pVirtualDev, pvObject, u32ObjectID,
                    eDevProp, i32ArrayIndex, eObjType,
                    pvData, ePermission, pvPropAdd, bRemoteDev);
    }                          

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Convert_InStr_AddProperty : Exit \r\n"); 
	#endif
    return eFunRet;
}

/* function to convert property application tag type to property data type */
BACNET_DATA_TYPE Convert_AppTagType_To_DataType(BACNET_APPLICATION_TAG eTagType)
{
	/* local variables */
	BACNET_DATA_TYPE eDataType = BACNET_DT_EMPTY;

	switch(eTagType)
	{
	case BACNET_APPLICATION_TAG_NULL:
	{
		/* change data type to null */
		eDataType = BACNET_DT_NULL;
	}
	break;

	case BACNET_APPLICATION_TAG_BOOLEAN:
	{
		/* change data type to boolean */
		eDataType = BACNET_DT_BOOLEAN;
	}
	break;

	case BACNET_APPLICATION_TAG_UNSIGNED_INT:
	{
		/* change data type to unsigned32 */
		eDataType = BACNET_DT_UNSIGNED32;
	}
	break;

	case BACNET_APPLICATION_TAG_SIGNED_INT:
	{
		/* change data type to signed32 */
		eDataType = BACNET_DT_INTEGER;
	}
	break;

	case BACNET_APPLICATION_TAG_REAL:
	{
		/* change data type to real */
		eDataType = BACNET_DT_REAL;
	}
	break;

	case BACNET_APPLICATION_TAG_ENUMERATED:
	{
		/* change data type to enum */
		eDataType = BACNET_DT_ENUM;
	}
	break;

	default:
	{	
		/* change data type to empty */
		eDataType = BACNET_DT_EMPTY;
	}
	break;
	}

	/* return the data type */
	return eDataType;
}

/* function to convert property data type to property application tag type */
BACNET_APPLICATION_TAG Convert_DataType_To_AppTagType(BACNET_DATA_TYPE eDataType)
{
	/* local variables */
	BACNET_APPLICATION_TAG eTagType = BACNET_APPLICATION_TAG_NULL;

	switch(eDataType)
	{
	default:
	{	
		/* change tag type to null */
		eTagType = BACNET_APPLICATION_TAG_NULL;
	}
	break;
	}

	/* return the data type */
	return eTagType;
}

/** register properties for RPM */
void Register_Object_Property(BACNET_OBJECT_TYPE eObjType,
                                BACNET_PROPERTY_ID eDevProp)
{
//#ifdef BACDEL_SER_DS_RPM_B
    /* local variables */
    special_property_list_t stPropertyList;

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Register_Object_Property : Entry \r\n"); 
	#endif
    
    /* Get property list for Input Object Type */
    Device_Objects_Property_List(eObjType, &stPropertyList);

	if(NULL != stPropertyList.Required.pList)
	{
    	/* Check property is Required or Optional */
    	while (*stPropertyList.Required.pList != ENDOFPROPLIST)
    	{
        	if(eDevProp == *stPropertyList.Required.pList)
            	break;
        	else
            	stPropertyList.Required.pList++;
    	}
	}
    
    /* If its not Required, Add Property in Optional property List */
    if(NULL != stPropertyList.Required.pList)
	{
		if(*stPropertyList.Required.pList == ENDOFPROPLIST)
		{
			/* Check property is already exist in Optional */
			while (*stPropertyList.Optional.pList != ENDOFPROPLIST)
			{
				if(eDevProp == *stPropertyList.Optional.pList)
					break;
				else
					stPropertyList.Optional.pList++;
			}

			/* If not present already, Add property to optional property list */
			if(*stPropertyList.Optional.pList == ENDOFPROPLIST)
			{
				*stPropertyList.Optional.pList = eDevProp;
				stPropertyList.Optional.pList++;
				*stPropertyList.Optional.pList = ENDOFPROPLIST;
			}
		}
	}

    /* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Register_Object_Property : Exit \r\n"); 
	#endif
//#endif
}


BACNET_RETURN_TYPE Check_Object_Name(uint32_t u32DeviceId, int8_t *pi8InObjectName,
                                     uint16_t *peObjectType, uint32_t *pu32ObjId)
{
	/* local variables */
    virtualDevData_t *pVirtualDev = NULL;
    uint32_t u32ObjNameLen = 0;
    uint32_t u32InStringLen = 0;
    ListOfObjId_t *pstTempObjList = NULL;
    ulong32_t ul32BaseAddr = 0;     /* For Base struct Addr */
    ulong32_t ul32OffsetAddr = 0 ;  /* For Data offset Addr */
    void *pvNext = NULL;
	void *FObject = NULL;
      
	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Check_Object_Name : Entry \r\n"); 
	#endif

    /* Check the Host Device Link List */
    pVirtualDev = Find_In_Host_Device_List(u32DeviceId);
    if(NULL == pVirtualDev)
    {
		#ifdef DEBUG_PRINTF
        Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:Check_Object_Name :"
            "Host Device Not Found \r\n"); 
		#endif
        return BACDEL_DEVICE_NOT_PRESENT;
    }

    /* get the input string length */
    u32InStringLen = Strnlen(pi8InObjectName, MAX_CHARACTER_STRING_BYTES);

    /* get object name string length */
    u32ObjNameLen = Strnlen(pVirtualDev->m_stDevObject.m_stObjName.m_stCHARString.m_pu8CharStr, 
        MAX_CHARACTER_STRING_BYTES);

    /* Compare Device object name with Input name */
     if(!Strncmp(pi8InObjectName, pVirtualDev->m_stDevObject.
         m_stObjName.m_stCHARString.m_pu8CharStr, 
         (u32InStringLen > u32ObjNameLen ? u32InStringLen : u32ObjNameLen)))
     {
		#ifdef DEBUG_PRINTF
        Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:Check_Object_Name :"
            "BACDEL_DUPLICATE_OBJECT_NAME\r\n"); 
		#endif
        if((NULL != peObjectType) && (NULL != pu32ObjId))
        {
        *peObjectType = pVirtualDev->m_stDevObject.m_stObjectID.m_eObjectType;
        *pu32ObjId = pVirtualDev->m_stDevObject.m_stObjectID.m_u32ObjId;
        }
        return BACDEL_DUPLICATE_OBJECT_NAME;
     }

    /* Check all other objects in device */
    pstTempObjList = pVirtualDev->m_stDevObject.m_stObjectIDList.m_pstArrayObjId;

    while(NULL != pstTempObjList)
    {
        /* save next */
        pvNext = pstTempObjList->m_pstNext;

        /* find object base address  */        
		FObject = Find_Object(pstTempObjList->m_stObjectId.m_eObjectType,
                                              pstTempObjList->m_stObjectId.m_u32ObjId,pVirtualDev);

		ul32BaseAddr = (ulong32_t)FObject;
		/* check if this object was found */
		if(0 == ul32BaseAddr)
		{
			/* Move to next object in the list */
			pstTempObjList = pvNext;
			continue;
		}

        /* Update String length value */
		GET_ALLOBJ_OFFSET(pstTempObjList->m_stObjectId.m_eObjectType, 
                            m_stObjName.m_stCHARString.m_pu8CharStr, 
                            ul32OffsetAddr);

        /* get object name string length & compare strings */
        u32ObjNameLen = Strnlen(((void*)(ul32OffsetAddr+ul32BaseAddr)), 
            MAX_CHARACTER_STRING_BYTES);

        /* compare object name */
        if(!Strncmp(pi8InObjectName, 
                    ((void*)(ul32OffsetAddr+ul32BaseAddr)),
                    (u32InStringLen > u32ObjNameLen ? u32InStringLen : u32ObjNameLen)))
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:Check_Object_Name :"
                "BACDEL_DUPLICATE_OBJECT_NAME\r\n"); 
			#endif
            if((NULL != peObjectType) && (NULL != pu32ObjId))
            {
				*peObjectType = pstTempObjList->m_stObjectId.m_eObjectType;
                *pu32ObjId = pstTempObjList->m_stObjectId.m_u32ObjId;
            }
            return BACDEL_DUPLICATE_OBJECT_NAME;
        }
        
        /* Move to next object in the list */
        pstTempObjList = pvNext;
    }

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:Check_Object_Name : Exit \r\n"); 
	#endif
    return BACDEL_SUCCESS;
}

/**
*
*DESCRIPTION
*   Update Given memory location with the input data as per Object Type 
*   (i.e. Data Type of Object)
*    
*@param eObjectType [in] - Object Type
*@param ul32Address [in/out] - Memory address, where data to be filled 
*@param pvData [in] - Void pointer to Data
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/
BACNET_RETURN_TYPE UpdateObjectValue(BACNET_OBJECT_TYPE eObjectType, 
                                ulong32_t ul32Address, void *pvData)
{
    /* Function return type */
    BACNET_RETURN_TYPE eFuncRet = BACDEL_SUCCESS;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdateObjectValue : Entry \r\n"); 
	#endif

    switch(eObjectType)
    {
        case OBJECT_ANALOG_INPUT:
        case OBJECT_ANALOG_OUTPUT:
        case OBJECT_ANALOG_VALUE:
        {           
            /* Copy data into property Address */
            memcpy((void *)(ul32Address), (Float_t *)pvData, 
                sizeof(Float_t));
        }
        break;
        case OBJECT_BINARY_INPUT:
        case OBJECT_BINARY_OUTPUT:
        case OBJECT_BINARY_VALUE:
        {           
            /* Copy data into property Address */
            memcpy((void *)(ul32Address), (BACNET_BINARY_PV *)pvData, 
                sizeof(BACNET_BINARY_PV));
        }
        break;
        case OBJECT_MULTI_STATE_INPUT:
        case OBJECT_MULTI_STATE_OUTPUT:
        case OBJECT_MULTI_STATE_VALUE:
        {
            /* Copy data into property Address */
            memcpy((void *)(ul32Address), (uint32_t *)pvData,
                sizeof(uint32_t));
        }
        break;

        default:
        {
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL1,"BACnetStackAppLayer:UpdateObjectValue : BACDEL_ERROR\r\n"); 
			#endif
            eFuncRet = BACDEL_ERROR;
        }
        break;
    }/* End of Switch*/

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdateObjectValue : Exit \r\n"); 
	#endif

    return eFuncRet;
}

/**
*
*DESCRIPTION
*   Return Non NULL priority index offset address, if no Non null
*   index found returns zero
*
*@param eObjectType [in] Object Type
*@param ul32BaseAddr [in] Object base address
*@param u32ValueOffset [in] Priority value offset address
*@param i8DataLength [in] Length of data
*@return uint32_t [out] Address of Non null index or Zero
*
*/
//static ulong32_t GetNonNullPriorityOffset(BACNET_OBJECT_TYPE eObjectType,
//                             ulong32_t ul32BaseAddr,
//                             ulong32_t ul32ValueOffset,
//                             int32_t i32DataLength)
static ulong32_t GetNonNullPriorityOffset(BACNET_OBJECT_TYPE eObjectType,
                             ulong32_t ul32BaseAddr,
                             ulong32_t ul32ValueOffset,
                             int32_t i32DataLength,
							 uint32_t *pu32CmdPriority
							 )
{
    ulong32_t u32Offset = 0;
    ulong32_t u32OffsetBackup = 0;
    int8_t   i8Index = 0;
    
	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetNonNullPriorityOffset : Entry \r\n"); 
	#endif

    /* Get Priority array index tag offset */
    GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_bTagType, u32Offset);   
    /* Keep offset as backup */
    u32OffsetBackup = u32Offset;

    /* reset current command priority value */
    	*pu32CmdPriority = 0;

    /* Search for higher priority index non null value */
    for(i8Index = 0 ; i8Index < MAX_PRIORITY_ARRAY_COUNT ; i8Index++)
    {   
        /* Read Data tag and check whether data is null of not */               
        u32Offset += (i8Index*(sizeof(bool_t)));

        if(*((bool_t *)(ul32BaseAddr+u32Offset)) != 
                                (bool_t)BACNET_APPLICATION_TAG_NULL)
        {
            ul32ValueOffset += (i8Index * i32DataLength);
			#ifdef DEBUG_PRINTF
            Print_DebugMsg(DEBUG_LEVEL2,"BACnetStackAppLayer:GetNonNullPriorityOffset :"
                "Returning Non Null Priority Offset\r\n"); 
			#endif
            *pu32CmdPriority = i8Index + 1;
            return (ul32BaseAddr + ul32ValueOffset);
        }
        /* Retain Offset address from backup */
        u32Offset = u32OffsetBackup;
        
    }/* End of For loop */
 
	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:GetNonNullPriorityOffset : Exit \r\n"); 
	#endif

    /* No non null value found */
    return BACNET_ZERO;   
}

/**
*
*DESCRIPTION
*   Based on priority updated present value and priority array
*    
*@param ul32BaseAddr [in] - Address of give index
*@param pvData [in] - Void pointer of data
*@param eObjectType [in] - Object Type
*@param void * [out] - Pointer to data to be filled with Addcommonproperty
*                      function    
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/
void * UpdateWriteDataOnPriority(ulong32_t ul32BaseAddr, void *pvData,
                                        int32_t i32ArrayIndex, BACNET_OBJECT_TYPE 
                                        eObjectType, bool bWriteNULL,
										uint32_t *pu32CmdPriority)
{
	/* local variables */
	ulong32_t    ul32ValOffset = 0;
	ulong32_t    ul32RelinqushOffSet = 0;
    ulong32_t    ul32Offset  = 0;
    ulong32_t    ul32ReadPreValOffset = 0;
    int32_t      i32Len = 0;
    bool_t       bDataType = 0; /* to get tag type */

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdateWriteDataOnPriority : Entry \r\n"); 
	#endif

	/* Get Offset of Relinquish default value for given object */
	GET_RELINQUISH_VAL_OFFSET(eObjectType, m_stRelinquishDefault,		
		ul32RelinqushOffSet, i32Len);

    /* Applicable only to objects, which have priority array */
    switch(eObjectType)
    {
        case OBJECT_ANALOG_OUTPUT:
        case OBJECT_ANALOG_VALUE:
        {
            /* Get the offset of Priority array property */
            GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue.      
                m_fVal, ul32ValOffset);
            bDataType = (bool_t)BACNET_APPLICATION_TAG_REAL;
        }
        break;

        case OBJECT_BINARY_OUTPUT:
        case OBJECT_BINARY_VALUE:
        {
            /* Get the offset of Priority array property */
            GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue.		 
                m_eVal, ul32ValOffset);
            bDataType = (bool_t)BACNET_APPLICATION_TAG_ENUMERATED;
        }
        break;

        case OBJECT_MULTI_STATE_OUTPUT:
        case OBJECT_MULTI_STATE_VALUE:
        {
            /* Get the offset of Priority array property */
           GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue.				 
                m_u32Val, ul32ValOffset);
            bDataType = (bool_t)BACNET_APPLICATION_TAG_UNSIGNED_INT;
        }
        break;

        /* default case */
        default:
        break;
    }/* End of Switch Case*/

    /* True indicates Write NULL for present value */
    if(bWriteNULL == true)
        bDataType = (bool_t)BACNET_APPLICATION_TAG_NULL;

    /* Check Priority array offset */
    if(ul32ValOffset != BACNET_ARRAY_ALL && ul32ValOffset != 0)
    {
        /* Get Offset value of priority array for given priority */
        ul32Offset  = ul32ValOffset + ((i32ArrayIndex)*i32Len);
        /* Update value of priority array for given priority */
        memcpy((void *)(ul32BaseAddr+ul32Offset),(int32_t *)pvData , i32Len);

        /* Get Offset datatype of priority array for given priority */
        GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_bTagType, ul32Offset);			 
        /* Update datatype of priority array for given priority  */
        ul32Offset += (i32ArrayIndex*(sizeof(bool_t)));
        /* Update datatype of priority array for given priority  */
        memcpy((void *)(ul32BaseAddr+ul32Offset), &bDataType, sizeof(bool_t));

        ul32ReadPreValOffset = GetNonNullPriorityOffset(eObjectType, ul32BaseAddr,
        			ul32ValOffset, i32Len, pu32CmdPriority);

        /* Revert back */
        bWriteNULL = false;

        if(ul32ReadPreValOffset)
			pvData = (void *)(ul32ReadPreValOffset);
        /* All Array elements are NULL */
        else
			pvData = (void *)(ul32BaseAddr+ul32RelinqushOffSet);
    }/* End of if condition */

	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdateWriteDataOnPriority : Exit \r\n"); 
	#endif

    return pvData;
}

/**
*
* DESCRIPTION
* Function to get current highest priority in the priority array.
* Priority is returned as 0 is relinquish default is assigned.
*
* @param ul32BaseAddr	  [in]	base address of object
* @param eObjectType	  [in]  object Type
* @param pu32CmdPriority  [out] highest priority value
* @param pvData		      [in]  pointer for the received data
* @param i32ArrayIndex	  [in]  priority received in wp request
* @param eBackupDatatype  [in]  backup datatype
*
* @return void pointer
*
*/
void *GetCommandPriority(ulong32_t ul32BaseAddr,
	BACNET_OBJECT_TYPE eObjectType, uint32_t *pu32CmdPriority,
	void *pvData, int32_t i32ArrayIndex, BACNET_DATA_TYPE eBackupDatatype)
{
	/* local variables */
	ulong32_t ul32ValOffset = 0;
	ulong32_t ul32RelinqushOffSet = 0;
    ulong32_t ul32ReadPreValOffset = 0;
    int32_t i32Len = 0;
	void *pvBkupValue = NULL;
	BACNET_APPLICATION_TAG eTagType = BACNET_APPLICATION_TAG_NULL;
	ulong32_t u32Offset = 0;

	/* function entry */
	#if(defined DEBUG_PRINTF && DL_3)
    Print_DebugMsg(DEBUG_LEVEL3, BACDEL_ENTRY_MESSAGE,
		"APDU: GetCommandPriority: Entry \r\n");
	#endif

	/* get offset of relinquish default value for given object */
	GET_RELINQUISH_VAL_OFFSET(eObjectType, m_stRelinquishDefault,
		ul32RelinqushOffSet, i32Len);

	/* save the recieved value for backup */
	pvBkupValue = pvData;

    /* applicable only to objects, which have priority array */
    switch(eObjectType)
    {
        case OBJECT_ANALOG_OUTPUT:
        case OBJECT_ANALOG_VALUE:
        {
            /* get the offset of priority array property */
            GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue.
                m_fVal, ul32ValOffset);
			/* save tag type */
			//eTagType = BACNET_APPLICATION_TAG_REAL;
        }
        break;

        case OBJECT_BINARY_OUTPUT:
        case OBJECT_BINARY_VALUE:
        {
            /* get the offset of priority array property */
            GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue.
                m_eVal, ul32ValOffset);
			/* save tag type */
			//eTagType = BACNET_APPLICATION_TAG_ENUMERATED;
        }
        break;

        case OBJECT_MULTI_STATE_OUTPUT:
        case OBJECT_MULTI_STATE_VALUE:
        {
            /* get the offset of priority array property */
            GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue.
                m_u32Val, ul32ValOffset);
			/* save tag type */
			//eTagType = BACNET_APPLICATION_TAG_UNSIGNED_INT;
        }
        break;
        /* default case */
        default:
        break;
    }

	if(BACNET_DT_NULL == eBackupDatatype)
	{
		/* get priority array index tag offset */
		GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_bTagType, u32Offset);
		/* calculate offset of respective index */
        u32Offset += (i32ArrayIndex*(sizeof(bool_t)));
		/* save tag type for backup */
		eTagType = *((bool_t *)(ul32BaseAddr+u32Offset));
		/* change the tag type temperorily */
        *((bool_t *)(ul32BaseAddr+u32Offset)) = (bool_t)BACNET_APPLICATION_TAG_NULL;
	}

    /* get non null value pointer i.e. highest priority value */
    ul32ReadPreValOffset = GetNonNullPriorityOffset(eObjectType, ul32BaseAddr,
		ul32ValOffset, i32Len, pu32CmdPriority);

	if(BACNET_DT_NULL == eBackupDatatype)
	{
		/* restore the tag type */
		*((bool_t *)(ul32BaseAddr+u32Offset)) = eTagType;
	}

	if(ul32ReadPreValOffset)
		pvData = (void *)(ul32ReadPreValOffset);
    /* all array elements are null */
    else
		pvData = (void *)(ul32BaseAddr+ul32RelinqushOffSet);

	/* check for current and received priority */
	if((BACNET_ZERO == *pu32CmdPriority || (*pu32CmdPriority >= (uint32_t)(i32ArrayIndex + 1)))
		&& BACNET_DT_NULL != eBackupDatatype)
	{
		/* overwrite the value with received value */
		pvData = pvBkupValue;
	}

	/* function exit */
	#if(defined DEBUG_PRINTF && DL_3)
    Print_DebugMsg(DEBUG_LEVEL3, BACDEL_EXIT_MESSAGE,
		"APDU: GetCommandPriority: Exit \r\n");
	#endif
    return pvData;
}


/**
*
*DESCRIPTION
*   Update Present value property with the given data based on Object Type
*
*@param eObjType [in] Type of Object of which property needs to be Initialize.
*@param ul32BaseAddr [in/out] Base address of the object.
*@param pvData [in] Initialization value.
*@param ePermission [in] Access permission for property.
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/
static BACNET_RETURN_TYPE UpdatePresentValue(BACNET_OBJECT_TYPE eObjectType,
                        ulong32_t *pul32BaseAddr, void *pvData, int32_t i32ArrayIndex,
                        PROP_ACCESS_TYPE ePermission, bool bInitFunctionality, 
                        bool bRemoteDevFlag, bool bWriteNULL,
						void *pVirtualDev, void **pvPresentVal,
						uint32_t *pu32CmdPriority)
{
    ulong32_t ul32OffsetAddr = 0;
    ulong32_t ul32BackupPVOffset = 0;
    uint8_t u8OutofService = 0;
    ulong32_t ul32BaseAddr = 0;
    /* Function Retrun Type */
    BACNET_RETURN_TYPE eFuncRet = BACDEL_SUCCESS;
    void        *pvUpdateData = NULL;
    PROP_ACCESS_TYPE    eAccessType = BACNET_DEFAULT;
    /* hold Sizeof */
    int32_t i32Len = 0;

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdatePresentValue : Entry \r\n"); 
	#endif

    ul32BaseAddr = *pul32BaseAddr;

   /* Get OutofService value */
    GET_OOS_OFFSET(eObjectType,m_stOutOfService.m_bVal, ul32OffsetAddr);  
                                                                                        
    /* If Outofservice is True, Read dummy logic value */
    memcpy((void *)&u8OutofService, (void *)(ul32OffsetAddr+ul32BaseAddr), sizeof(uint8_t));

	switch(eObjectType)
	{
#ifdef BACDEL_OBJ_CAL
		case OBJECT_CALENDAR:
		{
			bool bData = false;
			bData = Calendar_Get_Present_Value(ul32BaseAddr, pVirtualDev);
			GET_PRESENTVAL_OFFSET(eObjectType, m_stPresentValue, ul32OffsetAddr, i32Len);
			/* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), &bData, i32Len);
			*pul32BaseAddr = (ul32BaseAddr + ul32OffsetAddr);
			break;
		}
#endif
#ifdef BACDEL_OBJ_SDL
		case OBJECT_SCHEDULE:
		{
			Get_PresentValue_ForSchedule(ul32BaseAddr, pvData, (int8_t)i32ArrayIndex, pVirtualDev, bWriteNULL);
			break;
		}
#endif
		default:
		{
			/* For all analog, Binary & Multi-State objects */
			/* If Called from BACDEL_HW_Update_Val() update Backup present value
				No need to update priority array */
			if(!bRemoteDevFlag)
			{
				if(bInitFunctionality)
				{
					/* Get BackupPresent value offset */
					GET_PRESENTVAL_OFFSET(eObjectType,m_stBackupPresentValue,ul32BackupPVOffset, i32Len);   

                    memcpy((void *)(ul32BackupPVOffset+ul32BaseAddr), pvData, i32Len);
				}
#ifndef pv_simulation_or_exp_api_call
                /* priority array is not updated when pv is changed from exported api
                viz. BACDEL_HW_Update_Val() or simulation , etc. */
				else
				{
#else
                /* need to update priority array during simulation also */
                if(BACNET_ARRAY_ALL == i32ArrayIndex)
                    i32ArrayIndex = 0;
#endif
					/* Check of Present Value is Commandable, if yes then Write Priority array */
					eAccessType = GetDefndPropAccess(eObjectType, PROP_PRESENT_VALUE, eAccessType);

					/* Update Priority array and get pointer of data to write in PV variable as per 
						priority mechanism */
					if(eAccessType == COMMANDABLE_PROP)
					{
						pvUpdateData = UpdateWriteDataOnPriority(ul32BaseAddr, pvData, 
						    (uint8_t)i32ArrayIndex, eObjectType, bWriteNULL, pu32CmdPriority);
						if(pvUpdateData == NULL)
						{
							;
							#ifdef DEBUG_PRINTF
							Print_DebugMsg(DEBUG_LEVEL2,"BACnetStackOsalLayer:UpdatePresentValue : NULL Pointer\r\n");                     
							#endif
						}
						else
						{
							/* Update data pointer with Priority Array Value 
								& then update object value */
							pvData = pvUpdateData;
						}
					}
#ifndef pv_simulation_or_exp_api_call
				}
#endif
			}//if(!bRemoteDevFlag) ends
		    
#ifdef pv_simulation_or_exp_api_call
			/* during simulation out of service is not checked */
			if((bInitFunctionality) ||
				(!bInitFunctionality) || (bRemoteDevFlag) )
#else
			/* Update PV if BACDEL_HW_Update_Val() and OS is FALSE or
				WP-B service is called */
			if((bInitFunctionality && !u8OutofService) ||
				(!bInitFunctionality) || bRemoteDevFlag )
#endif
			{
				/* Get Present value offset based on outofservice */
				ul32OffsetAddr = GetPresentValOffset(eObjectType, u8OutofService);    

				/* Present Value Offset memory is updated with the input data */    
				eFuncRet = UpdateObjectValue(eObjectType, (ul32OffsetAddr+ul32BaseAddr), 
												pvData);
			}
		}//default ends.
		break;
	}//switch ends.

    /* return the pointer of current present value */
    if(NULL != pvPresentVal)
        *pvPresentVal = pvData;
	/* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdatePresentValue : Exit \r\n"); 
	#endif
    
    return eFuncRet;
}
/**
*
* DESCRIPTION
* Function set Event_State, Acked_Transitions, Event_Time_Stamps
* and Event_Message_Texts to their respective initial conditions.
*
* @param eObjectType  [in] Object Type
* @param pvObject	  [in] Object base address
* @param pvVirtualDev [in] Virtual device pointer.
*
* @return [out] nothing.
*
*/
void Update_EventEnableDetection_Dependent_Properties(
	BACNET_OBJECT_TYPE eObjectType,
	void *pvObject,
	void *pvVirtualDev)
{
	/* local variable */
	void *pvData = NULL;
	void *pvDummy = NULL;
	uint32_t u32PropertyAdd = 0;
    BACNET_EVENT_STATE eEventState = MAX_EVENT_STATE;
	BACNET_TIMESTAMP_TYPE eTimeStampType = MAX_TIMESTAMP_TYPE;
	Pr_BACnetBitStr_t stAckTransition = {0};
	Pr_BACnetEventTimeStamp_t stEventTimeStamp = {0};
	Pr_BACnetEventMsgText_t stEventMsgText = {0};

	/* function entry */
	#if(defined DEBUG_PRINTF && DL_3)
    Print_DebugMsg(DEBUG_LEVEL3, BACDEL_ENTRY_MESSAGE, "APDU: \
    Update_EventEnableDetection_Dependent_Properties: Entry \r\n");
	#endif

	/* check input pointer */
	if(NULL == pvObject || NULL == pvVirtualDev)
	{
		/* invalid inputs pointer */
		#if(defined DEBUG_PRINTF && DL_0)
		Print_DebugMsg(DEBUG_LEVEL0, BACDEL_INVALID_INPUT_PARAMETER,"APDU: \
		Update_EventEnableDetection_Dependent_Properties: Null input pointers \r\n");
		#endif
		return;
	}

	/* event state initial value */
	eEventState = EVENT_STATE_NORMAL;
	pvData = &eEventState;
	/* update event state */
	/* note : send remode-device flag as true, so that nofitication is not generated */
	/* access type is always read-only */
    UpdateCommonProperty(eObjectType, pvObject, PROP_EVENT_STATE,
        -1, pvData, READ_ONLY, &u32PropertyAdd, &pvDummy, pvVirtualDev,
        false, true, false);

	stAckTransition.m_stBitStr.m_u8ByteCnt = 1;
	stAckTransition.m_stBitStr.m_u8UnusedBits = 5;
	stAckTransition.m_stBitStr.m_u8TransBits[0] = 7; // all bits true
    pvData = &stAckTransition;
	/* update Ack Transitions */
	/* access type is always read-only */
    UpdateCommonProperty(eObjectType, pvObject, PROP_ACKED_TRANSITIONS,
        -1, pvData, READ_ONLY, &u32PropertyAdd, &pvDummy, pvVirtualDev,
        false, false, false);

	/* event time stamps initial value */
	memset(&stEventTimeStamp, 0xFF, sizeof(Pr_BACnetEventTimeStamp_t));

#ifdef STAMP_AS_DATETIME
	eTimeStampType = TIMESTAMP_TYPE_DATETIME;
#endif
	stEventTimeStamp.m_eTimeStampType[0] = eTimeStampType;
	stEventTimeStamp.m_eTimeStampType[1] = eTimeStampType;
	stEventTimeStamp.m_eTimeStampType[2] = eTimeStampType;
	pvData = &stEventTimeStamp;
	/* update Event Time Stamps */
	/* access type is always read-only */
    UpdateCommonProperty(eObjectType, pvObject, PROP_EVENT_TIME_STAMPS,
        -1, pvData, READ_ONLY, &u32PropertyAdd, &pvDummy, pvVirtualDev,
        false, false, false);

	/* event message texts initial value */
	memset(&stEventMsgText, 0, sizeof(Pr_BACnetEventMsgText_t));
	pvData = &stEventMsgText;
	/* update Event Message Texts */
	/* access type is always read-only */
    UpdateCommonProperty(eObjectType, pvObject, PROP_EVENT_MESSAGE_TEXTS,
        -1, pvData, READ_ONLY, &u32PropertyAdd, &pvDummy, pvVirtualDev,
        false, false, false);

	/* function exit */
	#if(defined DEBUG_PRINTF && DL_3)
    Print_DebugMsg(DEBUG_LEVEL3, BACDEL_EXIT_MESSAGE, "APDU: \
    Update_EventEnableDetection_Dependent_Properties: Exit \r\n");
	#endif
}
/**
*
* DESCRIPTION
* Function update Event_State on event detection enable, event algorithm inhibit are true.
*
* @param eObjectType  [in] Object Type
* @param pvObject	  [in] Object base address
* @param pvVirtualDev [in] Virtual device pointer.
*
* @return [out] nothing.
*
*/
void UpdateEventStateProperty(
	BACNET_OBJECT_TYPE eObjectType,
	void *pvObject,
	void *pvVirtualDev)
{
	/* local variable */
	void *pvDummy = NULL;
	void *pvLocalData = NULL;
	ulong32_t ul32BaseAddr = 0 ;
	uint32_t u32PropertyAdd = 0;
    ulong32_t ul32OffsetAddr = 0 ;
	bool bReliabilityEvaEnhibit = true;
	PropertyValue_u	uPropertyValue = {0};
	BACNET_RELIABILITY eReliability = MAX_RELIABILITY;
	BACNET_EVENT_STATE eEventState = MAX_EVENT_STATE;
	BACNET_EVENT_STATE eEventStateTo = MAX_EVENT_STATE;

	/* function entry */
	#if(defined DEBUG_PRINTF && DL_3)
    Print_DebugMsg(DEBUG_LEVEL3, BACDEL_ENTRY_MESSAGE, "APDU: \
	UpdateEventStateProperty: Entry \r\n");
	#endif

	/* check input pointer */
	if(NULL == pvObject || NULL == pvVirtualDev)
	{
		/* invalid inputs pointer */
		#if(defined DEBUG_PRINTF && DL_0)
		Print_DebugMsg(DEBUG_LEVEL0, BACDEL_INVALID_INPUT_PARAMETER,"APDU: \
		UpdateEventStateProperty: Null input pointers \r\n");
		#endif
		return;
	}

	/* get the object base address */
    ul32BaseAddr = (ulong32_t )pvObject;

	/* get property offset address and value */
	GET_RELIABILITY_OFFSET(eObjectType, m_stReliability.m_eReliabilty, ul32OffsetAddr);
	memcpy((void *)&eReliability, (void *)(ul32BaseAddr+ul32OffsetAddr), sizeof(BACNET_RELIABILITY));

	/* check if reliability is other than no fault detected and reliability evalution enhibit is false,
	   then only go for below process */
	if(!bReliabilityEvaEnhibit && RELIABILITY_NO_FAULT_DETECTED != eReliability)
	{
		/* get property offset address and value */
		GET_EVENTSTATE_OFFSET(eObjectType, m_stEventState.m_eEventState, ul32OffsetAddr);
		memcpy((void *)&eEventState, (void *)(ul32BaseAddr+ul32OffsetAddr), sizeof(BACNET_EVENT_STATE));
		/* check if event state is other than fault, then only go for below process */
		if(EVENT_STATE_FAULT != eEventState)
		{
			eEventStateTo = EVENT_STATE_FAULT;
			pvLocalData = &eEventStateTo;

			/* save value of reliability property */
			u32PropertyAdd = (uint32_t)eReliability;

#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B)
			/* get the present value */
			if(NULL == pvDummy)
			{
				Get_Reference_Prop_Value(eObjectType, &uPropertyValue, pvObject);
				/* assign prop value */
				pvDummy = &uPropertyValue;
			}
#endif
			/* update the event state */
			UpdateCommonProperty(eObjectType, pvObject, PROP_EVENT_STATE,
				-1, pvLocalData, READ_ONLY, &u32PropertyAdd, &pvDummy,
				pvVirtualDev, false, false, false);
		}
	}
	else
	{
		#ifdef INTRINSIC_REPORTING
		/* check for intrinsic notification */
		Check_For_Intrinsic_Notification(eObjectType, pvObject, pvVirtualDev);
		#endif
	}

    /* function exit */
	#if(defined DEBUG_PRINTF && DL_3)
    Print_DebugMsg(DEBUG_LEVEL3, BACDEL_EXIT_MESSAGE, "APDU: \
	UpdateEventStateProperty: Exit \r\n");
	#endif
}

/**
*
*DESCRIPTION
*   Return Outofservice property value of given object
*
*@param ul32BaseAddr [in/out] Base address of the object.
*@param eObjectType [in] Object Type
*
*@return true or false
*/
bool IsOutofSerivceFlagTrue(ulong32_t ul32BaseAddr,
                                     BACNET_OBJECT_TYPE eObjectType)
{
    /* local variables */
    ulong32_t   ul32OffsetAddr = 0;
    bool        bReturnType = false;

    /* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:IsOutofSerivceFlagTrue : Entry \r\n"); 
	#endif

    /* Get Outofservice property offset */
    GET_OOS_OFFSET(eObjectType, m_stOutOfService.m_bVal, ul32OffsetAddr);    
    
    /* Copy data into property offset address */
    if(BACNET_NEGATIVE_ONE != (int32_t)ul32OffsetAddr)
    {
        /* copy only if valid offset address */
        memcpy(&bReturnType, (bool *)(ul32BaseAddr+ul32OffsetAddr), sizeof(bool));
    }

	/* these object types donot have out of service property */
	if(OBJECT_TRENDLOG == eObjectType || OBJECT_CALENDAR == eObjectType ||
        OBJECT_TREND_LOG_MULTIPLE == eObjectType || OBJECT_EVENT_LOG == eObjectType)
    {
        /* return false */
		bReturnType = false;
    }
	#ifdef BACDEL_OBJ_NP
	else if(OBJECT_NETWORK_PORT == eObjectType)
	{
		/* get out of service property value for network port object */
		GET_NETWORK_PORT_OFFSET(m_stOutOfService.m_bVal, ul32OffsetAddr);
		memcpy(&bReturnType, (bool *)(ul32BaseAddr+ul32OffsetAddr), sizeof(bool));
	}
	#endif
    /* function exit */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:IsOutofSerivceFlagTrue : Exit \r\n");                                        
	#endif
    return bReturnType;
}

/**
*
*DESCRIPTION
*   This API will Initialize the given property value with the input data 
*   for given object with the
*
*@param u32ObjectID - Object Id (Not usefule for device property)
*@param eObjType - Type of Object of which property needs to be Initialize.
*@param eDevProp - Property of object which is to be initialize.
*@param p_value - Initialization value.
*@param ePermission - Access permission for property.
*
*@return BACDEL_SUCCESS / BACDEL_ERROR
*/
BACNET_RETURN_TYPE UpdateCommonProperty(BACNET_OBJECT_TYPE eObjectType, 
                        void *pvObject, BACNET_PROPERTY_ID eDevProp, 
                        int32_t i32ArrayIndex, void *pvInData, 
                        PROP_ACCESS_TYPE ePermission,
                        uint32_t *pvPropertyPtr, void **pvPropAdd,
                        void *pvVirtualDev,bool bInitFunctionality,
                        bool bRemoteDevFlag, bool bWriteNULL)
{
	/* local variables */
    ulong32_t ul32BaseAddr = 0;     /* For Base struct Addr */
    ulong32_t ul32BaseAddrBackup = 0;
    ulong32_t ul32OffsetAddr = 0 ;  /* For Data offset Addr */
	uint8_t u8Data = 0;
    
    uint32_t u32Index = 0;          /* For index base write functionality */
    Pr_BACnetBitStr_t stBitString = {0};
    uint16_t    u16Data = 0;
    uint32_t    u32Data = 0;
    BACNET_PROPERTY_ID eDependentProp = MAX_PROP_SUPPORTED;
    BACNET_BINARY_PV    eBinaryPv;
	void *pvData = NULL;
	PROP_ACCESS_TYPE eAccessType = 0;
	virtualDevData_t *pVirtualDev = NULL;
	bool bChangeReliability = false;

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B)
    int32_t i32ActiveCOVValue = 0;
    int32_t *pvPropCovValue = NULL;
#endif

#if (defined BACDEL_SER_DS_COV_B || defined BACDEL_SER_DS_COVP_B || defined BACDEL_SER_AE_EN_B)
	/* local pointer for posting messages to notification thread */
	void *pvMsgQdata = NULL;
	/* struct to post message to notification thread */
	Post_Thread_Msg_t postThreadMsg = {0};
#endif

    bool        bOutofservice = false;
    /** API return value */
    BACNET_RETURN_TYPE  eFuncRet = BACDEL_SUCCESS; 
    
    /* Used to genereate Recursive function call itself */
    bool bRecursiveCall = false;

	/* To save Event State */
	BACNET_EVENT_STATE	eEventStateTo = 0;
	BACNET_EVENT_STATE	eEventStateFrom = 0;
	BACNET_RELIABILITY eReliabilty = MAX_RELIABILITY;
	/* reliablity */
	BACNET_RELIABILITY	eReliability = MAX_RELIABILITY;
	BACNET_RELIABILITY  eReliabilityFrom = MAX_RELIABILITY;
	BACNET_RELIABILITY  eReliabilityTo = MAX_RELIABILITY;

#ifdef BACDEL_SER_AE_GEI_B
	uint32_t *i32GetSummary = NULL;
#endif
	/* variables for intrinsic reporting */
#if ((defined INTRINSIC_REPORTING || defined ALGORITHMIC_REPORTING)&& defined BACDEL_SER_AE_EN_B)
	bool				bEventChange = false;
	uint32_t			u32TimeDelay = 0;
	PropertyValue_u		uPropertyValue = {0};
	bool				bGenerateNotifcation = FALSE;
	uint32_t			u32TimeDelayNormal = 0;
#endif

#if (defined ALGORITHMIC_REPORTING && defined BACDEL_SER_AE_EN_B)
	void *pvListData = NULL;
#endif 

#if (defined OPTIONAL_PROPERTY || defined BACDEL_OBJ_FILE)
	Pr_BACnetDateTime_t stDateTime = {0};
#endif

#ifdef OPTIONAL_PROPERTY
	ulong32_t ulTotalSec = 0;
	ulong32_t ulTotalInSec = 0;
	Pr_BACnetDateTime_t stInDateTime = {0};

#endif /* OPTIONAL_PROPERTY */

	/* function entry */
	#ifdef DEBUG_PRINTF
    Print_DebugMsg(DEBUG_LEVEL3,"BACnetStackAppLayer:UpdateCommonProperty : Entry \r\n"); 
	#endif

	/* Address of input data */
	pvData = pvInData;
    /* Get the Structure BaseAddress */
    ul32BaseAddr = (ulong32_t )pvObject;

	/* Get address of virtual device structure */
	pVirtualDev = (virtualDevData_t *)pvVirtualDev;

	if(NULL == pvVirtualDev || NULL == pvObject)
	{
		#ifdef DEBUG_PRINTF
		Print_DebugMsg(DEBUG_LEVEL0,"BACnetStackAppLayer: \
									UpdateCommonProperty : Null input pointers \r\n"); 
		#endif
		return BACDEL_ERROR;
	}
        
    /* Based on Property Type */
    switch(eDevProp)
    {
        /* Object Name */
        case PROP_OBJECT_NAME:
        {
            /* Update String length value */
            GET_OBJCOMMON_OFFSET(eObjectType , m_stObjName.m_stCHARString, 
                                ul32OffsetAddr);

            memset((void *)(ul32BaseAddr+ul32OffsetAddr), 0x00, sizeof(BACnetCharStr_t));

             /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                            sizeof(BACnetCharStr_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

        }
        break;
        case PROP_OBJECT_TYPE:
        {  
            /* Get Offset for Object Type member of Object ID Property */
            GET_OBJCOMMON_OFFSET(eObjectType , m_stObjectType.m_eObjectType, ul32OffsetAddr);
            memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, 
                                sizeof(BACNET_OBJECT_TYPE));

            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                                         sizeof(BACNET_OBJECT_TYPE));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;
        
        /* Present Value */
        case PROP_PRESENT_VALUE:
        {
			/* backup the present value data address */
            void *pvPresentVal = NULL;
			int32_t i32Len = 0;
			bool bUpdateStateCount = TRUE;
			uint32_t u32CmdPriority = 0;

            /* Update Present value property based on object type 
               (i.e. Data type )
               Note: BaseAddres get modify */
            ul32BaseAddrBackup = ul32BaseAddr;
            memcpy(&eBinaryPv,(BACNET_BINARY_PV *)pvData, 
                                            sizeof(BACNET_BINARY_PV));

			/* check if same PV is received for BI and BO */
			if(OBJECT_BINARY_OUTPUT == eObjectType ||
				OBJECT_BINARY_VALUE == eObjectType)
			{
				/* get present value offset */
				GET_PRESENTVAL_OFFSET(eObjectType, m_stPresentValue, ul32OffsetAddr, i32Len);  
				if(0 == memcmp((void *)(ul32BaseAddr + ul32OffsetAddr), pvData, i32Len))
				{
					/* current value and new value are same, reset flag */
					bUpdateStateCount = FALSE;
				}
			}

			/* call function to update PV */
			eFuncRet = UpdatePresentValue(eObjectType , &ul32BaseAddr, pvData,
										  i32ArrayIndex, ePermission,bInitFunctionality,
										  bRemoteDevFlag,bWriteNULL, pVirtualDev,
										  &pvPresentVal, &u32CmdPriority);
#ifdef BACDEL_PR18
			/* update current command priority property */
			if(COMMANDABLE_PROP == ePermission)
			{
				/* call function to update current command priority property */
				eFuncRet = UpdateCommonProperty(eObjectType, pvObject, PROP_CURRENT_COMMAND_PRIORITY,
									i32ArrayIndex, (void *)&u32CmdPriority, eAccessType, pvPropertyPtr, pvPropAdd, pvVirtualDev,
									bInitFunctionality, false, (!u32CmdPriority?true:false));
			}
#endif /* PR18 */


            /* Update polarity value in BI/BO PV structure for encoding */
#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO)
            if(eObjectType == OBJECT_BINARY_INPUT || eObjectType == OBJECT_BINARY_OUTPUT ) 
			{						
                Update_PV_Polarity(ul32BaseAddr, eObjectType);   
			}
#endif
                                
            *pvPropAdd = (void *)ul32BaseAddr;
                
#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO || defined BACDEL_OBJ_BV)
#ifdef OPTIONAL_PROPERTY
            /* Other than Add Property time, Change of state Count 
               should update */
#ifdef pv_simulation_or_exp_api_call
            /* NOTE : both state_count & state_time should update
                   during simulation as bInitFunctionality flag
                   is true during simulation */
            if(!bRemoteDevFlag &&(
#else
            if((!bInitFunctionality)&& !bRemoteDevFlag &&(
#endif
                (eObjectType == OBJECT_BINARY_INPUT)||
                (eObjectType == OBJECT_BINARY_OUTPUT)||
                (eObjectType == OBJECT_BINARY_VALUE)))
            {
                /* If State Change from ACTIVE To INACTIVE call back
                   Elapsed Active Time proprty to update its local data */
                bOutofservice = IsOutofSerivceFlagTrue(ul32BaseAddrBackup, eObjectType);
                if((!bOutofservice)&&(GetPolarity(ul32BaseAddrBackup,eObjectType)))     
                   eBinaryPv ^= 0x01;

                /* NOTE : elapsed_active_time property support is not given 
                          so commented, need to update logic */

				/* Update ElpasedActiveTime with the current time */
				/* Get the current time and update relevant structure */
				GetDevice_DateTime(&stDateTime.m_stDateTime.m_stDate, &stDateTime.m_stDateTime.m_stTime,
					pVirtualDev);

				/* check if binary pv is inactive, update elapsed active time */
				if(BINARY_INACTIVE == *((BACNET_BINARY_PV *)pvData))
				{
					#ifdef  __FREERTOS__
					/* convert date time value in to second */
					ulTotalSec = Convert_DateTime_InToSecond(&stDateTime);
					#endif

					/* Get base time from Change of state time Property */
					GET_BINARYONLY_OFFSET(eObjectType,m_stElaspsedActiveTime.
						stActiveStateTime, ul32OffsetAddr);

					/* Copy data into property offset address */
					memcpy(&stInDateTime, (void *)(ul32BaseAddrBackup+ul32OffsetAddr),
						sizeof(Pr_BACnetDateTime_t));

					#ifdef __FREERTOS__
					/* convert date time value in to second */
					ulTotalInSec = Convert_DateTime_InToSecond(&stInDateTime);
					#endif

					/* check time values are changed or not */
					if(ulTotalInSec != ulTotalSec)
					{
						/* Get base time from Change of state time Property */
						GET_BINARYONLY_OFFSET(eObjectType,m_stElaspsedActiveTime.
							stActiveElapseTime.m_u32Val, ul32OffsetAddr);
						/* Copy data into property offset address */
						memcpy(&u32Data, (void *)(ul32BaseAddrBackup+ul32OffsetAddr),
							sizeof(uint32_t));
						u32Data += (uint32_t)(ulTotalSec - ulTotalInSec);
					
						/* Copy data into property offset address */
						memcpy((void *)(ul32BaseAddrBackup+ul32OffsetAddr), &u32Data,
							sizeof(uint32_t));
					}/* End */
				} /* End of If Binary Pv is In Active */

				/* update current time */
				GET_BINARYONLY_OFFSET(eObjectType, m_stElaspsedActiveTime.
					stActiveStateTime, ul32OffsetAddr);

				/* Copy data into property offset address */
				memcpy((void *)(ul32BaseAddrBackup+ul32OffsetAddr), &stDateTime,
					sizeof(Pr_BACnetDateTime_t));

                /* FIXME: 1. Only if Out of service is FALSE  
                          2. Whenever State changes irrespective Out of service */
				/* for BO BV increment state count for different state transition only */
                if(bUpdateStateCount)
                {
                    /* Read the Count value and update it by calling back */
                    GET_BINARYONLY_OFFSET(eObjectType, m_stChangeOfStateCount.m_u16Val, 
                        ul32OffsetAddr);
                    memcpy(&u16Data, (uint16_t *)(ul32BaseAddr+ul32OffsetAddr), sizeof(uint16_t));
                    /* Increment count */                               
                    u16Data++;
                    pvData = &u16Data;
                    /* NOTE : making bWriteNULL true to indicate recursive call */ 
                    UpdateCommonProperty(eObjectType, pvObject, PROP_CHANGE_OF_STATE_COUNT,
                                           i32ArrayIndex, pvData, eAccessType, pvPropertyPtr, pvPropAdd, pVirtualDev,
#ifdef pv_simulation_or_exp_api_call
                        /* NOTE : both state_count & state_time should update
                           during simulation as bInitFunctionality flag
                           is true during simulation */
                        false, false, true);
#else
                        bInitFunctionality, false, true);
#endif
				  }
				/* Reintialize data into property offset address */
				ul32OffsetAddr = 0;   
            }
#endif /* OPTIONAL_PROPERTY */
#endif /* BI - BO - BV */

#if (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B)
		     /* Other than Add Property time, event state should update */
            if(!bRemoteDevFlag && Is_Reference_Prop_PV(eObjectType))
            {
			    /* call function to check if event_state needs to be updated */
			    eFuncRet = UpdateEventState(eObjectType, pvObject, pvPresentVal, 
										    &bEventChange, &eEventStateTo, &eEventStateFrom,
										    &eReliabilty,&uPropertyValue);


			    if(TRUE == bEventChange && BACDEL_ERROR != eFuncRet)
			    {
				    /* get time delay value based on event state */
				    Get_TimeDelay_value(eObjectType, pvObject, eEventStateTo, &u32TimeDelay);

				    /* add the data to event_state linklist for monitoring */
					Create_EventState_LinkList(PROP_PRESENT_VALUE, eObjectType, 
						(void*)ul32BaseAddr, eEventStateTo, eEventStateFrom,eReliabilty,
						&uPropertyValue, u32TimeDelay,u32TimeDelayNormal, pVirtualDev);
			    } // end of if(bEventChange == TRUE)
			}
#endif /* (defined INTRINSIC_REPORTING && defined BACDEL_SER_AE_EN_B) */
		}
        break;
        
        /* For Object Event Status */
        case PROP_EVENT_STATE:
        {
            eEventStateTo = *(BACNET_EVENT_STATE *)pvData;

            /* Update property offset */
			GET_EVENTSTATE_OFFSET(eObjectType, m_stEventState.m_eEventState,
				ul32OffsetAddr);

#if ((defined INTRINSIC_REPORTING || defined ALGORITHMIC_REPORTING) && defined BACDEL_SER_AE_EN_B)
			/* other than init functionality, check for event notification generation */
			if(!bInitFunctionality && !bRemoteDevFlag)
            {
				/* get the current event state */
				memcpy(&eEventStateFrom,(void *)(ul32BaseAddr+ul32OffsetAddr), 
					sizeof(BACNET_EVENT_STATE));
				/* check if notification needs to be generated */
				bGenerateNotifcation = Check_For_Event_Notification_Generation(pvObject,
					eObjectType, &eEventStateTo, &eEventStateFrom);
				/* get the present value */
				if(bGenerateNotifcation && NULL != pvPropAdd)
				{
					if(NULL != *pvPropAdd)
					{
						/* copy ref prop value */
						memcpy(&uPropertyValue, (PropertyValue_u *)*pvPropAdd, 
							sizeof(PropertyValue_u));
					}
				}
			}
#endif
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (BACNET_EVENT_STATE *)pvData,
                                               sizeof(BACNET_EVENT_STATE));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            
			if(OBJECT_EVENT_ENROLLMENT != eObjectType)
			{
				/* read the status flag value and update it by calling back */
				GET_STATUSFLAG_OFFSET(eObjectType,m_stStatusFlag, ul32OffsetAddr);
				/* copy property data to local variable */
				memcpy(&stBitString , (Pr_BACnetBitStr_t *)(ul32BaseAddr+ul32OffsetAddr),
					sizeof(Pr_BACnetBitStr_t));
				u8Data = stBitString.m_stBitStr.m_u8TransBits[0];

				/* toggle the bit */
				if(*((bool *)pvData))
					stBitString.m_stBitStr.m_u8TransBits[0] |= 0x01;//(0x01<<3); /* set bit */
				else
					stBitString.m_stBitStr.m_u8TransBits[0] &= 0xFE;//(0x01<<3); /* reset bit */

				/* make sure that status flags case doesn't have recursive call */
				pvData = &stBitString;
				if(u8Data != stBitString.m_stBitStr.m_u8TransBits[0])
				{
					/* call update common property function to update status flag */
					UpdateCommonProperty(eObjectType, pvObject, PROP_STATUS_FLAGS, i32ArrayIndex,
					pvData, ePermission, pvPropertyPtr, pvPropAdd, pvVirtualDev,
					bInitFunctionality, false, false);
				}
			}

#ifdef BACDEL_SER_AE_GEI_B    
            GET_INTRINSIC_OFFSET(eObjectType,m_i32GetSummary, ul32OffsetAddr);
			if(BACNET_NEGATIVE_ONE == ((int32_t)ul32OffsetAddr))
				break;
            i32GetSummary = (uint32_t *)(ul32BaseAddr+ul32OffsetAddr);
            if(eEventStateTo == EVENT_STATE_NORMAL)
				/* clear bit 7 of m_i32GetSummary */
                BIT_CLEAR(*i32GetSummary,7);
            else
				/* set bit 7 of m_i32GetSummary */
                BIT_SET(*i32GetSummary,7);
#endif
        }
        break;

        /* For Object Out of service */
        case PROP_OUT_OF_SERVICE:
        {
            uint8_t u8OutofService = 0;
            ulong32_t ul32BackupPVOffset = 0;
			#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO)
            BACNET_BINARY_PV     eTmpBinaryVal;
			#endif /* BI - BO */
            /* hold Sizeof */
            int32_t i32Len = 0;
            //BACNET_POLARITY  ePolarity = POLARITY_NORMAL;

            /* Get offset of Out of Serivce property */
            GET_OOS_OFFSET(eObjectType,m_stOutOfService.m_bVal, ul32OffsetAddr);
           
            /* Get Backup of previous out of service state */
            memcpy((void *)&u8OutofService, (void *)(ul32OffsetAddr+ul32BaseAddr), 
                    sizeof(uint8_t));

            /* Copy data into property offset address */
            memcpy((bool *)(ul32BaseAddr+ul32OffsetAddr), (bool *)pvData,
                                               sizeof(bool));
			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr); 

            /* Get BackupPresent value offset */
            GET_PRESENTVAL_OFFSET(eObjectType,m_stBackupPresentValue,ul32BackupPVOffset, i32Len); 

            /* Get Present value offset based on outofservice */
            ul32OffsetAddr = GetPresentValOffset(eObjectType, u8OutofService);    

            /* If previous OS was True and new state is False then 
                copy Backup value to Present Value  */
            if(u8OutofService && (*((bool *)pvData) == 0) && !bRemoteDevFlag && 
				((int32_t)ul32OffsetAddr != BACNET_NEGATIVE_ONE))
            {
                /* Copy data into property Address */
                memcpy((void *)(ul32OffsetAddr+ul32BaseAddr), (void *)(ul32BackupPVOffset+ul32BaseAddr), 
                	i32Len);
            }

            /* If previous OS was False and new state is True then 
                copy Present value to Backup Value  */
            if(!u8OutofService && (*((bool *)pvData) == 1) && !bRemoteDevFlag &&
				((int32_t)ul32OffsetAddr != BACNET_NEGATIVE_ONE))
            {
                 /* Copy data into property Address */
                memcpy((void *)(ul32BackupPVOffset+ul32BaseAddr), (void *)(ul32OffsetAddr+ul32BaseAddr), 
                	i32Len);

#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO)
                /* Reverse value of BI and BO Present value */
                if(eObjectType == OBJECT_BINARY_INPUT || eObjectType == OBJECT_BINARY_OUTPUT )
                {
                    /* Copy data into property Address */
                    memcpy((void *)(&eTmpBinaryVal), (void *)(ul32OffsetAddr+ul32BaseAddr) ,
                                sizeof(BACNET_BINARY_PV));

                    /* Check polarity for Binary Present Value property */
                    if((GetPolarity(ul32BaseAddr, eObjectType)) == POLARITY_REVERSE)         
                    {
                        if(eTmpBinaryVal == BINARY_ACTIVE)
                            eTmpBinaryVal = BINARY_INACTIVE;
                        else
                            eTmpBinaryVal = BINARY_ACTIVE;
                    }
                    /* Copy data into property Address */
                    memcpy((void *)(ul32OffsetAddr+ul32BaseAddr), (void *)(&eTmpBinaryVal), 
                    	i32Len);
                }
#endif
            }

			#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO)
            /* If OS changes effect of polarity For BI and BO changes */
            if(eObjectType == OBJECT_BINARY_INPUT || eObjectType == OBJECT_BINARY_OUTPUT )
            {
                Update_PV_Polarity(ul32BaseAddr, eObjectType);  
            }
			#endif /* BI - BO */
			#ifdef BACDEL_OBJ_SDL
            else if(eObjectType == OBJECT_SCHEDULE)
            {
                TriggerTimeNPriority_t* pstTriggerTime = NULL;

                /* Update Trigger Time for Schedule Object */
                GET_SHDL_OFFSET(OBJECT_SCHEDULE, m_stTimeNPriority, ul32OffsetAddr);
                pstTriggerTime = (TriggerTimeNPriority_t *)(ul32BaseAddr+ul32OffsetAddr);

                memset(&pstTriggerTime->m_stTriggerTime, 0, sizeof(BACnetTime_t));
                memset(&pstTriggerTime->m_stTriggerDate, 0, sizeof(BACnetDate_t));
            }
			#endif

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);     

            /* read the status flag value and update it by calling back */
            GET_STATUSFLAG_OFFSET(eObjectType,m_stStatusFlag, ul32OffsetAddr);
            memcpy(&stBitString , (Pr_BACnetBitStr_t *)(ul32BaseAddr+ul32OffsetAddr),
                sizeof(Pr_BACnetBitStr_t));
			u8Data = stBitString.m_stBitStr.m_u8TransBits[0];

            /* toggle the bit */
            if(*((bool *)pvData))
                stBitString.m_stBitStr.m_u8TransBits[0] |= (0x01<<STATUS_FLAG_OUT_OF_SERVICE); /* set bit */
            else
                stBitString.m_stBitStr.m_u8TransBits[0] &= (0xFF ^(0x01<<STATUS_FLAG_OUT_OF_SERVICE)); /* reset bit */

            /* make sure that status flags case doesn't have recursive call */
            pvData = &stBitString;
			if(u8Data != stBitString.m_stBitStr.m_u8TransBits[0])
			{
				/* call update common property function to update status flag */
				UpdateCommonProperty(eObjectType, pvObject, PROP_STATUS_FLAGS, i32ArrayIndex,
									pvData, ePermission, pvPropertyPtr, pvPropAdd, pvVirtualDev,
									bInitFunctionality, false, false);
			}
        }
        break;
        
#if (defined BACDEL_OBJ_BI || defined BACDEL_OBJ_BO)
        /* For Object Polarity */
        case PROP_POLARITY:
        {
             /* Get property offset */
            GET_POLARITY_OFFSET(eObjectType,m_stPolarity.m_ePolarity ,
                                                     ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (int8_t *)pvData,
                                               sizeof(BACNET_POLARITY));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
#ifdef OPTIONAL_PROPERTY
            if( (!bInitFunctionality) && !bRemoteDevFlag &&
                ((eObjectType == OBJECT_BINARY_INPUT)||
                (eObjectType == OBJECT_BINARY_OUTPUT)) &&
                !IsOutofSerivceFlagTrue(ul32BaseAddr, eObjectType))
            {
                /* Read the Count value and update it by calling back */
                GET_BINARYONLY_OFFSET(eObjectType, m_stChangeOfStateCount.m_u16Val, 
                    ul32OffsetAddr);
                memcpy(&u16Data, (uint16_t *)(ul32BaseAddr+ul32OffsetAddr), sizeof(uint16_t));
                /* Increment count */                               
                u16Data++;
                pvData = &u16Data;
                /* NOTE : making bWriteNULL true to indicate recursive call */ 
                UpdateCommonProperty(eObjectType, pvObject, PROP_CHANGE_OF_STATE_COUNT,
                                    i32ArrayIndex, pvData, eAccessType, pvPropertyPtr, pvPropAdd, pVirtualDev,
                                    bInitFunctionality, false, true);
            }
#endif /* OPTIONAL_PROPERTY */
        }
        break; 
#endif /* BI - BO */
        
        /* For Object Status flags */
        case PROP_STATUS_FLAGS:
        {
#ifdef BACDEL_SER_DS_COV_B 
            int32_t i32COVValue;            
            /* Get property offset */
            GET_STATUSFLAG_OFFSET(eObjectType,m_stStatusFlag.m_i32ActiveCOV,
                ul32OffsetAddr);
            /* Copy data into property offset address */
            memcpy((void *)&i32COVValue, (void *)(ul32BaseAddr+ul32OffsetAddr),
                sizeof(int32_t));
#endif
            /* Get property offset */
            GET_STATUSFLAG_OFFSET(eObjectType,m_stStatusFlag, ul32OffsetAddr);
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (int8_t *)pvData ,
                                               sizeof(Pr_BACnetBitStr_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B 
            /* Get property offset */
            GET_STATUSFLAG_OFFSET(eObjectType,m_stStatusFlag.m_i32ActiveCOV, ul32OffsetAddr);
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (int8_t *)&i32COVValue,
                                               sizeof(int32_t));
#endif
            
        }
        break; 

        /* For Object relinquish default value */
        case PROP_RELINQUISH_DEFAULT:
        {
			bool_t bTag = 0;
			bool bValue = FALSE;
            int32_t i32Len = 0;

            /* Update property offset */
            GET_RELINQUISH_VAL_OFFSET(eObjectType, m_stRelinquishDefault,  
                ul32OffsetAddr, i32Len);

            /* Copy data into property Address */
            memcpy((void *)(ul32OffsetAddr+ul32BaseAddr), pvData, i32Len);
            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

			if(!bInitFunctionality && !bRemoteDevFlag)
			{
				GET_PRIORITY_OFFSET(eObjectType,m_stPriorityArray.m_bTagType 
					[MAX_PRIORITY_ARRAY_COUNT-1], ul32OffsetAddr);
				memcpy(&bTag, (bool_t *)(ul32BaseAddr+ul32OffsetAddr), sizeof(bool_t));

				if(BACNET_APPLICATION_TAG_NULL == bTag)
					bValue = TRUE;
				else
					bValue = FALSE;

				/* get value @ last index in priority array */ 
				GET_PRIORITY_OFFSET(eObjectType, m_stPriorityArray.m_uValue, ul32OffsetAddr);   
                /* get offset of last array index */
                ul32OffsetAddr += (i32Len * (MAX_PRIORITY_ARRAY_COUNT-1));
                /* Fix for bug id 2660 */
                /* if data @ 16th location of priority array is null, send same pvData
                   to update event state as applicable. */
                if(bValue)
                {
                	; /* do nothing */
                }
                else pvData = (void *)(ul32BaseAddr+ul32OffsetAddr);

				/* update present value */
				UpdateCommonProperty(eObjectType, pvObject, PROP_PRESENT_VALUE, 
				                    (MAX_PRIORITY_ARRAY_COUNT-1) , pvData,
									ePermission, pvPropertyPtr, pvPropAdd,
				                    pvVirtualDev, bInitFunctionality, false, bValue);
			}
        }
        break;
#ifdef BACDEL_PR18
		/* for object current command priority value */
		case PROP_CURRENT_COMMAND_PRIORITY:
		{
			/* locals */
			BACNET_DATA_TYPE eDataType = BACNET_DT_UNSIGNED;
            /* check if input value is of data type null or unsigned */
			if(bInitFunctionality || bWriteNULL)
			{
				/* tag value for null data_type */
				eDataType = BACNET_DT_NULL;
			}

            /* get the offset of data type & save the value */
		    GET_RELINQUISH_OFFSET(eObjectType, m_stCurrentCmdPriority.
				m_stOptionalUnsigned.m_eDataType, ul32OffsetAddr);
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), &eDataType,
				sizeof(BACNET_DATA_TYPE));

			/* get the offset of property value */
			GET_RELINQUISH_OFFSET(eObjectType, m_stCurrentCmdPriority.
				m_stOptionalUnsigned.m_u32Val, ul32OffsetAddr);
            /* write only if data type is unsigned */
            if(BACNET_DT_UNSIGNED == eDataType)
			{
				/* copy value */
				memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), (uint32_t *)pvData,
					sizeof(uint32_t));
			}

			/* return prop val address */
            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

		}
		break;
#endif /* PR18 */
        /* For No. Of States */
#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSO || defined BACDEL_OBJ_MSV)
        case PROP_NUMBER_OF_STATES:
        {
            /* Make sure that recursive call is not from PROP_STATE_TEXT case */
            if(true != bRemoteDevFlag)
            {
                i32ArrayIndex = 0;
                eDependentProp = PROP_STATE_TEXT;
                //pvData = (void *)(ul32BaseAddr+ul32OffsetAddr);

                /* Remote device flag is made true to stop recursive calling */
                UpdateCommonProperty(eObjectType, pvObject,eDependentProp, i32ArrayIndex,
                        pvData, ePermission,pvPropertyPtr, pvPropAdd, pvVirtualDev,
                        bInitFunctionality,true,false);
            }

            /* Update property offset */
            GET_MULTISTATE_PROP_OFFSET(eObjectType,m_stNumberOfStates.m_u32Val ,
                                                    ul32OffsetAddr);
           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                    sizeof(uint32_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;
#endif /* Multistate objects */

        /* For Object Priority value for Test */
        case PROP_PRIORITY_ARRAY:
        {
#ifdef BACDEL_SER_DS_COV_B
#endif 
            /* Update property offset */
            GET_PRIORITY_OFFSET(eObjectType,m_stPriorityArray ,      
                                            ul32OffsetAddr);
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),((int8_t *)pvData),
                                            sizeof(Pr_BACnetPriorityArray_t));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

#ifdef BACDEL_SER_DS_COV_B 
#endif

        }
        break;

        case PROP_UNITS:
        {
            /* Update property offset */
            GET_UNITS_OFFSET(eObjectType,m_stUnit.m_eEnggUnits ,ul32OffsetAddr);
            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, 
                                sizeof(BACNET_ENGINEERING_UNITS));
                           
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                sizeof(BACNET_ENGINEERING_UNITS));

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

        }
        break;

#ifdef BACDEL_SER_DS_COV_B 
        case PROP_COV_INCREMENT:
        {
            int32_t i32Len = 0;

			switch (eObjectType)
			{
				default:
						/* Update property offset */
					GET_DEADBAND_COV_INCR_VAL_OFFSET(eObjectType,m_stCOVIncrement,ul32OffsetAddr,i32Len);
					i32Len = sizeof(int32_t);
					memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, i32Len);
                           
					/* Copy data into property offset address */
					memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
            				i32Len);
				break;
			}	
			*pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            /* update cov subscription if registered */
            if(!bInitFunctionality && !bRemoteDevFlag)
            {
                Update_CovIncrement_In_Subscription(pVirtualDev, 
                    eObjectType, pvObject, pvData, i32Len);
            }
        }
        break;
#endif /* BACDEL_SER_DS_COV_B */

#ifdef OPTIONAL_PROPERTY
#if (defined BACDEL_OBJ_MSI || defined BACDEL_OBJ_MSO || defined BACDEL_OBJ_MSV)
        case PROP_STATE_TEXT:
        {
            Pr_ListOfCharStr_t *pstCharStrArr = NULL;

            /* get property offset */
            GET_MULTISTATE_PROP_OFFSET(eObjectType, m_stStateText, ul32OffsetAddr);

            /* update property value */
            UpdateCharStringArrayProperty(eObjectType, eDevProp, pvObject, pvData,
                    bInitFunctionality, i32ArrayIndex, &bRecursiveCall);

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
            pstCharStrArr = (Pr_ListOfCharStr_t *)(ul32BaseAddr+ul32OffsetAddr);

            /* Make sure that recursive call is not from present value case */
            if(!bInitFunctionality && !bRemoteDevFlag && bRecursiveCall)
            {
                /* reset */
                bRecursiveCall = FALSE;
                /* update parameters */
                i32ArrayIndex = BACNET_ARRAY_ALL;
                pvData = &pstCharStrArr->m_u32Count;

                /* Remote device flag is made true to stop recursive calling */
                UpdateCommonProperty(eObjectType, pvObject, PROP_NUMBER_OF_STATES, 
                                    i32ArrayIndex, pvData, ePermission, pvPropertyPtr, pvPropAdd, pvVirtualDev,
                                    bInitFunctionality, TRUE, FALSE);
            }
        }
        break;
#endif /* Multistate objects */

        /* For Object Description */
        case PROP_DESCRIPTION:
        {
            /* Update String length value */
            GET_OBJCOMMON_OFFSET(eObjectType , m_stDescription.m_stCHARString, 
                                ul32OffsetAddr);
                                                            
            memset((void *)(ul32BaseAddr+ul32OffsetAddr), 0x00, sizeof(BACnetCharStr_t));

             /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr),(int8_t *)pvData,
                            sizeof(BACnetCharStr_t));           
            
            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;
        
        /* For Object Description */
