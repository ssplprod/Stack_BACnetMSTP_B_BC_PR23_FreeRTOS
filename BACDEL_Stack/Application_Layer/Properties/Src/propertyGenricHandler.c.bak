            GET_HL_LL_VALUE_OFFSET(eObjectType, m_stHighLimit ,ul32OffsetAddr,i32Len);

            memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, i32Len);
            /* Copy data into property offset address */
            memcpy((void *)(ul32BaseAddr+ul32OffsetAddr), pvData, i32Len);

            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);

			/* Other than Add Property time, event state should update */
            if(!bInitFunctionality && !bRemoteDevFlag)
            {
				/* check if notification is to be generated */
				Check_For_Intrinsic_Notification(eObjectType, pvObject, pVirtualDev);
			}
        }
        break;

        case PROP_LOW_LIMIT:
