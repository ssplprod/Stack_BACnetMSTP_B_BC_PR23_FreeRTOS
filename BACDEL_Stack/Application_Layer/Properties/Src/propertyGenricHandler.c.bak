					/* Update property offset */
					GET_MIN_PV_RESOLUTION_OFFSET(eObjectType,m_stMinPresValue.m_fVal ,
					ul32OffsetAddr);
					
					memset((void *)(ul32BaseAddr+ul32OffsetAddr),0x00, sizeof(Float_t));
					
