                            sizeof(BACnetCharStr_t));
          
            *pvPropAdd = (void *)(ul32BaseAddr+ul32OffsetAddr);
        }
        break;

#if (defined BACDEL_OBJ_AI || defined BACDEL_OBJ_AO || defined BACDEL_OBJ_AV )
        case PROP_MIN_PRES_VALUE:
        {
			switch(eObjectType)
			{


				default:
